@page "/login"
@layout LoginLayout

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_LOGIN_PAGE_TITLE))</PageTitle>

<div class="page-login">
    <div class="page-login__logo">
        <h1>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_APP_TITLE))</h1>
    </div>

    <EditForm EditContext="@LoginViewService.EditContext" @onkeydown="OnKeyDownAsync">
        <div class="page-login__form">
            <div class="page-login__field">
                <label class="page-login__label" for="username">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_LOGIN_USERNAME_LABEL))</label>
                <input id="username"
                       type="text"
                       class="page-login__input @(HasErrors(() => LoginViewState.Username) ? "page-login__input--invalid" : "")"
                       value="@LoginViewState.Username"
                       @oninput="@(e => LoginViewService.SetUsernameAsync(e.Value?.ToString() ?? string.Empty))"
                       disabled="@LoginViewState.IsLoading"
                       autocomplete="username"
                       placeholder="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_LOGIN_USERNAME_PLACEHOLDER))" />
                <ValidationMessage For="@(() => LoginViewState.Username)" />
            </div>

            <div class="page-login__field">
                <label class="page-login__label" for="password">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_LOGIN_PASSWORD_LABEL))</label>
                <input id="password"
                       type="password"
                       class="page-login__input @(HasErrors(() => LoginViewState.Password) ? "page-login__input--invalid" : "")"
                       value="@LoginViewState.Password"
                       @oninput="@(e => LoginViewService.SetPasswordAsync(e.Value?.ToString() ?? string.Empty))"
                       disabled="@LoginViewState.IsLoading"
                       autocomplete="current-password"
                       placeholder="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_LOGIN_PASSWORD_PLACEHOLDER))" />
                <ValidationMessage For="@(() => LoginViewState.Password)" />
            </div>

            @if (!string.IsNullOrEmpty(LoginViewState.ErrorMessage))
            {
                <div class="page-login__error">
                    @LoginViewState.ErrorMessage
                </div>
            }

            <button type="button"
                    class="page-login__submit"
                    disabled="@(LoginViewState.IsValid != true || LoginViewState.IsLoading)"
                    @onclick="SubmitAsync">
                @(LoginViewState.IsLoading
                    ? LocalizationService.GetString(nameof(Autogenerated.Resources.GO_LOGIN_SUBMIT_LOADING))
                    : LocalizationService.GetString(nameof(Autogenerated.Resources.GO_LOGIN_SUBMIT)))
            </button>
        </div>
    </EditForm>
</div>
