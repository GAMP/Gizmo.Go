@using Gizmo.Go.UI.Pages

@* the router is rendered after the session restore, the start culture and the view services are ready *@
@if (_initialized)
{
    <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(NotFound)">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
    </Router>
}
else
{
    <AppLoading />
}
