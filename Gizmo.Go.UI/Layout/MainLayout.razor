@inherits LayoutComponentBase

<div class="app">
    <header class="app-header">
        <div class="app-header-content">
            <h1 class="app-header-title">@_pageTitle</h1>
        </div>
    </header>

    <main class="app-content">
        @Body
    </main>

    <nav class="app-nav">
        <NavLink class="app-nav-item" href="home" Match="NavLinkMatch.All">
            <svg class="app-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
            <span class="app-nav-label">Home</span>
        </NavLink>
        <NavLink class="app-nav-item" href="branches">
            <svg class="app-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                <circle cx="12" cy="10" r="3"/>
            </svg>
            <span class="app-nav-label">Branches</span>
        </NavLink>
        <NavLink class="app-nav-item" href="favorites">
            <svg class="app-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
            <span class="app-nav-label">Favorites</span>
        </NavLink>
        <NavLink class="app-nav-item" href="account">
            <svg class="app-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
            </svg>
            <span class="app-nav-label">Account</span>
        </NavLink>
    </nav>
    <NotificationsHost />
</div>
