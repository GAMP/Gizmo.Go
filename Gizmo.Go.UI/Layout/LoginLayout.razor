@inherits LayoutComponentBase

<div class="app app--dark">
    <main class="app-content app-content--fill">
        <ErrorBoundary>
            <ChildContent>@Body</ChildContent>
            <ErrorContent>
                <ErrorBlock Message="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GLOBAL_ERROR))" ShowIcon="true" />
            </ErrorContent>
        </ErrorBoundary>
    </main>
    <NotificationsHost />
</div>
