@attribute [Route(NavigationHelper.ProfileCompletionRoute)]
@attribute [Authorize]
@layout LoginLayout

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_COMPLETION_PAGE_TITLE))</PageTitle>

<div class="auth-form-page page-profile-completion">

    <div class="auth-form auth-form--profile">

        <ErrorBlock Message="@(ProfileCompletionViewState.HasError ? ProfileCompletionViewState.ErrorMessage : null)" />

        <div class="auth-hero">
            <h1 class="auth-hero__title">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_COMPLETION_HEADING))
            </h1>
            <p class="auth-hero__subtitle">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_COMPLETION_SUBTITLE))
            </p>
        </div>

        @if (ProfileCompletionViewState.IsShown)
        {
            <EditForm EditContext="@ProfileCompletionViewService.EditContext">
            <div class="auth-form__fields">

                @if (ProfileCompletionViewState.ShowFirstName)
                {
                    <TextInputField Id="pc-firstname"
                                    Label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_FIRST_NAME_LABEL))"
                                    Value="@ProfileCompletionViewState.FirstName"
                                    ValueChanged="@OnFirstNameChanged"
                                    For="@(() => ProfileCompletionViewState.FirstName)"
                                    Disabled="@ProfileCompletionViewState.IsLoading"
                                    Autocomplete="given-name"
                                    MaxLength="45"
                                    Placeholder="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_FIRST_NAME_PLACEHOLDER))" />
                }

                @if (ProfileCompletionViewState.ShowLastName)
                {
                    <TextInputField Id="pc-lastname"
                                    Label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_LAST_NAME_LABEL))"
                                    Value="@ProfileCompletionViewState.LastName"
                                    ValueChanged="@OnLastNameChanged"
                                    For="@(() => ProfileCompletionViewState.LastName)"
                                    Disabled="@ProfileCompletionViewState.IsLoading"
                                    Autocomplete="family-name"
                                    MaxLength="45"
                                    Placeholder="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_LAST_NAME_PLACEHOLDER))" />
                }

                @if (ProfileCompletionViewState.ShowBirthDate)
                {
                    <div class="auth-field">
                        <label class="auth-field__label" for="pc-birthdate">
                            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_BIRTH_DATE_LABEL))
                        </label>
                        <DateInputField Value="@ProfileCompletionViewState.BirthDate"
                                        ValueChanged="@OnBirthDateChanged"
                                        ErrorMessage="@GetFirstError(() => ProfileCompletionViewState.BirthDate)"
                                        Disabled="@ProfileCompletionViewState.IsLoading"
                                        Id="pc-birthdate" />
                    </div>
                }

                @if (ProfileCompletionViewState.ShowSex)
                {
                    <SexSelectField Id="pc-sex"
                                    Label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_USER_GENDER))"
                                    Value="@ProfileCompletionViewState.Sex"
                                    ValueChanged="@OnSexChanged"
                                    For="@(() => ProfileCompletionViewState.Sex)"
                                    Disabled="@ProfileCompletionViewState.IsLoading" />
                }

                @if (ProfileCompletionViewState.ShowMobilePhone)
                {
                    <div class="auth-field">
                        <label class="auth-field__label" for="pc-mobile">
                            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_MOBILE_PHONE))
                        </label>
                        <PhoneInputField Countries="@ProfileCompletionViewState.PhoneCountries"
                                         DefaultRegionCode="@ProfileCompletionViewState.DefaultPhoneRegionCode"
                                         RegionCode="@ProfileCompletionViewState.PhoneRegionCode"
                                         RegionCodeChanged="@OnPhoneRegionCodeChanged"
                                         Value="@(ProfileCompletionViewState.MobilePhone ?? string.Empty)"
                                         ValueChanged="@OnMobilePhoneChanged"
                                         Disabled="@ProfileCompletionViewState.IsLoading"
                                         IsInvalid="@HasErrors(() => ProfileCompletionViewState.MobilePhone)"
                                         Id="pc-mobile" />
                        <ValidationMessage For="@(() => ProfileCompletionViewState.MobilePhone)" />
                    </div>
                }

                @if (ProfileCompletionViewState.ShowEmail)
                {
                    <TextInputField Id="pc-email"
                                    Label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_EMAIL_ADDRESS))"
                                    Value="@ProfileCompletionViewState.Email"
                                    ValueChanged="@OnEmailChanged"
                                    For="@(() => ProfileCompletionViewState.Email)"
                                    Disabled="@ProfileCompletionViewState.IsLoading"
                                    InputType="email"
                                    Autocomplete="email"
                                    InputMode="email"
                                    MaxLength="254"
                                    Placeholder="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_EMAIL_PLACEHOLDER))" />
                }

                @if (ProfileCompletionViewState.ShowPhone)
                {
                    <TextInputField Id="pc-phone"
                                    Label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_ADDITIONAL_PHONE))"
                                    Value="@ProfileCompletionViewState.Phone"
                                    ValueChanged="@OnPhoneChanged"
                                    For="@(() => ProfileCompletionViewState.Phone)"
                                    Disabled="@ProfileCompletionViewState.IsLoading"
                                    InputType="tel"
                                    Autocomplete="tel"
                                    InputMode="tel"
                                    MaxLength="20" />
                }

                @if (ProfileCompletionViewState.ShowCountry)
                {
                    <TextInputField Id="pc-country"
                                    Label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_USER_COUNTRY_REGION))"
                                    Value="@ProfileCompletionViewState.Country"
                                    ValueChanged="@OnCountryChanged"
                                    For="@(() => ProfileCompletionViewState.Country)"
                                    Disabled="@ProfileCompletionViewState.IsLoading"
                                    Autocomplete="country-name"
                                    MaxLength="45" />
                }

                @if (ProfileCompletionViewState.ShowAddress)
                {
                    <TextInputField Id="pc-address"
                                    Label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_USER_ADDRESS))"
                                    Value="@ProfileCompletionViewState.Address"
                                    ValueChanged="@OnAddressChanged"
                                    For="@(() => ProfileCompletionViewState.Address)"
                                    Disabled="@ProfileCompletionViewState.IsLoading"
                                    Autocomplete="street-address"
                                    MaxLength="255" />
                }

                @if (ProfileCompletionViewState.ShowCity)
                {
                    <TextInputField Id="pc-city"
                                    Label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_USER_CITY))"
                                    Value="@ProfileCompletionViewState.City"
                                    ValueChanged="@OnCityChanged"
                                    For="@(() => ProfileCompletionViewState.City)"
                                    Disabled="@ProfileCompletionViewState.IsLoading"
                                    Autocomplete="address-level2"
                                    MaxLength="45" />
                }

                @if (ProfileCompletionViewState.ShowPostCode)
                {
                    <TextInputField Id="pc-postcode"
                                    Label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_USER_POST_CODE))"
                                    Value="@ProfileCompletionViewState.PostCode"
                                    ValueChanged="@OnPostCodeChanged"
                                    For="@(() => ProfileCompletionViewState.PostCode)"
                                    Disabled="@ProfileCompletionViewState.IsLoading"
                                    Autocomplete="postal-code"
                                    InputMode="numeric"
                                    MaxLength="20" />
                }

            </div>
            </EditForm>

            <div class="auth-form__actions">
                <button type="button"
                        class="auth-submit"
                        disabled="@IsSubmitDisabled"
                        @onclick="SubmitAsync">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_COMPLETION_SUBMIT))
                </button>
            </div>
        }

    </div>

</div>
