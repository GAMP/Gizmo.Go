@attribute [Route(NavigationHelper.PasswordRecoveryDestinationRoute)]
@layout LoginLayout
@using Gizmo.Go.Core.Models.PasswordRecovery

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_FORGOT_PASSWORD))</PageTitle>

<div class="page-create-account">

    <AuthBackHeader OnBack="NavigateBack"
                    BackText="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_BACK))"
                    AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_BACK))" />

    <div class="auth-body">

        <div class="auth-card">

            <div class="auth-card__header">
                <div class="auth-card__logo" aria-hidden="true"></div>
                <div class="auth-card__titles">
                    <h1 class="auth-card__title">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_FORGOT_PASSWORD))
                    </h1>
                    <p class="auth-card__subtitle">
                        @if (PasswordRecoveryDestinationViewState.IdentifierKind == PasswordRecoveryIdentifierKind.MobilePhone)
                        {
                            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_ENTER_PHONE_NUMBER))
                        }
                        else if (PasswordRecoveryDestinationViewState.IdentifierKind == PasswordRecoveryIdentifierKind.Email)
                        {
                            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_ENTER_EMAIL))
                        }
                        else
                        {
                            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_ENTER_USERNAME))
                        }
                    </p>
                </div>
            </div>

            <ErrorBlock Message="@(PasswordRecoveryDestinationViewState.HasError ? PasswordRecoveryDestinationViewState.ErrorMessage : null)" ShowIcon="true" />

            <EditForm EditContext="@PasswordRecoveryDestinationViewService.EditContext">

                <div class="create-account-fields">

                    @if (PasswordRecoveryDestinationViewState.IdentifierKind == PasswordRecoveryIdentifierKind.MobilePhone)
                    {
                        <div class="auth-field">
                            <label class="auth-field__label" for="pr-phone">
                                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_PHONE_NUMBER))
                            </label>
                            <PhoneInputField Countries="@PasswordRecoveryDestinationViewState.Countries"
                                             RegionCode="@PasswordRecoveryDestinationViewState.RegionCode"
                                             RegionCodeChanged="@OnRegionCodeChanged"
                                             Value="@(PasswordRecoveryDestinationViewState.MobilePhone ?? string.Empty)"
                                             ValueChanged="@OnPhoneValueChanged"
                                             CountryPlaceholder="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_COUNTRY_PLACEHOLDER))"
                                             Disabled="@PasswordRecoveryDestinationViewState.IsLoading"
                                             IsInvalid="@HasErrors(() => PasswordRecoveryDestinationViewState.MobilePhone)"
                                             Id="pr-phone" />
                            <ValidationMessage For="@(() => PasswordRecoveryDestinationViewState.MobilePhone)" />
                        </div>
                    }
                    else
                    {
                        <div class="auth-field">
                            <label class="auth-field__label" for="pr-match">
                                @LocalizationService.GetString(PasswordRecoveryDestinationViewState.IdentifierKind == PasswordRecoveryIdentifierKind.Email
                                    ? nameof(Autogenerated.Resources.GO_GEN_EMAIL_ADDRESS)
                                    : nameof(Autogenerated.Resources.GO_GEN_USERNAME))
                            </label>
                            <div class="auth-field__input-wrap @(HasErrors(() => PasswordRecoveryDestinationViewState.MatchValue) ? "auth-field__input-wrap--invalid" : "")">
                                <input id="pr-match"
                                       type="@(PasswordRecoveryDestinationViewState.IdentifierKind == PasswordRecoveryIdentifierKind.Email ? "email" : "text")"
                                       class="auth-field__input"
                                       value="@PasswordRecoveryDestinationViewState.MatchValue"
                                       @oninput="OnMatchValueInput"
                                       disabled="@PasswordRecoveryDestinationViewState.IsLoading"
                                       autocomplete="@(PasswordRecoveryDestinationViewState.IdentifierKind == PasswordRecoveryIdentifierKind.Email ? "email" : "username")"
                                       maxlength="@PasswordRecoveryDestinationViewService.MatchValueMaxLength" />
                            </div>
                            <ValidationMessage For="@(() => PasswordRecoveryDestinationViewState.MatchValue)" />
                        </div>
                    }

                </div>

                <button type="button"
                        class="auth-submit create-account-submit"
                        disabled="@(PasswordRecoveryDestinationViewState.IsValid != true || PasswordRecoveryDestinationViewState.IsLoading)"
                        @onclick="SubmitAsync">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_CONTINUE))
                </button>

            </EditForm>

        </div>

    </div>

</div>
