@attribute [Route(NavigationHelper.PasswordRecoverySetNewPasswordRoute)]
@layout LoginLayout

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_NEW_PASSWORD))</PageTitle>

<div class="page-create-password">

    <header class="auth-header">
        <LangButton />
    </header>

    <div class="create-password-body">

        <div class="auth-hero">
            <h1 class="auth-hero__title">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_NEW_PASSWORD))
            </h1>
            <p class="auth-hero__subtitle">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_SET_PASSWORD_MESSAGE))
            </p>
        </div>

        <EditForm EditContext="@PasswordRecoverySetNewPasswordViewService.EditContext">

            <div class="create-password-fields">

                <div class="auth-field">
                    <label class="auth-field__label" for="pr-new-password">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_ENTER_NEW_PASSWORD))
                    </label>
                    <div class="auth-field__input-wrap @(HasErrors(() => PasswordRecoverySetNewPasswordViewState.NewPassword) ? "auth-field__input-wrap--invalid" : "")">
                        <input id="pr-new-password"
                               type="@(_showPassword ? "text" : "password")"
                               class="auth-field__input"
                               value="@PasswordRecoverySetNewPasswordViewState.NewPassword"
                               @oninput="OnNewPasswordInput"
                               disabled="@PasswordRecoverySetNewPasswordViewState.IsLoading"
                               autocomplete="new-password"
                               placeholder="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_PASSWORD_PASSWORD_PLACEHOLDER))" />
                        <EyeToggleButton Visible="_showPassword" OnToggle="ToggleShowPassword" />
                    </div>
                    <ValidationMessage For="@(() => PasswordRecoverySetNewPasswordViewState.NewPassword)" />
                </div>

                <div class="auth-field">
                    <label class="auth-field__label" for="pr-repeat-password">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_REENTER_CONFIRM))
                    </label>
                    <div class="auth-field__input-wrap @(HasErrors(() => PasswordRecoverySetNewPasswordViewState.RepeatPassword) ? "auth-field__input-wrap--invalid" : "")">
                        <input id="pr-repeat-password"
                               type="@(_showConfirm ? "text" : "password")"
                               class="auth-field__input"
                               value="@PasswordRecoverySetNewPasswordViewState.RepeatPassword"
                               @oninput="OnRepeatPasswordInput"
                               disabled="@PasswordRecoverySetNewPasswordViewState.IsLoading"
                               autocomplete="new-password"
                               placeholder="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_PASSWORD_CONFIRM_PLACEHOLDER))" />
                        <EyeToggleButton Visible="_showConfirm" OnToggle="ToggleShowConfirm" />
                    </div>
                    <ValidationMessage For="@(() => PasswordRecoverySetNewPasswordViewState.RepeatPassword)" />
                </div>

            </div>

            @if (Tooltip.TotalRules > 0)
            {
                <div class="create-password-requirements">
                    <p class="create-password-requirements__title">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_PASSWORD_REQUIREMENTS_TITLE))
                    </p>
                    <ul class="create-password-requirements__list" aria-label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_PASSWORD_REQUIREMENTS_ARIA))">
                        @if (Tooltip.MinimumLengthRule > 0 && Tooltip.MaximumLengthRule > 0)
                        {
                            <li class="create-password-req @(Tooltip.LengthRulePassed ? "create-password-req--met" : "")">
                                <span class="create-password-req__dot" aria-hidden="true"></span>
                                <span>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RULE_RANGE_LENGTH), Tooltip.MinimumLengthRule, Tooltip.MaximumLengthRule)</span>
                            </li>
                        }
                        else if (Tooltip.MinimumLengthRule > 0)
                        {
                            <li class="create-password-req @(Tooltip.LengthRulePassed ? "create-password-req--met" : "")">
                                <span class="create-password-req__dot" aria-hidden="true"></span>
                                <span>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RULE_MIN_LENGTH), Tooltip.MinimumLengthRule)</span>
                            </li>
                        }
                        else if (Tooltip.MaximumLengthRule > 0)
                        {
                            <li class="create-password-req @(Tooltip.LengthRulePassed ? "create-password-req--met" : "")">
                                <span class="create-password-req__dot" aria-hidden="true"></span>
                                <span>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RULE_MAX_LENGTH), Tooltip.MaximumLengthRule)</span>
                            </li>
                        }
                        @if (Tooltip.HasLowerCaseCharactersRule)
                        {
                            <li class="create-password-req @(Tooltip.LowerCaseCharactersRulePassed ? "create-password-req--met" : "")">
                                <span class="create-password-req__dot" aria-hidden="true"></span>
                                <span>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RULE_LOWER_CASE))</span>
                            </li>
                        }
                        @if (Tooltip.HasUpperCaseCharactersRule)
                        {
                            <li class="create-password-req @(Tooltip.UpperCaseCharactersRulePassed ? "create-password-req--met" : "")">
                                <span class="create-password-req__dot" aria-hidden="true"></span>
                                <span>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RULE_UPPER_CASE))</span>
                            </li>
                        }
                        @if (Tooltip.HasNumbersRule)
                        {
                            <li class="create-password-req @(Tooltip.NumbersRulePassed ? "create-password-req--met" : "")">
                                <span class="create-password-req__dot" aria-hidden="true"></span>
                                <span>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RULE_NUMBER))</span>
                            </li>
                        }
                    </ul>
                </div>
            }

            <ErrorBlock Message="@(PasswordRecoverySetNewPasswordViewState.HasError ? PasswordRecoverySetNewPasswordViewState.ErrorMessage : null)" ShowIcon="true" />

            <button type="button"
                    class="auth-submit"
                    disabled="@(PasswordRecoverySetNewPasswordViewState.IsValid == false || PasswordRecoverySetNewPasswordViewState.IsLoading)"
                    @onclick="SubmitAsync">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_CONTINUE))
            </button>

        </EditForm>

    </div>

</div>
