@attribute [Route(NavigationHelper.PasswordRecoveryRoute)]
@layout LoginLayout

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_FORGOT_PASSWORD))</PageTitle>

<div class="page-create-account">

    <AuthBackHeader OnBack="NavigateBack"
                    BackText="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_BACK))"
                    AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_BACK))" />

    @* Figma 159:14302: no card, same layout as the recovery kind step *@
    <div class="contact-entry-body recovery-kind-body">

        <ErrorBlock Message="@(PasswordRecoveryViewState.HasError ? PasswordRecoveryViewState.ErrorMessage : null)" ShowHomeLink="true" />

        <div class="auth-hero">
            <h1 class="auth-hero__title">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_FORGOT_PASSWORD))
            </h1>
            <p class="auth-hero__subtitle">
                @LocalizationService.GetString(PasswordRecoveryViewState.HasError
                    ? nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_SELECT_OTHER_METHOD)
                    : nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_SELECT_METHOD))
            </p>
        </div>

        @if (PasswordRecoveryViewState.IsLoading)
        {
            <p class="auth-hero__subtitle">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_LOADING))
            </p>
        }
        else
        {
            <ul class="recovery-kind-list" role="list">
                @foreach (var provider in PasswordRecoveryViewState.PriorityProviders)
                {
                    <li @key="provider.MethodId">
                        <ProviderButton IsPrimary="true"
                                        ChannelGuid="@provider.ChannelGuid"
                                        Text="@(LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_RESTORE_WITH)) + provider.Name)"
                                        OnClick="() => SelectProvider(provider.MethodId)" />
                    </li>
                }
            </ul>

            @if (PasswordRecoveryViewState.AltProviders.Count > 0
                && (PasswordRecoveryViewState.HasError || PasswordRecoveryViewState.PriorityProviders.Count == 0 || PasswordRecoveryViewState.ShowAllProviders))
            {
                <div class="registration-providers-alt">

                    @if (PasswordRecoveryViewState.PriorityProviders.Count > 0)
                    {
                        <div class="registration-providers-divider" aria-hidden="true">
                            <span class="registration-providers-divider__line"></span>
                            <span class="registration-providers-divider__badge">
                                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_ALT_DIVIDER))
                            </span>
                            <span class="registration-providers-divider__line"></span>
                        </div>

                        <p class="registration-providers-alt__description">
                            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_ALT_DESCRIPTION))
                        </p>
                    }

                    <ul class="registration-providers-alt__list" role="list">
                        @foreach (var provider in PasswordRecoveryViewState.AltProviders)
                        {
                            <li @key="provider.MethodId">
                                <ProviderButton ChannelGuid="@provider.ChannelGuid"
                                                Text="@(LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_RESTORE_WITH)) + provider.Name)"
                                                OnClick="() => SelectProvider(provider.MethodId)" />
                            </li>
                        }
                    </ul>

                </div>
            }

            <button type="button" class="auth-text-btn" @onclick="NavigateToLogin">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_BACK_TO_LOGIN))
            </button>
        }

    </div>

</div>
