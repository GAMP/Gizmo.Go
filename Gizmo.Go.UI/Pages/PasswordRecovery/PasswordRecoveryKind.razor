@attribute [Route(NavigationHelper.PasswordRecoveryKindRoute)]
@layout LoginLayout
@using Gizmo.Go.Core.Models.PasswordRecovery

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_FORGOT_PASSWORD))</PageTitle>

<div class="page-create-account">

    <AuthBackHeader OnBack="NavigateBack"
                    BackText="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_BACK))"
                    AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_BACK))" />

    @* Figma 159:14334: no card, same layout as the contact entry step *@
    <div class="contact-entry-body recovery-kind-body">

        <div class="auth-hero">
            <h1 class="auth-hero__title">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_KIND_TITLE))
            </h1>
            <p class="auth-hero__subtitle">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_KIND_SUBTITLE))
            </p>
        </div>

        <ul class="recovery-kind-list" role="list">
            <li>
                <ProviderButton Text="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_USERNAME))"
                                OnClick="() => SelectKind(PasswordRecoveryIdentifierKind.Username)">
                    <Icon>
                        <svg class="giz-channel-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="currentColor" stroke="none" />
                        </svg>
                    </Icon>
                </ProviderButton>
            </li>
            <li>
                <ProviderButton Text="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_PHONE_NUMBER))"
                                OnClick="() => SelectKind(PasswordRecoveryIdentifierKind.MobilePhone)">
                    <Icon>
                        <svg class="giz-channel-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M17 1.01 7 1c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-1.99-2-1.99zM17 19H7V5h10v14z" fill="currentColor" stroke="none" />
                        </svg>
                    </Icon>
                </ProviderButton>
            </li>
            <li>
                <ProviderButton ChannelGuid="@EmailChannelGuid"
                                Text="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_KIND_EMAIL))"
                                OnClick="() => SelectKind(PasswordRecoveryIdentifierKind.Email)" />
            </li>
        </ul>

    </div>

</div>
