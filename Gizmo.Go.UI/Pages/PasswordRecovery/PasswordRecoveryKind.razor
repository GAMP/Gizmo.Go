@attribute [Route(NavigationHelper.PasswordRecoveryKindRoute)]
@layout LoginLayout
@using Gizmo.Go.Core.Models.PasswordRecovery

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_FORGOT_PASSWORD))</PageTitle>

<div class="page-create-account">

    <AuthBackHeader OnBack="NavigateBack"
                    BackText="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_BACK))"
                    AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_BACK))" />

    <div class="auth-body">

        <div class="auth-card">

            <div class="auth-card__header">
                <div class="auth-card__logo" aria-hidden="true"></div>
                <div class="auth-card__titles">
                    <h1 class="auth-card__title">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_KIND_TITLE))
                    </h1>
                    <p class="auth-card__subtitle">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_KIND_SUBTITLE))
                    </p>
                </div>
            </div>

            <ul class="registration-providers-list" role="list">
                <li>
                    <button type="button"
                            class="registration-providers-btn"
                            @onclick="() => SelectKind(PasswordRecoveryIdentifierKind.Username)">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_USERNAME))
                    </button>
                </li>
                <li>
                    <button type="button"
                            class="registration-providers-btn"
                            @onclick="() => SelectKind(PasswordRecoveryIdentifierKind.Email)">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_EMAIL_ADDRESS))
                    </button>
                </li>
                <li>
                    <button type="button"
                            class="registration-providers-btn"
                            @onclick="() => SelectKind(PasswordRecoveryIdentifierKind.MobilePhone)">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_PHONE_NUMBER))
                    </button>
                </li>
            </ul>

        </div>

    </div>

</div>
