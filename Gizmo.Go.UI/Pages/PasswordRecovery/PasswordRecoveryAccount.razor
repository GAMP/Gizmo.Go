@attribute [Route(NavigationHelper.PasswordRecoveryAccountRoute)]
@layout LoginLayout

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_FORGOT_PASSWORD))</PageTitle>

<div class="page-create-account">

    <AuthBackHeader OnBack="NavigateBack"
                    BackText="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_BACK))"
                    AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_BACK))" />

    @* mobile deviation: account search result, Figma 159:14156 (found) and 159:14187 (not found) *@
    <div class="recovery-account-body @(PasswordRecoveryAccountViewState.IsFound ? "" : "recovery-account-body--not-found")">

        @if (PasswordRecoveryAccountViewState.IsFound)
        {
            <div class="recovery-account-icon" aria-hidden="true">
                <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M8 18L14 24L28 12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>

            <div class="recovery-account-content">
                <h1 class="recovery-account-title">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_ACCOUNT_FOUND_TITLE))
                </h1>
                <p class="recovery-account-subtitle">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_ACCOUNT_FOUND_SUBTITLE))
                </p>
            </div>

            <div class="recovery-account-actions">
                <button type="button" class="auth-submit" @onclick="ContinueAsync">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_ACCOUNT_FOUND_SUBMIT))
                </button>
                <button type="button" class="recovery-account-link" @onclick="NavigateToLoginAsync">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_BACK_TO_LOGIN))
                </button>
            </div>
        }
        else
        {
            <div class="recovery-account-icon recovery-account-icon--error" aria-hidden="true">
                <svg width="34" height="34" viewBox="0 0 34 34" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M11 11L23 23M23 11L11 23" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
                </svg>
            </div>

            <div class="recovery-account-content">
                <h1 class="recovery-account-title">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_ACCOUNT_NOT_FOUND_TITLE))
                </h1>
                <p class="recovery-account-subtitle">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_ACCOUNT_NOT_FOUND_SUBTITLE))
                </p>
            </div>

            @* mobile deviation: no error banner and no "try again" link (Figma 159:14187) *@
            <div class="recovery-account-actions">
                <button type="button" class="auth-submit" @onclick="ChooseAnotherMethodAsync">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_ACCOUNT_NOT_FOUND_SUBMIT))
                </button>
            </div>
        }

    </div>

</div>
