@attribute [Route(NavigationHelper.PasswordRecoveryConfirmationRoute)]
@layout LoginLayout
@using Gizmo.Go.Core.Models.PasswordRecovery

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_FORGOT_PASSWORD))</PageTitle>

@if (PasswordRecoveryConfirmationViewState.Action == PasswordRecoveryAction.Code)
{
    <div class="page-confirmation">

        <AuthBackHeader OnBack="NavigateBack"
                        IconShape="@AuthBackHeader.BackIconShape.Circle"
                        AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_BACK))" />

        <div class="confirmation-body">

            <div class="auth-card__header">
                <div class="auth-card__logo" aria-hidden="true"></div>
                <div class="auth-card__titles">
                    <h1 class="auth-card__title">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_FORGOT_PASSWORD))
                    </h1>
                    <p class="auth-card__subtitle">
                        @PasswordRecoveryConfirmationViewState.ConfirmationCodeMessage
                    </p>
                </div>
            </div>

            <OtpDigitGroup Digits="@PasswordRecoveryConfirmationViewState.Digits"
                           OnDigitChanged="@(async args => await PasswordRecoveryConfirmationViewService.SetDigitAsync(args.Index, args.Value))"
                           OnDigitCleared="@(async idx => await PasswordRecoveryConfirmationViewService.ClearDigitAsync(idx))"
                           AriaGroupLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_OTP_GROUP_ARIA))"
                           AriaLabelForIndex="@(i => LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_OTP_DIGIT_ARIA), i))" />

            <ErrorBlock Message="@(PasswordRecoveryConfirmationViewState.HasError ? PasswordRecoveryConfirmationViewState.ErrorMessage : null)" />

            <div class="confirmation-resend-row">
                @if (!PasswordRecoveryConfirmationViewState.TimerExpired)
                {
                    <p class="confirmation-timer">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_TIMER_PREFIX))<CountdownDisplay Seconds="@PasswordRecoveryConfirmationViewState.SecondsLeft" />
                    </p>
                }
                else
                {
                    <button type="button" class="confirmation-resend-btn" @onclick="ResendCode">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_RESEND))
                    </button>
                }
            </div>

            <button type="button"
                    class="auth-submit"
                    disabled="@(!PasswordRecoveryConfirmationViewState.CanSubmit || PasswordRecoveryConfirmationViewState.IsLoading)"
                    @onclick="ConfirmAsync">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_SUBMIT))
            </button>

        </div>

    </div>
}
else
{
    <div class="page-create-account">

        <AuthBackHeader OnBack="NavigateBack"
                        BackText="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_BACK))"
                        AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_BACK))" />

        <div class="registration-waiting-body">

            <div class="auth-hero auth-hero--centered">
                <h1 class="auth-hero__title auth-hero__title--sm">
                    @LocalizationService.GetString(PasswordRecoveryConfirmationViewState.Action == PasswordRecoveryAction.Call
                        ? nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_CALL_TITLE)
                        : nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_FORGOT_PASSWORD))
                </h1>
                <p class="auth-hero__subtitle">
                    @if (PasswordRecoveryConfirmationViewState.Action == PasswordRecoveryAction.Call)
                    {
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_CALL_SUBTITLE))
                    }
                    else
                    {
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_WAITING_SUBTITLE))
                    }
                </p>
            </div>

            <ErrorBlock Message="@(PasswordRecoveryConfirmationViewState.HasError ? PasswordRecoveryConfirmationViewState.ErrorMessage : null)" ShowIcon="true" />

            @if (PasswordRecoveryConfirmationViewState.Action == PasswordRecoveryAction.Call)
            {
                <InfoBlock Message="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_CALL_HINT), PasswordRecoveryConfirmationViewState.CallPhoneNumber ?? string.Empty)" ShowIcon="true" />
            }
            else if (PasswordRecoveryConfirmationViewState.Action == PasswordRecoveryAction.Redirect && PasswordRecoveryConfirmationViewState.RedirectUrl is not null)
            {
                @if (PasswordRecoveryConfirmationViewState.IsQrExpired)
                {
                    <ErrorBlock Message="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_REDIRECT_SESSION_EXPIRED))" ShowIcon="true" />

                    <button type="button" class="auth-submit" @onclick="NavigateBack">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_REDIRECT_BACK_TO_MAIN))
                    </button>
                }
                else
                {
                    <button type="button" class="auth-submit" @onclick="OpenAsync">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_REDIRECT_OPEN))
                    </button>
                }
            }

            @if (!PasswordRecoveryConfirmationViewState.IsQrExpired)
            {
                <div class="registration-waiting-dots" role="status" aria-label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_WAITING_CONFIRMATION))">
                    <span class="registration-waiting-dot"></span>
                    <span class="registration-waiting-dot"></span>
                    <span class="registration-waiting-dot"></span>
                </div>
            }

        </div>

    </div>
}
