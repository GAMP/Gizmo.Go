@attribute [Route(NavigationHelper.NewsRoute)]
@attribute [Authorize]

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_NEWS_PAGE_TITLE))</PageTitle>

<div class="page-shell page-shell--news page-news">

    <ScreenBackHeader Title="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_NEWS_PAGE_TITLE))"
                      AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_BACK))"
                      OnBack="BackAsync" />

    <div class="page-news__content">
        @if (NewsListViewState.News.HasError)
        {
            <ErrorBlock Message="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_LOAD_ERROR))"
                        OnRetry="NewsListViewService.LoadAsync" />
        }
        else if (NewsListViewState.News.IsLoading)
        {
            <div class="home-skeleton page-news__skeleton"></div>
            <div class="home-skeleton page-news__skeleton"></div>
        }
        else if (NewsListViewState.News.Value is { Count: 0 })
        {
            <div class="page-news__empty">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_NEWS_EMPTY))</div>
        }
        else
        {
            <div class="page-news__list">
                @foreach (var item in NewsListViewState.News.Value ?? [])
                {
                    <NewsCard @key="item.Id" Item="item" Variant="NewsCard.NewsCardVariant.List" OnClick="OnNewsClick" />
                }
            </div>
        }
    </div>
</div>
