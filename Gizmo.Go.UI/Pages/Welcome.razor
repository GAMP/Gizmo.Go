@page "/"
@layout LoginLayout

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_WELCOME_PAGE_TITLE))</PageTitle>

<div class="page-welcome">

    <div class="welcome-hero-backdrop" aria-hidden="true"></div>

    <header class="welcome-header">
        <div class="welcome-logo">
            <div class="welcome-logo__icon" aria-hidden="true"></div>
            <span class="welcome-logo__name">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_APP_TITLE))</span>
        </div>

        <LangButton />
    </header>

    <div class="welcome-hero-spacer" aria-hidden="true"></div>

    <div class="welcome-chips" role="list" aria-label="Возможности приложения">

        <div class="welcome-chip" role="listitem">
            <svg viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M6.5 1.5C4.29 1.5 2.5 3.29 2.5 5.5c0 3.5 4 7 4 7s4-3.5 4-7c0-2.21-1.79-4-4-4z" />
                <circle cx="6.5" cy="5.5" r="1.5" />
            </svg>
            <span>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_WELCOME_CHIP_FIND_CLUB))</span>
        </div>

        <div class="welcome-chip" role="listitem">
            <svg viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <rect x="1.5" y="3" width="10" height="7" rx="1.5" />
                <path d="M4.5 10.5v1M8.5 10.5v1M3 10.5h7" />
            </svg>
            <span>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_WELCOME_CHIP_BOOK_PC))</span>
        </div>

        <div class="welcome-chip" role="listitem">
            <svg viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <rect x="1.5" y="1.5" width="4" height="4" rx="0.75" />
                <rect x="7.5" y="1.5" width="4" height="4" rx="0.75" />
                <rect x="1.5" y="7.5" width="4" height="4" rx="0.75" />
                <rect x="7.5" y="7.5" width="3" height="3" rx="0.75" />
            </svg>
            <span>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_WELCOME_CHIP_QR_LOGIN))</span>
        </div>

    </div>

    <section class="welcome-content">
        <div class="welcome-section-label">
            <span class="welcome-section-label__dot"></span>
            <span class="welcome-section-label__text">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_WELCOME_SECTION_LABEL))
            </span>
        </div>

        <h1 class="welcome-title">
            <span class="welcome-title__line1">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_WELCOME_TITLE_LINE1))
            </span>
            <span class="welcome-title__line2">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_WELCOME_TITLE_LINE2))
            </span>
        </h1>

        <p class="welcome-description">
            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_WELCOME_DESCRIPTION))
        </p>
    </section>

    <div class="welcome-actions">
        <button type="button"
                class="welcome-btn welcome-btn--primary"
                @onclick="NavigateToLogin">
            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_WELCOME_SIGN_IN))
        </button>

        <button type="button"
                class="welcome-btn welcome-btn--secondary"
                @onclick="NavigateToRegister">
            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_WELCOME_CREATE_ACCOUNT))
        </button>

        <button type="button"
                class="welcome-btn welcome-btn--ghost"
                @onclick="ContinueAsGuest">
            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_WELCOME_CONTINUE_AS_GUEST))
        </button>
    </div>

</div>
