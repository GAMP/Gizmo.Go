@page "/login"
@layout LoginLayout
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_LOGIN_PAGE_TITLE))</PageTitle>

<div class="page-login">

    <div class="login-hero-backdrop" aria-hidden="true"></div>

    <header class="auth-header">
        <LangButton />
    </header>

    <div class="auth-body">

        <div class="auth-card">

            <div class="auth-card__header">
                <div class="auth-card__logo" aria-hidden="true"></div>
                <div class="auth-card__titles">
                    <h1 class="auth-card__title">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_LOGIN_PAGE_HEADING))
                    </h1>
                    <p class="auth-card__subtitle">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_LOGIN_PAGE_SUBTITLE))
                    </p>
                </div>
            </div>

            <EditForm EditContext="@LoginViewService.EditContext" @onkeydown="OnKeyDownAsync">

                <div class="login-tabs" role="tablist">
                    <button type="button"
                            role="tab"
                            class="login-tab @(IsPhoneTab ? "login-tab--active" : "")"
                            aria-selected="@IsPhoneTab"
                            @onclick="SetPhoneTab">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_LOGIN_TAB_PHONE))
                    </button>
                    <button type="button"
                            role="tab"
                            class="login-tab @(!IsPhoneTab ? "login-tab--active" : "")"
                            aria-selected="@(!IsPhoneTab)"
                            @onclick="SetNicknameTab">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_LOGIN_TAB_NICKNAME))
                    </button>
                </div>

                <div class="auth-fields">

                    <div class="auth-field">
                        <label class="auth-field__label" for="username">
                            @(IsPhoneTab
                                ? LocalizationService.GetString(nameof(Autogenerated.Resources.GO_LOGIN_PHONE_LABEL))
                                : LocalizationService.GetString(nameof(Autogenerated.Resources.GO_LOGIN_USERNAME_LABEL)))
                        </label>
                        <div class="auth-field__input-wrap @(HasErrors(() => LoginViewState.Username) ? "auth-field__input-wrap--invalid" : "")">
                            <input id="username"
                                   type="@(IsPhoneTab ? "tel" : "text")"
                                   class="auth-field__input"
                                   value="@LoginViewState.Username"
                                   @oninput="@(e => LoginViewService.SetUsernameAsync(e.Value?.ToString() ?? string.Empty))"
                                   disabled="@LoginViewState.IsLoading"
                                   autocomplete="@(IsPhoneTab ? "tel" : "username")"
                                   placeholder="@(IsPhoneTab
                                       ? LocalizationService.GetString(nameof(Autogenerated.Resources.GO_LOGIN_PHONE_PLACEHOLDER))
                                       : LocalizationService.GetString(nameof(Autogenerated.Resources.GO_LOGIN_USERNAME_PLACEHOLDER)))" />
                        </div>
                        <ValidationMessage For="@(() => LoginViewState.Username)" />
                    </div>

                    <div class="auth-field">
                        <div class="auth-field__label-row">
                            <label class="auth-field__label" for="password">
                                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_LOGIN_PASSWORD_LABEL))
                            </label>
                            <button type="button" class="login-forgot">
                                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_LOGIN_FORGOT_PASSWORD))
                            </button>
                        </div>
                        <div class="auth-field__input-wrap @(HasErrors(() => LoginViewState.Password) ? "auth-field__input-wrap--invalid" : "")">
                            <input id="password"
                                   type="@(ShowPassword ? "text" : "password")"
                                   class="auth-field__input"
                                   value="@LoginViewState.Password"
                                   @oninput="@(e => LoginViewService.SetPasswordAsync(e.Value?.ToString() ?? string.Empty))"
                                   disabled="@LoginViewState.IsLoading"
                                   autocomplete="current-password"
                                   placeholder="••••••••" />
                            <EyeToggleButton Visible="ShowPassword" OnToggle="TogglePasswordVisibility" />
                        </div>
                        <ValidationMessage For="@(() => LoginViewState.Password)" />
                    </div>

                </div>

                @if (!string.IsNullOrEmpty(LoginViewState.ErrorMessage))
                {
                    <div class="login-error">
                        @LoginViewState.ErrorMessage
                    </div>
                }

                <button type="button"
                        class="auth-submit"
                        disabled="@(LoginViewState.IsValid != true || LoginViewState.IsLoading)"
                        @onclick="SubmitAsync">
                    @(LoginViewState.IsLoading
                        ? LocalizationService.GetString(nameof(Autogenerated.Resources.GO_LOGIN_SUBMIT_LOADING))
                        : LocalizationService.GetString(nameof(Autogenerated.Resources.GO_LOGIN_SUBMIT)))
                </button>

            </EditForm>

        </div>

        <div class="auth-footer">
            <span class="auth-footer__text">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_LOGIN_NO_ACCOUNT))
            </span>
            <button type="button" class="auth-footer__link" @onclick="NavigateToCreateAccount">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_WELCOME_CREATE_ACCOUNT))
            </button>
        </div>

    </div>

</div>
