@attribute [Route(NavigationHelper.ProfileLanguageRoute)]
@attribute [Authorize]

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_LANGUAGE))</PageTitle>

<div class="page-shell page-profile-language">

    <ScreenBackHeader Title="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_LANGUAGE))"
                      IsCentered="true"
                      AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_BACK))"
                      OnBack="BackAsync" />

    <div class="screen-content">
        <div class="language-list" role="radiogroup" aria-label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_LANGUAGE))">
            @foreach (var language in ProfileLanguageViewState.Languages)
            {
                var code = language.Code;
                var isCurrent = code == ProfileLanguageViewState.CurrentCode;
                <button type="button"
                        class="language-item @(isCurrent ? "language-item--selected" : "")"
                        role="radio"
                        aria-checked="@(isCurrent ? "true" : "false")"
                        @onclick="() => SelectAsync(code)">
                    <span class="language-item__text">
                        <span class="language-item__native">@language.NativeName</span>
                        <span class="language-item__english">@language.EnglishName</span>
                    </span>
                    <span class="language-item__radio" aria-hidden="true"></span>
                </button>
            }
        </div>
    </div>
</div>
