@attribute [Route(NavigationHelper.ProfileAboutDocumentRoute)]
@attribute [Authorize]

<PageTitle>@Title</PageTitle>

<div class="page-shell page-profile-about-document">

    <ScreenBackHeader Title="@Title"
                      IsCentered="true"
                      AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_BACK))"
                      OnBack="BackAsync" />

    <div class="screen-content">
        @if (ProfileAboutDocumentViewState.IsNotFound)
        {
            <ErrorBlock Message="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_DOCUMENT_NOT_FOUND))"
                        OnBack="BackAsync" />
        }
        else
        {
            <DocumentText Text="@ProfileAboutDocumentViewState.Text" IsHtml="false" />
        }
    </div>
</div>
