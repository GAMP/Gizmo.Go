@attribute [Route(NavigationHelper.ClubRoute)]
@attribute [Authorize]

<PageTitle>@PageTitleText</PageTitle>

<div class="page-shell page-club">

    @if (ClubViewState.Details.Value is { } details && !ClubViewState.Details.HasError)
    {
        var club = details.Branch;
        var placeholder = LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_NO_API_DATA));
        var price = LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_PRICE_PLACEHOLDER));
        var priceFrom = LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CLUB_PRICE_FROM));

        <article class="club-page">
            <div class="club-page__gallery">
                <ScreenBackHeader IsOverlay="true"
                                  AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_BACK))"
                                  OnBack="BackAsync" />
                <span class="club-page__placeholder">@placeholder</span>
            </div>

            <div class="club-page__content">
                <div class="club-page__intro">
                    <h1 class="club-page__name">@club.Name</h1>

                    @if (!string.IsNullOrWhiteSpace(club.Info))
                    {
                        <p class="club-page__info">@club.Info</p>
                    }

                    <div class="club-page__stats">
                        <div class="club-page__stat">
                            <span class="club-page__stat-label">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CLUB_TOTAL_PCS))</span>
                            <span class="club-page__stat-value">@details.TotalComputers</span>
                        </div>
                        <div class="club-page__stat">
                            <span class="club-page__stat-label">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CLUB_FREE_PCS))</span>
                            <span class="club-page__stat-value club-page__stat-value--free">@details.FreeComputers</span>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(club.Address))
                {
                    <section class="club-page__section">
                        <h2 class="club-page__label">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CLUB_ADDRESS))</h2>
                        <div class="club-page__map">
                            <span class="club-page__placeholder">@placeholder</span>
                            <div class="club-page__map-address">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                                    <circle cx="12" cy="10" r="3" />
                                </svg>
                                <span>@club.Address</span>
                            </div>
                        </div>
                    </section>
                }

                @if (club.BusinessDayStart is not null && club.BusinessDayEnd is not null)
                {
                    <section class="club-page__section">
                        <h2 class="club-page__label">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CLUB_HOURS))</h2>
                        <ClubSchedule Club="club"
                                      IsExpanded="ClubViewState.IsScheduleExpanded"
                                      OnToggle="ClubViewService.ToggleSchedule" />
                    </section>
                }

                @if (!string.IsNullOrWhiteSpace(club.Phone))
                {
                    <section class="club-page__section">
                        <h2 class="club-page__label">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CLUB_CONTACTS))</h2>
                        <button type="button" class="club-page__row" @onclick="ClubViewService.CallAsync">
                            <span class="club-page__row-icon club-page__row-icon--phone">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" />
                                </svg>
                            </span>
                            <span class="club-page__row-text">
                                <span class="club-page__row-title">@club.Phone</span>
                                <span class="club-page__row-hint club-page__row-hint--call">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CLUB_TAP_TO_CALL))</span>
                            </span>
                        </button>
                    </section>
                }

                <section class="club-page__section">
                    <h2 class="club-page__label">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CLUB_PRICES))</h2>
                    <div class="club-page__prices">
                        <div class="club-page__prices-header">
                            <span class="club-page__prices-title">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z" />
                                </svg>
                                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CLUB_PRICE_LIST))
                            </span>
                            <span class="club-page__price">
                                <span class="club-page__price-from">@priceFrom</span>
                                <span class="club-page__price-value">@price</span>
                                <span class="club-page__price-unit">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CLUB_PER_HOUR))</span>
                            </span>
                        </div>

                        @if (details.HostGroups.Count > 0)
                        {
                            for (var index = 0; index < details.HostGroups.Count; index++)
                            {
                                <div class="club-page__price-row">
                                    <span class="club-page__price-name">
                                        <span class="club-page__price-dot club-page__price-dot--@(index % 4)"></span>
                                        @details.HostGroups[index]
                                    </span>
                                    <span class="club-page__price">
                                        <span class="club-page__price-from">@priceFrom</span>
                                        <span class="club-page__price-value club-page__price-value--row">@price</span>
                                        <span class="club-page__price-unit">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CLUB_PER_HOUR_SHORT))</span>
                                    </span>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="club-page__price-row club-page__price-row--placeholder">@placeholder</div>
                        }

                        <span class="club-page__prices-more">
                            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CLUB_MORE))
                            <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                                <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </span>
                    </div>
                </section>

                <section class="club-page__section">
                    <h2 class="club-page__label">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CLUB_RULES))</h2>
                    <button type="button" class="club-page__row" @onclick="ClubViewService.ShowClubRulesAsync">
                        <span class="club-page__row-icon">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                            </svg>
                        </span>
                        <span class="club-page__row-text">
                            <span class="club-page__row-title">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CLUB_RULES_CLUB))</span>
                            <span class="club-page__row-hint">@placeholder</span>
                        </span>
                        <svg class="club-page__row-chevron" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                            <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </button>
                    <button type="button" class="club-page__row" @onclick="ClubViewService.ShowBookingRulesAsync">
                        <span class="club-page__row-icon">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                            </svg>
                        </span>
                        <span class="club-page__row-text">
                            <span class="club-page__row-title">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CLUB_RULES_BOOKING))</span>
                            <span class="club-page__row-hint">@placeholder</span>
                        </span>
                        <svg class="club-page__row-chevron" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                            <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </button>
                </section>
            </div>

            <button type="button" class="club-page__bar" disabled>
                <span class="club-page__bar-info">
                    <span class="club-page__bar-free">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CLUB_FREE_PCS_COUNT), details.FreeComputers)</span>
                    <span class="club-page__bar-title">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CLUB_BOOK_PC))</span>
                </span>
                <span class="club-page__bar-price">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CLUB_PRICE_FROM_HOUR), price)
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </span>
            </button>
        </article>
    }
    else
    {
        <ScreenBackHeader Title="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CLUB_PAGE_TITLE))"
                          AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_BACK))"
                          OnBack="BackAsync" />

        <div class="page-club__state">
            @if (ClubViewState.Details.HasError)
            {
                <ErrorBlock Message="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_LOAD_ERROR))"
                            OnRetry="ReloadAsync" />
            }
            else if (ClubViewState.IsNotFound)
            {
                <ErrorBlock Message="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CLUB_NOT_FOUND))" />
            }
            else
            {
                <div class="home-skeleton page-club__skeleton"></div>
            }
        </div>
    }
</div>
