@page "/registration-email-add-phone"
@layout LoginLayout

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_EMAIL_ADD_PHONE_PAGE_TITLE))</PageTitle>

<div class="page-create-account">

    <header class="auth-header create-password-header">
        <button class="create-password-back-btn" type="button" @onclick="NavigateBack"
                aria-label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_BACK))">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M12.5 6.25L8.75 10l3.75 3.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_BACK))</span>
        </button>
        <LangButton />
    </header>

    <div class="registration-email-add-phone-body">

        <div class="registration-email-add-phone-hero">
            <h1 class="registration-email-add-phone-title">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_EMAIL_ADD_PHONE_HEADING))
            </h1>
            <p class="registration-email-add-phone-subtitle">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_EMAIL_ADD_PHONE_SUBTITLE))
            </p>
        </div>

        <div class="registration-email-add-phone-email-badge" role="status">
            <span class="registration-email-add-phone-email-badge__icon" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="1" y="3" width="12" height="8" rx="1.5" stroke="currentColor" stroke-width="1.2" />
                    <path d="M1 4.5l6 4 6-4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>
            <span class="registration-email-add-phone-email-badge__text">
                <span class="registration-email-add-phone-email-badge__label">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_EMAIL_ADD_PHONE_EMAIL_CONFIRMED))
                </span>
                <span class="registration-email-add-phone-email-badge__value">@RegistrationEmailAddPhoneViewState.ConfirmedEmail</span>
            </span>
        </div>

        <div class="auth-field">
            <label class="auth-field__label" for="add-phone">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_EMAIL_ADD_PHONE_PHONE_LABEL))
            </label>
            <div class="auth-field__input-wrap">
                <input id="add-phone"
                       type="tel"
                       class="auth-field__input"
                       value="@RegistrationEmailAddPhoneViewState.Phone"
                       @oninput="OnPhoneInput"
                       autocomplete="tel"
                       inputmode="tel"
                       placeholder="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_EMAIL_ADD_PHONE_PHONE_PLACEHOLDER))" />
            </div>
        </div>

        <div class="registration-email-add-phone-info" role="note">
            <p class="registration-email-add-phone-info__text">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_EMAIL_ADD_PHONE_INFO))
            </p>
        </div>

        <button type="button"
                class="auth-submit create-account-submit"
                disabled="@(!CanSubmit)"
                @onclick="SubmitAsync">
            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_EMAIL_ADD_PHONE_SUBMIT))
        </button>

    </div>

</div>
