@page "/registration-confirmation"
@layout LoginLayout

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_PAGE_TITLE))</PageTitle>

<div class="page-confirmation">

    <AuthBackHeader OnBack="NavigateBack"
                    IconShape="@AuthBackHeader.BackIconShape.Circle"
                    AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_BACK))" />

    <div class="confirmation-body">

        <div class="auth-card__header">
            <div class="auth-card__logo" aria-hidden="true"></div>
            <div class="auth-card__titles">
                <h1 class="auth-card__title">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_HEADING))
                </h1>
                <p class="auth-card__subtitle">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_SUBTITLE_PREFIX))
                    @if (!string.IsNullOrEmpty(RegistrationConfirmationViewState.MaskedPhone))
                    {
                        <span class="confirmation-phone">@RegistrationConfirmationViewState.MaskedPhone</span>
                    }
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_SUBTITLE_SUFFIX))
                </p>
            </div>
        </div>

        <OtpDigitGroup Digits="@RegistrationConfirmationViewState.Digits"
                       OnDigitChanged="@(async args => await RegistrationConfirmationViewService.SetDigitAsync(args.Index, args.Value))"
                       OnDigitCleared="@(async idx => await RegistrationConfirmationViewService.ClearDigitAsync(idx))"
                       AriaGroupLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_OTP_GROUP_ARIA))"
                       AriaLabelForIndex="@(i => LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_OTP_DIGIT_ARIA), i))" />

        <ErrorBlock Message="@RegistrationConfirmationViewState.ErrorMessage" />

        <div class="confirmation-resend-row">
            @if (!RegistrationConfirmationViewState.TimerExpired)
            {
                <p class="confirmation-timer">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_TIMER_PREFIX))<CountdownDisplay Seconds="@RegistrationConfirmationViewState.SecondsLeft" />
                </p>
            }
            else
            {
                <button type="button" class="confirmation-resend-btn" @onclick="RestartTimer">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_RESEND))
                </button>
            }
            <button type="button" class="confirmation-change-number-btn" @onclick="NavigateBack">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_CHANGE_NUMBER))
            </button>
        </div>

        <button type="button"
                class="auth-submit"
                disabled="@(!RegistrationConfirmationViewState.CanSubmit || RegistrationConfirmationViewState.IsSubmitting)"
                @onclick="ConfirmAsync">
            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_SUBMIT))
        </button>

        <p class="confirmation-hint">
            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_HINT))
        </p>

    </div>

</div>
