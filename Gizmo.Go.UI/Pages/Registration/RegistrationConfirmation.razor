@page "/registration-confirmation"
@layout LoginLayout

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_PAGE_TITLE))</PageTitle>

<div class="page-confirmation">

    <header class="auth-header confirmation-header">
        <button class="confirmation-back-btn" type="button" @onclick="NavigateBack" aria-label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_BACK))">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M10 4L6 8l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
        <LangButton />
    </header>

    <div class="auth-body">

        <div class="auth-card">

            <div class="auth-card__header">
                <div class="confirmation-card__icon" aria-hidden="true"></div>
                <div class="auth-card__titles">
                    <h1 class="auth-card__title">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_HEADING))
                    </h1>
                    <p class="auth-card__subtitle">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_SUBTITLE_PREFIX))
                    </p>
                </div>
            </div>

            <div class="confirmation-otp-row" role="group" aria-label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_OTP_GROUP_ARIA))">
                @for (var i = 0; i < 6; i++)
                {
                    var idx = i;
                    <input type="tel"
                           inputmode="numeric"
                           class="confirmation-otp-input @(RegistrationConfirmationViewState.Digits[idx].Length == 1 ? "confirmation-otp-input--filled" : "")"
                           maxlength="1"
                           value="@RegistrationConfirmationViewState.Digits[idx]"
                           @ref="_inputRefs[idx]"
                           @oninput="@(e => OnDigitInput(idx, e))"
                           @onkeydown="@(e => OnDigitKeyDown(idx, e))"
                           autocomplete="one-time-code"
                           aria-label="@string.Format(LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_OTP_DIGIT_ARIA)), idx + 1)" />
                }
            </div>

            <ErrorBlock Message="@RegistrationConfirmationViewState.ErrorMessage" />

            <div class="confirmation-resend-row">
                @if (!RegistrationConfirmationViewState.TimerExpired)
                {
                    <p class="confirmation-timer">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_TIMER_PREFIX))@RegistrationConfirmationViewState.TimerDisplay
                    </p>
                }
                else
                {
                    <button type="button" class="confirmation-resend-btn" @onclick="RestartTimer">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_RESEND))
                    </button>
                }
                <button type="button" class="confirmation-change-number-btn" @onclick="NavigateBack">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_CHANGE_NUMBER))
                </button>
            </div>

            <button type="button"
                    class="auth-submit"
                    disabled="@(!RegistrationConfirmationViewState.CanSubmit || RegistrationConfirmationViewState.IsSubmitting)"
                    @onclick="ConfirmAsync">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_SUBMIT))
            </button>

            <p class="confirmation-hint">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_HINT))
            </p>

        </div>

    </div>

</div>
