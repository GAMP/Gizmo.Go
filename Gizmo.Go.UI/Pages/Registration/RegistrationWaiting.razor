@page "/registration-waiting"
@layout LoginLayout

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_WAITING_PAGE_TITLE))</PageTitle>

<div class="page-create-account">

    <AuthBackHeader OnBack="NavigateBack"
                    BackText="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_BACK))"
                    AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_BACK))" />

    <div class="registration-waiting-body">

        <div class="registration-waiting-icon" aria-hidden="true">
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M41.4 7.2L34.7 40.4c-.5 2.2-1.8 2.7-3.6 1.7l-10-7.4-4.8 4.6c-.5.5-1 1-2 1l.7-10.2 17.3-15.6c.9-.8-.2-1.2-1.4-.4L11.8 29.9 2 27c-2.1-.7-2.2-2.1.5-3.1L38.8 4.6c1.8-.7 3.4.4 2.6 2.6z" fill="#ffffff" />
            </svg>
        </div>

        <div class="auth-hero auth-hero--centered">
            <h1 class="auth-hero__title auth-hero__title--sm">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_WAITING_HEADING))
            </h1>
            <p class="auth-hero__subtitle">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_WAITING_SUBTITLE))
            </p>
        </div>

        <div class="registration-waiting-dots" role="status" aria-label="Загрузка">
            <span class="registration-waiting-dot"></span>
            <span class="registration-waiting-dot"></span>
            <span class="registration-waiting-dot"></span>
        </div>

    </div>

</div>
