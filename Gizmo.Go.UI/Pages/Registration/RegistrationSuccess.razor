@page "/registration-success"
@layout LoginLayout

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_SUCCESS_PAGE_TITLE))</PageTitle>

<div class="page-registration-success">

    <header class="auth-header">
        <LangButton />
    </header>

    <div class="registration-success-body">

        <div class="registration-success-icon" aria-hidden="true">
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M10 24L20 34L38 14" stroke="#0091e6" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </div>

        <div class="registration-success-content">
            <div class="registration-success-emoji" aria-hidden="true">🎮</div>
            <h1 class="registration-success-title">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_SUCCESS_HEADING))
            </h1>
            <p class="registration-success-subtitle">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_SUCCESS_SUBTITLE))
            </p>
        </div>

        <div class="registration-success-chips" role="list" aria-label="Возможности">
            <div class="registration-success-chips__row">
                <span class="registration-success-chip" role="listitem">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_SUCCESS_CHIP_PC))
                </span>
                <span class="registration-success-chip" role="listitem">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_SUCCESS_CHIP_BALANCE))
                </span>
            </div>
            <div class="registration-success-chips__row">
                <span class="registration-success-chip" role="listitem">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_SUCCESS_CHIP_QUICK_LOGIN))
                </span>
            </div>
        </div>

        <div class="registration-success-actions">
            <button type="button" class="auth-submit" @onclick="NavigateHomeAsync">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_SUCCESS_SUBMIT))
            </button>
            <p class="registration-success-note">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_SUCCESS_NOTE))
            </p>
        </div>

    </div>

</div>
