@page "/registration-providers"
@layout LoginLayout

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_PAGE_TITLE))</PageTitle>

<div class="page-create-account">

    <AuthBackHeader OnBack="NavigateBack"
                    BackText="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_BACK))"
                    AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_BACK))" />

    <div class="auth-body">

        <div class="auth-card">

            <div class="auth-card__header">
                <div class="auth-card__logo" aria-hidden="true"></div>
                <div class="auth-card__titles">
                    <h1 class="auth-card__title">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_HEADING))
                    </h1>
                    <p class="auth-card__subtitle">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_SUBTITLE))
                    </p>
                </div>
            </div>

            <ErrorBlock Message="@RegistrationProvidersViewState.ErrorMessage" ShowIcon="true" />

            @if (RegistrationProvidersViewState.IsLoading)
            {
                <p class="auth-card__subtitle">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_LOADING))
                </p>
            }
            else if (RegistrationProvidersViewState.Providers.Count == 0)
            {
                <p class="auth-card__subtitle">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_EMPTY))
                </p>
            }
            else
            {
                <ul class="registration-providers-list" role="list">
                    @foreach (var provider in RegistrationProvidersViewState.PriorityProviders)
                    {
                        <li @key="provider.PublicId">
                            <button type="button"
                                    class="registration-providers-btn registration-providers-btn--primary"
                                    @onclick="() => SelectProviders(provider.ChannelGuid)">
                                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_CONTINUE_WITH))@provider.Name
                            </button>
                        </li>
                    }
                </ul>

                @if (RegistrationProvidersViewState.HasError)
                {
                    if (RegistrationProvidersViewState.AltProviders.Count > 0)
                    {
                        <div class="registration-providers-alt">

                            <div class="registration-providers-divider" aria-hidden="true">
                                <span class="registration-providers-divider__line"></span>
                                <span class="registration-providers-divider__badge">
                                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_ALT_DIVIDER))
                                </span>
                                <span class="registration-providers-divider__line"></span>
                            </div>

                            <p class="registration-providers-alt__description">
                                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_ALT_DESCRIPTION))
                            </p>

                            <ul class="registration-providers-alt__list" role="list">
                                @foreach (var provider in RegistrationProvidersViewState.AltProviders)
                                {
                                    <li @key="provider.PublicId">
                                        <button type="button"
                                                class="registration-providers-alt__btn"
                                                @onclick="() => SelectProviders(provider.ChannelGuid)">
                                            @provider.Name
                                        </button>
                                    </li>
                                }
                            </ul>

                        </div>
                    }
                }
            }

            <p class="registration-providers-terms">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_TERMS_PREFIX))<span class="create-account-terms__link">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_TERMS_LINK1))</span>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_TERMS_AND))<span class="create-account-terms__link">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_TERMS_LINK2))</span>.
            </p>

        </div>

        <div class="auth-footer">
            <span class="auth-footer__text">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_HAS_ACCOUNT))
            </span>
            <button type="button" class="auth-footer__link" @onclick="NavigateToLogin">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_SIGN_IN))
            </button>
        </div>

    </div>

</div>
