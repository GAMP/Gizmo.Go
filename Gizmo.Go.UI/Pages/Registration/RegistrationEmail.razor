@page "/registration-email"
@layout LoginLayout

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_EMAIL_PAGE_TITLE))</PageTitle>

<div class="page-create-account">

    <AuthBackHeader OnBack="NavigateBack"
                    BackText="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_BACK))"
                    AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_BACK))" />

    <div class="registration-email-body">

        <div class="registration-email-hero">
            <h1 class="registration-email-title">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_HEADING))
            </h1>
            <p class="registration-email-subtitle">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_EMAIL_SUBTITLE))
            </p>
        </div>

        <EditForm EditContext="@RegistrationEmailViewService.EditContext">
        <div class="registration-email-fields">

            <div class="auth-field">
                <label class="auth-field__label" for="reg-email">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_EMAIL_LABEL))
                </label>
                <div class="auth-field__input-wrap">
                    <input id="reg-email"
                           type="email"
                           class="auth-field__input"
                           value="@RegistrationEmailViewState.Email"
                           @oninput="OnEmailInput"
                           autocomplete="email"
                           inputmode="email"
                           placeholder="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_EMAIL_PLACEHOLDER))" />
                </div>
                <ValidationMessage For="@(() => RegistrationEmailViewState.Email)" />
            </div>

            <div class="registration-email-hint" role="note">
                <span class="registration-email-hint__icon" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.2" opacity="0.7" />
                        <line x1="7" y1="6.5" x2="7" y2="9.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                        <circle cx="7" cy="4.5" r="0.7" fill="currentColor" />
                    </svg>
                </span>
                <span>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_EMAIL_HINT))</span>
            </div>

        </div>

        <button type="button"
                class="auth-submit"
                disabled="@(!RegistrationEmailViewState.CanSubmit)"
                @onclick="SubmitAsync">
            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_SUBMIT))
        </button>

        </EditForm>

        <div class="registration-email-or" aria-hidden="true">
            <span class="registration-email-or__line"></span>
            <span class="registration-email-or__text">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_EMAIL_OR))
            </span>
            <span class="registration-email-or__line"></span>
        </div>

        <button type="button"
                class="registration-email-secondary-btn"
                @onclick="NavigateToAlternative">
            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_EMAIL_ALT))
        </button>

        <div class="auth-footer">
            <span class="auth-footer__text">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_HAS_ACCOUNT))
            </span>
            <button type="button" class="auth-footer__link" @onclick="NavigateToLogin">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_SIGN_IN))
            </button>
        </div>

    </div>

</div>
