@attribute [Route(NavigationHelper.RegistrationSuccessRoute)]
@layout LoginLayout

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_SUCCESS_PAGE_TITLE))</PageTitle>

<SuccessScreen Title="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_SUCCESS_HEADING))"
               ButtonText="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_SUCCESS_SUBMIT))"
               OnButtonClick="NavigateToLoginAsync">
    <Subtitle>
        @if (string.IsNullOrEmpty(UserRegistrationSuccessViewState.DisplayContact))
        {
            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_SUCCESS_SUBTITLE))
        }
        else
        {
            @LocalizationService.GetString(UserRegistrationSuccessViewState.IsEmailContact
                ? nameof(Autogenerated.Resources.GO_REGISTRATION_SUCCESS_SUBTITLE_EMAIL)
                : nameof(Autogenerated.Resources.GO_REGISTRATION_SUCCESS_SUBTITLE_PHONE),
                UserRegistrationSuccessViewState.DisplayContact)
        }
    </Subtitle>
    <ChildContent>
        @if (!string.IsNullOrEmpty(UserRegistrationSuccessViewState.DisplayContact))
        {
            <div class="registration-success-card">
                <span class="registration-success-card__label">
                    @LocalizationService.GetString(UserRegistrationSuccessViewState.IsEmailContact
                        ? nameof(Autogenerated.Resources.GO_REGISTRATION_SUCCESS_EMAIL_LABEL)
                        : nameof(Autogenerated.Resources.GO_REGISTRATION_SUCCESS_PHONE_LABEL))
                </span>
                <span class="registration-success-card__value">@UserRegistrationSuccessViewState.DisplayContact</span>
            </div>
        }
    </ChildContent>
</SuccessScreen>
