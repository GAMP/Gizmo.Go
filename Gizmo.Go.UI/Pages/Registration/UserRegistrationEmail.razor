@attribute [Route(NavigationHelper.RegistrationEmailRoute)]
@layout LoginLayout

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_EMAIL_PAGE_TITLE))</PageTitle>

<div class="page-create-account">

    <AuthBackHeader OnBack="NavigateBack"
                    BackText="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_BACK))"
                    AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_BACK))" />

    <ContactEntryForm Title="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_HEADING))"
                      Subtitle="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_EMAIL_SUBTITLE))"
                      ErrorMessage="@(UserRegistrationEmailViewState.HasError ? UserRegistrationEmailViewState.ErrorMessage : null)"
                      EditContext="@UserRegistrationEmailViewService.EditContext"
                      Hint="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_EMAIL_HINT))"
                      SubmitText="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_SUBMIT))"
                      SubmitDisabled="@(UserRegistrationEmailViewState.IsValid != true || UserRegistrationEmailViewState.IsLoading)"
                      OnSubmit="SubmitAsync"
                      OnAlternative="NavigateToAlternative"
                      OnSignIn="NavigateToLogin">
        <Field>
            <div class="auth-field">
                <label class="auth-field__label" for="reg-email">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_EMAIL_LABEL))
                </label>
                <div class="auth-field__input-wrap">
                    <input id="reg-email"
                           type="email"
                           class="auth-field__input"
                           value="@UserRegistrationEmailViewState.Email"
                           @oninput="OnEmailInput"
                           autocomplete="email"
                           inputmode="email"
                           placeholder="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_EMAIL_PLACEHOLDER))" />
                </div>
                <ValidationMessage For="@(() => UserRegistrationEmailViewState.Email)" />
            </div>
        </Field>
    </ContactEntryForm>

</div>
