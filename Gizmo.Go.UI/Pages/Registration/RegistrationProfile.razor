@page "/registration-profile"
@layout LoginLayout

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_PAGE_TITLE))</PageTitle>

<div class="page-create-password">

    <AuthBackHeader OnBack="NavigateBack"
                    BackText="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_BACK))"
                    AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_BACK))" />

    <div class="create-password-body">

        <div class="auth-hero">
            <h1 class="auth-hero__title">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_HEADING))
            </h1>
            <p class="auth-hero__subtitle">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_SUBTITLE))
            </p>
        </div>

        <div class="auth-stepper" role="list" aria-label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_STEPPER_ARIA))">
            <div class="auth-stepper__step auth-stepper__step--done" role="listitem">
                <span class="auth-stepper__badge" aria-label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_STEP_DONE_ARIA))">
                    <svg width="10" height="8" viewBox="0 0 10 8" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M1 4L3.5 6.5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </span>
                <span class="auth-stepper__label">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_STEPPER_ACCOUNT))
                </span>
            </div>
            <span class="auth-stepper__line" aria-hidden="true"></span>
            <div class="auth-stepper__step auth-stepper__step--active" role="listitem" aria-current="step">
                <span class="auth-stepper__badge" aria-hidden="true">2</span>
                <span class="auth-stepper__label">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_STEPPER_PROFILE))
                </span>
            </div>
        </div>

        <EditForm EditContext="@RegistrationProfileViewService.EditContext">
        <div class="create-password-fields">

            <div class="auth-field">
                <label class="auth-field__label" for="rp-username">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_USERNAME_LABEL))
                </label>
                <div class="auth-field__input-wrap @(HasErrors(() => RegistrationProfileViewState.Username) ? "auth-field__input-wrap--invalid" : "")">
                    <span class="auth-field__prefix" aria-hidden="true">@@</span>
                    <input id="rp-username"
                           type="text"
                           class="auth-field__input"
                           value="@_usernameInputValue"
                           @oninput="OnUsernameInput"
                           autocomplete="username"
                           placeholder="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_USERNAME_PLACEHOLDER))" />
                </div>
                <ValidationMessage For="@(() => RegistrationProfileViewState.Username)" />
            </div>

            <div class="auth-field">
                <label class="auth-field__label" for="rp-firstname">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_FIRST_NAME_LABEL))
                </label>
                <div class="auth-field__input-wrap">
                    <input id="rp-firstname"
                           type="text"
                           class="auth-field__input"
                           value="@RegistrationProfileViewState.FirstName"
                           @oninput="OnFirstNameInput"
                           autocomplete="given-name"
                           placeholder="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_FIRST_NAME_PLACEHOLDER))" />
                </div>
            </div>

            <div class="auth-field">
                <label class="auth-field__label" for="rp-lastname">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_LAST_NAME_LABEL))
                </label>
                <div class="auth-field__input-wrap">
                    <input id="rp-lastname"
                           type="text"
                           class="auth-field__input"
                           value="@RegistrationProfileViewState.LastName"
                           @oninput="OnLastNameInput"
                           autocomplete="family-name"
                           placeholder="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_LAST_NAME_PLACEHOLDER))" />
                </div>
            </div>

            <div class="auth-field">
                <label class="auth-field__label" for="rp-birthdate">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_BIRTH_DATE_LABEL))
                </label>
                <div class="auth-field__input-wrap">
                    <input id="rp-birthdate"
                           type="date"
                           class="auth-field__input"
                           value="@(RegistrationProfileViewState.BirthDate?.ToString("yyyy-MM-dd") ?? string.Empty)"
                           @onchange="OnBirthDateInput"
                           autocomplete="bday" />
                </div>
            </div>

        </div>

        </EditForm>

        <div class="registration-profile-notifications"
             aria-label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_NOTIFICATIONS_TITLE))">
            <p class="registration-profile-notifications__title">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_NOTIFICATIONS_TITLE))
            </p>
            <div class="registration-profile-notifications__row">
                <div class="registration-profile-notifications__text">
                    <span class="registration-profile-notifications__label">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_NOTIFICATIONS_LABEL))
                    </span>
                    <span class="registration-profile-notifications__hint">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_NOTIFICATIONS_HINT))
                    </span>
                </div>
                <span class="registration-profile-toggle" aria-hidden="true">
                    <span class="registration-profile-toggle__thumb"></span>
                </span>
            </div>
        </div>

        <ErrorBlock Message="@RegistrationProfileViewState.ErrorMessage" ShowIcon="true" />

        <div class="registration-profile-actions">
            <button type="button"
                    class="auth-submit"
                    disabled="@(RegistrationProfileViewState.IsValid != true || RegistrationProfileViewState.IsSubmitting)"
                    @onclick="SubmitAsync">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_SUBMIT))
            </button>
        </div>

        <p class="registration-profile-note">
            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_NOTE))
        </p>

    </div>

</div>
