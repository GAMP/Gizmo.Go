@page "/registration-bot-verify-success"
@layout LoginLayout

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_BOT_VERIFY_PAGE_TITLE))</PageTitle>

<div class="page-create-account">

    <AuthBackHeader OnBack="NavigateBackAsync"
                    BackText="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_BACK))"
                    AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_BACK))" />

    <div class="registration-bot-verify-body">

        <div class="auth-hero">
            <h1 class="auth-hero__title">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_BOT_VERIFY_HEADING))
            </h1>
            <p class="auth-hero__subtitle">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_BOT_VERIFY_SUBTITLE))
            </p>
        </div>

        <div class="registration-bot-verify-card">

            <div class="registration-bot-verify-card__provider-row">
                <div class="registration-bot-verify-card__provider-badge" aria-hidden="true">
                    <svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M25.4 4.2L20.7 23.6c-.3 1.3-1.1 1.6-2.2 1l-6.1-4.5-2.9 2.8c-.3.3-.6.6-1.2.6l.4-6.2L20.3 7.9c.5-.5-.1-.7-.8-.2L6.8 17.4 1 15.7c-1.3-.4-1.3-1.3.3-1.9L23.8 5.3c1-.4 2 .2 1.6 1z" fill="#ffffff" />
                    </svg>
                </div>
                <div class="registration-bot-verify-card__provider-info">
                    <div class="registration-bot-verify-card__provider-name-row">
                        <span class="registration-bot-verify-card__provider-name">Telegram</span>
                        <span class="registration-bot-verify-card__verified-pill">
                            <svg viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M2 5l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_BOT_VERIFY_TELEGRAM_CONFIRMED))
                        </span>
                    </div>
                    <span class="registration-bot-verify-card__provider-sub">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_BOT_VERIFY_TELEGRAM_CONNECTED))
                    </span>
                </div>
            </div>

            <div class="registration-bot-verify-card__divider" aria-hidden="true"></div>

            <p class="registration-bot-verify-card__phone-label">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_BOT_VERIFY_PHONE_LABEL))
            </p>
            <div class="registration-bot-verify-card__phone-row">
                <span class="registration-bot-verify-card__phone-number">@RegistrationBotVerifySuccessViewState.DisplayPhone</span>
                <span class="registration-bot-verify-card__phone-status">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_BOT_VERIFY_PHONE_VERIFIED))
                </span>
            </div>

        </div>

        <InfoBlock Message="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_BOT_VERIFY_INFO_TEXT))" ShowIcon="true" />

        <button type="button" class="auth-submit" @onclick="ConfirmAsync">
            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_BOT_VERIFY_SUBMIT))
        </button>

    </div>

</div>

