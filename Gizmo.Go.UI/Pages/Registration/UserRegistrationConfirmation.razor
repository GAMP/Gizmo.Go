@attribute [Route(NavigationHelper.RegistrationConfirmationRoute)]
@layout LoginLayout

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_PAGE_TITLE))</PageTitle>

<div class="page-confirmation">

    <AuthBackHeader OnBack="NavigateBack"
                    BackText="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_BACK))"
                    AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_BACK))" />

    <ConfirmationCodeForm IsEmail="@UserRegistrationConfirmationViewState.IsEmailFlow"
                          ErrorMessage="@(UserRegistrationConfirmationViewState.HasError ? UserRegistrationConfirmationViewState.ErrorMessage : null)"
                          Digits="@UserRegistrationConfirmationViewState.Digits"
                          OnDigitChanged="@(async args => await UserRegistrationConfirmationViewService.SetDigitAsync(args.Index, args.Value))"
                          OnDigitCleared="@(async idx => await UserRegistrationConfirmationViewService.ClearDigitAsync(idx))"
                          SecondsLeft="@UserRegistrationConfirmationViewState.SecondsLeft"
                          OnResend="RestartTimer"
                          OnChange="NavigateBack"
                          CodeLifetimeMinutes="@UserRegistrationConfirmationViewState.CodeLifetimeMinutes"
                          CanSubmit="@UserRegistrationConfirmationViewState.CanSubmit"
                          IsLoading="@UserRegistrationConfirmationViewState.IsLoading"
                          OnConfirm="ConfirmAsync">
        <Subtitle>
            @LocalizationService.GetString(UserRegistrationConfirmationViewState.IsEmailFlow
                ? nameof(Autogenerated.Resources.GO_REGISTRATION_EMAIL_CONFIRMATION_SUBTITLE_PREFIX)
                : nameof(Autogenerated.Resources.GO_CONFIRMATION_SUBTITLE_PREFIX),
                UserRegistrationConfirmationViewState.Digits.Length)
            @if (!string.IsNullOrEmpty(UserRegistrationConfirmationViewState.Destination))
            {
                <span class="confirmation-phone">@UserRegistrationConfirmationViewState.Destination</span>
            }
            @LocalizationService.GetString(UserRegistrationConfirmationViewState.IsEmailFlow
                ? nameof(Autogenerated.Resources.GO_REGISTRATION_EMAIL_CONFIRMATION_SUBTITLE_SUFFIX)
                : nameof(Autogenerated.Resources.GO_CONFIRMATION_SUBTITLE_SUFFIX))
        </Subtitle>
    </ConfirmationCodeForm>

</div>
