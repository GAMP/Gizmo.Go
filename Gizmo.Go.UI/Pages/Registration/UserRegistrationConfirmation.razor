@attribute [Route(NavigationHelper.RegistrationConfirmationRoute)]
@layout LoginLayout

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_PAGE_TITLE))</PageTitle>

<div class="page-confirmation">

    <AuthBackHeader OnBack="NavigateBack"
                    IconShape="@AuthBackHeader.BackIconShape.Circle"
                    AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_BACK))" />

    <div class="confirmation-body">

        <div class="auth-card__header">
            <div class="auth-card__logo" aria-hidden="true"></div>
            <div class="auth-card__titles">
                <h1 class="auth-card__title">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_HEADING))
                </h1>
                <p class="auth-card__subtitle">
                    @LocalizationService.GetString(UserRegistrationConfirmationViewState.IsEmailFlow
                        ? nameof(Autogenerated.Resources.GO_REGISTRATION_EMAIL_CONFIRMATION_SUBTITLE_PREFIX)
                        : nameof(Autogenerated.Resources.GO_CONFIRMATION_SUBTITLE_PREFIX))
                    @if (!string.IsNullOrEmpty(UserRegistrationConfirmationViewState.Destination))
                    {
                        <span class="confirmation-phone">@UserRegistrationConfirmationViewState.Destination</span>
                    }
                    @LocalizationService.GetString(UserRegistrationConfirmationViewState.IsEmailFlow
                        ? nameof(Autogenerated.Resources.GO_REGISTRATION_EMAIL_CONFIRMATION_SUBTITLE_SUFFIX)
                        : nameof(Autogenerated.Resources.GO_CONFIRMATION_SUBTITLE_SUFFIX))
                </p>
            </div>
        </div>

        <OtpDigitGroup Digits="@UserRegistrationConfirmationViewState.Digits"
                       OnDigitChanged="@(async args => await UserRegistrationConfirmationViewService.SetDigitAsync(args.Index, args.Value))"
                       OnDigitCleared="@(async idx => await UserRegistrationConfirmationViewService.ClearDigitAsync(idx))"
                       AriaGroupLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_OTP_GROUP_ARIA))"
                       AriaLabelForIndex="@(i => LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_OTP_DIGIT_ARIA), i))" />

        <ErrorBlock Message="@(UserRegistrationConfirmationViewState.HasError ? UserRegistrationConfirmationViewState.ErrorMessage : null)" />

        <div class="confirmation-resend-row">
            @if (!UserRegistrationConfirmationViewState.TimerExpired)
            {
                <p class="confirmation-timer">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_TIMER_PREFIX))<CountdownDisplay Seconds="@UserRegistrationConfirmationViewState.SecondsLeft" />
                </p>
            }
            else
            {
                <button type="button" class="confirmation-resend-btn" @onclick="RestartTimer">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_RESEND))
                </button>
            }
            <button type="button" class="confirmation-change-number-btn" @onclick="NavigateBack">
                @LocalizationService.GetString(UserRegistrationConfirmationViewState.IsEmailFlow
                    ? nameof(Autogenerated.Resources.GO_REGISTRATION_EMAIL_CONFIRMATION_CHANGE_EMAIL)
                    : nameof(Autogenerated.Resources.GO_CONFIRMATION_CHANGE_NUMBER))
            </button>
        </div>

        <button type="button"
                class="auth-submit"
                disabled="@(!UserRegistrationConfirmationViewState.CanSubmit || UserRegistrationConfirmationViewState.IsLoading)"
                @onclick="ConfirmAsync">
            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_SUBMIT))
        </button>

        <p class="confirmation-hint">
            @LocalizationService.GetString(UserRegistrationConfirmationViewState.IsEmailFlow
                ? nameof(Autogenerated.Resources.GO_REGISTRATION_EMAIL_CONFIRMATION_HINT)
                : nameof(Autogenerated.Resources.GO_CONFIRMATION_HINT))
        </p>

    </div>

</div>
