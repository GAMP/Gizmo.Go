@attribute [Route(NavigationHelper.RegistrationAdditionalFieldsRoute)]
@layout LoginLayout

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_PAGE_TITLE))</PageTitle>

<div class="page-create-password">

    <AuthBackHeader OnBack="NavigateBack"
                    BackText="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_BACK))"
                    AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_BACK))" />

    <div class="create-password-body">

        <div class="auth-hero">
            <h1 class="auth-hero__title">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_ADDITIONAL_FIELDS_HEADING))
            </h1>
        </div>

        <EditForm EditContext="@UserRegistrationAdditionalFieldsViewService.EditContext">
        <div class="create-password-fields">

            @if (ShowCountry)
            {
                <div class="auth-field">
                    <label class="auth-field__label" for="raf-country">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_USER_COUNTRY_REGION))
                    </label>
                    <div class="auth-field__input-wrap @(HasErrors(() => UserRegistrationAdditionalFieldsViewState.Country) ? "auth-field__input-wrap--invalid" : "")">
                        <input id="raf-country"
                               type="text"
                               class="auth-field__input"
                               value="@UserRegistrationAdditionalFieldsViewState.Country"
                               @oninput="OnCountryInput"
                               autocomplete="country-name"
                               maxlength="45" />
                    </div>
                    <ValidationMessage For="@(() => UserRegistrationAdditionalFieldsViewState.Country)" />
                </div>
            }

            @if (ShowAddress)
            {
                <div class="auth-field">
                    <label class="auth-field__label" for="raf-address">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_USER_ADDRESS))
                    </label>
                    <div class="auth-field__input-wrap @(HasErrors(() => UserRegistrationAdditionalFieldsViewState.Address) ? "auth-field__input-wrap--invalid" : "")">
                        <input id="raf-address"
                               type="text"
                               class="auth-field__input"
                               value="@UserRegistrationAdditionalFieldsViewState.Address"
                               @oninput="OnAddressInput"
                               autocomplete="street-address"
                               maxlength="255" />
                    </div>
                    <ValidationMessage For="@(() => UserRegistrationAdditionalFieldsViewState.Address)" />
                </div>
            }

            @if (ShowCity)
            {
                <div class="auth-field">
                    <label class="auth-field__label" for="raf-city">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_USER_CITY))
                    </label>
                    <div class="auth-field__input-wrap @(HasErrors(() => UserRegistrationAdditionalFieldsViewState.City) ? "auth-field__input-wrap--invalid" : "")">
                        <input id="raf-city"
                               type="text"
                               class="auth-field__input"
                               value="@UserRegistrationAdditionalFieldsViewState.City"
                               @oninput="OnCityInput"
                               autocomplete="address-level2"
                               maxlength="45" />
                    </div>
                    <ValidationMessage For="@(() => UserRegistrationAdditionalFieldsViewState.City)" />
                </div>
            }

            @if (ShowPostCode)
            {
                <div class="auth-field">
                    <label class="auth-field__label" for="raf-postcode">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_USER_POST_CODE))
                    </label>
                    <div class="auth-field__input-wrap @(HasErrors(() => UserRegistrationAdditionalFieldsViewState.PostCode) ? "auth-field__input-wrap--invalid" : "")">
                        <input id="raf-postcode"
                               type="text"
                               class="auth-field__input"
                               value="@UserRegistrationAdditionalFieldsViewState.PostCode"
                               @oninput="OnPostCodeInput"
                               autocomplete="postal-code"
                               inputmode="numeric"
                               maxlength="@PostCodeMaxLength" />
                    </div>
                    <ValidationMessage For="@(() => UserRegistrationAdditionalFieldsViewState.PostCode)" />
                </div>
            }

        </div>
        </EditForm>

        <ErrorBlock Message="@(UserRegistrationAdditionalFieldsViewState.HasError ? UserRegistrationAdditionalFieldsViewState.ErrorMessage : null)" ShowIcon="true" />

        <div class="registration-profile-actions">
            <button type="button"
                    class="auth-submit"
                    disabled="@(UserRegistrationAdditionalFieldsViewState.IsValid == false || UserRegistrationAdditionalFieldsViewState.IsLoading)"
                    @onclick="SubmitAsync">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_SIGN_UP_BUTTON))
            </button>
        </div>

    </div>

</div>
