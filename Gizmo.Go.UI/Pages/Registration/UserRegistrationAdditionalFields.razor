@attribute [Route(NavigationHelper.RegistrationAdditionalFieldsRoute)]
@layout LoginLayout

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_PAGE_TITLE))</PageTitle>

<div class="auth-form-page">

    <AuthBackHeader OnBack="NavigateBack"
                    BackText="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_BACK))"
                    AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_BACK))" />

    <div class="auth-form auth-form--profile">

        <ErrorBlock Message="@(UserRegistrationAdditionalFieldsViewState.HasError ? UserRegistrationAdditionalFieldsViewState.ErrorMessage : null)" ShowHomeLink="true" />

        <div class="auth-hero">
            <h1 class="auth-hero__title">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_ADDITIONAL_FIELDS_HEADING))
            </h1>
            <p class="auth-hero__subtitle">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_SUBTITLE))
            </p>
        </div>

        <EditForm EditContext="@UserRegistrationAdditionalFieldsViewService.EditContext">
        <div class="auth-form__fields">

            @if (ShowCountry)
            {
                <TextInputField Id="raf-country"
                                Label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_USER_COUNTRY_REGION))"
                                Value="@UserRegistrationAdditionalFieldsViewState.Country"
                                ValueChanged="@OnCountryChanged"
                                For="@(() => UserRegistrationAdditionalFieldsViewState.Country)"
                                Autocomplete="country-name"
                                MaxLength="45" />
            }

            @if (ShowAddress)
            {
                <TextInputField Id="raf-address"
                                Label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_USER_ADDRESS))"
                                Value="@UserRegistrationAdditionalFieldsViewState.Address"
                                ValueChanged="@OnAddressChanged"
                                For="@(() => UserRegistrationAdditionalFieldsViewState.Address)"
                                Autocomplete="street-address"
                                MaxLength="255" />
            }

            @if (ShowCity)
            {
                <TextInputField Id="raf-city"
                                Label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_USER_CITY))"
                                Value="@UserRegistrationAdditionalFieldsViewState.City"
                                ValueChanged="@OnCityChanged"
                                For="@(() => UserRegistrationAdditionalFieldsViewState.City)"
                                Autocomplete="address-level2"
                                MaxLength="45" />
            }

            @if (ShowPostCode)
            {
                <TextInputField Id="raf-postcode"
                                Label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_USER_POST_CODE))"
                                Value="@UserRegistrationAdditionalFieldsViewState.PostCode"
                                ValueChanged="@OnPostCodeChanged"
                                For="@(() => UserRegistrationAdditionalFieldsViewState.PostCode)"
                                Autocomplete="postal-code"
                                InputMode="numeric"
                                MaxLength="@PostCodeMaxLength" />
            }

        </div>
        </EditForm>

        <div class="auth-form__actions">
            <button type="button"
                    class="auth-submit"
                    disabled="@IsSubmitDisabled"
                    @onclick="SubmitAsync">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_SUBMIT))
            </button>
        </div>

        <p class="auth-form__note">
            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_NOTE))
        </p>

    </div>

</div>
