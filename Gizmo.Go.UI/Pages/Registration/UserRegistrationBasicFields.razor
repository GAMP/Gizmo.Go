@attribute [Route(NavigationHelper.RegistrationBasicFieldsRoute)]
@layout LoginLayout

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_PASSWORD_PAGE_TITLE))</PageTitle>

<div class="page-create-password">

    <AuthBackHeader OnBack="NavigateBack"
                    BackText="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_PASSWORD_BACK))"
                    AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_PASSWORD_BACK))" />

    <div class="create-password-body">

        <div class="auth-hero">
            <h1 class="auth-hero__title">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_PASSWORD_HEADING))
            </h1>
            <p class="auth-hero__subtitle">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_PASSWORD_SUBTITLE))
            </p>
        </div>

        <div class="auth-stepper" role="list" aria-label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_STEPPER_ARIA))">
            <div class="auth-stepper__step auth-stepper__step--active" role="listitem" aria-current="step">
                <span class="auth-stepper__badge" aria-hidden="true">1</span>
                <span class="auth-stepper__label">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_STEPPER_ACCOUNT))
                </span>
            </div>
            <span class="auth-stepper__line" aria-hidden="true"></span>
            <div class="auth-stepper__step" role="listitem">
                <span class="auth-stepper__badge" aria-hidden="true">2</span>
                <span class="auth-stepper__label">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_STEPPER_PROFILE))
                </span>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(UserRegistrationBasicFieldsViewState.VerifiedContact))
        {
            <div class="create-password-phone">
                <span class="create-password-phone__icon" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M3 9L6.5 12.5L13 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </span>
                <div class="create-password-phone__text">
                    <span class="create-password-phone__label">
                        @LocalizationService.GetString(UserRegistrationBasicFieldsViewState.IsEmailVerified
                            ? nameof(Autogenerated.Resources.GO_CREATE_PASSWORD_EMAIL_VERIFIED_LABEL)
                            : nameof(Autogenerated.Resources.GO_CREATE_PASSWORD_PHONE_VERIFIED_LABEL))
                    </span>
                    <span class="create-password-phone__number">@UserRegistrationBasicFieldsViewState.VerifiedContact</span>
                </div>
            </div>
        }

        <EditForm EditContext="@UserRegistrationBasicFieldsViewService.EditContext">

            <div class="create-password-fields">

                <div class="auth-field">
                    <label class="auth-field__label" for="cp-password">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_PASSWORD_PASSWORD_LABEL))
                    </label>
                    <div class="auth-field__input-wrap @(HasErrors(() => UserRegistrationBasicFieldsViewState.Password) ? "auth-field__input-wrap--invalid" : "")">
                        <input id="cp-password"
                               type="@(_showPassword ? "text" : "password")"
                               class="auth-field__input"
                               value="@UserRegistrationBasicFieldsViewState.Password"
                               @oninput="OnPasswordInput"
                               autocomplete="new-password"
                               placeholder="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_PASSWORD_PASSWORD_PLACEHOLDER))" />
                        <EyeToggleButton Visible="_showPassword" OnToggle="ToggleShowPassword" />
                    </div>
                    <ValidationMessage For="@(() => UserRegistrationBasicFieldsViewState.Password)" />
                </div>

                <div class="auth-field">
                    <label class="auth-field__label" for="cp-confirm">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_PASSWORD_CONFIRM_LABEL))
                    </label>
                    <div class="auth-field__input-wrap @(HasErrors(() => UserRegistrationBasicFieldsViewState.RepeatPassword) ? "auth-field__input-wrap--invalid" : "")">
                        <input id="cp-confirm"
                               type="@(_showConfirm ? "text" : "password")"
                               class="auth-field__input"
                               value="@UserRegistrationBasicFieldsViewState.RepeatPassword"
                               @oninput="OnRepeatPasswordInput"
                               autocomplete="new-password"
                               placeholder="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_PASSWORD_CONFIRM_PLACEHOLDER))" />
                        <EyeToggleButton Visible="_showConfirm" OnToggle="ToggleShowConfirm" />
                    </div>
                    <ValidationMessage For="@(() => UserRegistrationBasicFieldsViewState.RepeatPassword)" />
                </div>

            </div>

        </EditForm>

        <div class="create-password-requirements">
            <p class="create-password-requirements__title">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_PASSWORD_REQUIREMENTS_TITLE))
            </p>
            <ul class="create-password-requirements__list" aria-label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_PASSWORD_REQUIREMENTS_ARIA))">
                @if (Tooltip.MinimumLengthRule > 0 && Tooltip.MaximumLengthRule > 0)
                {
                    <li class="create-password-req @(Tooltip.LengthRulePassed ? "create-password-req--met" : "")">
                        <span class="create-password-req__dot" aria-hidden="true"></span>
                        <span>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RULE_RANGE_LENGTH), Tooltip.MinimumLengthRule, Tooltip.MaximumLengthRule)</span>
                    </li>
                }
                else if (Tooltip.MinimumLengthRule > 0)
                {
                    <li class="create-password-req @(Tooltip.LengthRulePassed ? "create-password-req--met" : "")">
                        <span class="create-password-req__dot" aria-hidden="true"></span>
                        <span>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RULE_MIN_LENGTH), Tooltip.MinimumLengthRule)</span>
                    </li>
                }
                else if (Tooltip.MaximumLengthRule > 0)
                {
                    <li class="create-password-req @(Tooltip.LengthRulePassed ? "create-password-req--met" : "")">
                        <span class="create-password-req__dot" aria-hidden="true"></span>
                        <span>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RULE_MAX_LENGTH), Tooltip.MaximumLengthRule)</span>
                    </li>
                }
                @if (Tooltip.HasLowerCaseCharactersRule)
                {
                    <li class="create-password-req @(Tooltip.LowerCaseCharactersRulePassed ? "create-password-req--met" : "")">
                        <span class="create-password-req__dot" aria-hidden="true"></span>
                        <span>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RULE_LOWER_CASE))</span>
                    </li>
                }
                @if (Tooltip.HasUpperCaseCharactersRule)
                {
                    <li class="create-password-req @(Tooltip.UpperCaseCharactersRulePassed ? "create-password-req--met" : "")">
                        <span class="create-password-req__dot" aria-hidden="true"></span>
                        <span>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RULE_UPPER_CASE))</span>
                    </li>
                }
                @if (Tooltip.HasNumbersRule)
                {
                    <li class="create-password-req @(Tooltip.NumbersRulePassed ? "create-password-req--met" : "")">
                        <span class="create-password-req__dot" aria-hidden="true"></span>
                        <span>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RULE_NUMBER))</span>
                    </li>
                }
            </ul>
        </div>

        <button type="button"
                class="auth-submit"
                disabled="@(string.IsNullOrEmpty(UserRegistrationBasicFieldsViewState.Password) || string.IsNullOrEmpty(UserRegistrationBasicFieldsViewState.RepeatPassword))"
                @onclick="ContinueAsync">
            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_PASSWORD_SUBMIT))
        </button>

    </div>

</div>
