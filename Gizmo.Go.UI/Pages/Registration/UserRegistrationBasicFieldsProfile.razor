@using Gizmo.Go.Core.Models.Registration
@attribute [Route(NavigationHelper.RegistrationBasicFieldsProfileRoute)]
@layout LoginLayout

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_PAGE_TITLE))</PageTitle>

<div class="page-create-password page-registration-account page-registration-profile">

    <AuthBackHeader OnBack="NavigateBack"
                    BackText="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_BACK))"
                    AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_BACK))" />

    <div class="create-password-body">

        <ErrorBlock Message="@(UserRegistrationBasicFieldsViewState.HasError ? UserRegistrationBasicFieldsViewState.ErrorMessage : null)" ShowHomeLink="true" />

        <div class="auth-hero">
            <h1 class="auth-hero__title">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_HEADING))
            </h1>
            <p class="auth-hero__subtitle">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_SUBTITLE))
            </p>
        </div>

        <EditForm EditContext="@UserRegistrationBasicFieldsViewService.EditContext">
        <div class="create-password-fields">

            @if (UserRegistrationBasicFieldsViewState.ShowFirstName)
            {
                <div class="auth-field">
                    <label class="auth-field__label" for="rp-firstname">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_FIRST_NAME_LABEL))
                    </label>
                    <div class="auth-field__input-wrap @(HasErrors(() => UserRegistrationBasicFieldsViewState.FirstName) ? "auth-field__input-wrap--invalid" : "")">
                        <input id="rp-firstname"
                               type="text"
                               class="auth-field__input"
                               value="@UserRegistrationBasicFieldsViewState.FirstName"
                               @oninput="OnFirstNameInput"
                               autocomplete="given-name"
                               maxlength="45"
                               placeholder="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_FIRST_NAME_PLACEHOLDER))" />
                    </div>
                    <ValidationMessage For="@(() => UserRegistrationBasicFieldsViewState.FirstName)" />
                </div>
            }

            @if (UserRegistrationBasicFieldsViewState.ShowLastName)
            {
                <div class="auth-field">
                    <label class="auth-field__label" for="rp-lastname">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_LAST_NAME_LABEL))
                    </label>
                    <div class="auth-field__input-wrap @(HasErrors(() => UserRegistrationBasicFieldsViewState.LastName) ? "auth-field__input-wrap--invalid" : "")">
                        <input id="rp-lastname"
                               type="text"
                               class="auth-field__input"
                               value="@UserRegistrationBasicFieldsViewState.LastName"
                               @oninput="OnLastNameInput"
                               autocomplete="family-name"
                               maxlength="45"
                               placeholder="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_LAST_NAME_PLACEHOLDER))" />
                    </div>
                    <ValidationMessage For="@(() => UserRegistrationBasicFieldsViewState.LastName)" />
                </div>
            }

            @if (UserRegistrationBasicFieldsViewState.ShowBirthDate)
            {
                <div class="auth-field">
                    <label class="auth-field__label" for="rp-birthdate">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_BIRTH_DATE_LABEL))
                    </label>
                    <DateInputField Value="@UserRegistrationBasicFieldsViewState.BirthDate"
                                    ValueChanged="@OnBirthDateChanged"
                                    ErrorMessage="@GetFirstError(() => UserRegistrationBasicFieldsViewState.BirthDate)"
                                    Disabled="@UserRegistrationBasicFieldsViewState.IsLoading"
                                    Id="rp-birthdate" />
                </div>
            }

            @if (UserRegistrationBasicFieldsViewState.ShowSex)
            {
                <div class="auth-field">
                    <label class="auth-field__label" for="rp-sex">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_USER_GENDER))
                    </label>
                    <div class="auth-field__input-wrap auth-field__input-wrap--select @(HasErrors(() => UserRegistrationBasicFieldsViewState.Sex) ? "auth-field__input-wrap--invalid" : "")">
                        <select id="rp-sex"
                                class="auth-field__input"
                                value="@UserRegistrationBasicFieldsViewState.Sex"
                                @onchange="OnSexChanged">
                            <option value="@UserSex.Unspecified">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_SEX_UNSPECIFIED))</option>
                            <option value="@UserSex.Male">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_SEX_MALE))</option>
                            <option value="@UserSex.Female">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_SEX_FEMALE))</option>
                        </select>
                    </div>
                    <ValidationMessage For="@(() => UserRegistrationBasicFieldsViewState.Sex)" />
                </div>
            }

            @if (UserRegistrationBasicFieldsViewState.ShowMobilePhone)
            {
                <div class="auth-field">
                    <label class="auth-field__label" for="rp-mobile">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_MOBILE_PHONE))
                    </label>
                    <PhoneInputField Countries="@UserRegistrationBasicFieldsViewState.PhoneCountries"
                                     RegionCode="@UserRegistrationBasicFieldsViewState.PhoneRegionCode"
                                     RegionCodeChanged="@OnPhoneRegionCodeChanged"
                                     Value="@(UserRegistrationBasicFieldsViewState.MobilePhone ?? string.Empty)"
                                     ValueChanged="@OnMobilePhoneChanged"
                                     IsInvalid="@HasErrors(() => UserRegistrationBasicFieldsViewState.MobilePhone)"
                                     Id="rp-mobile" />
                    <ValidationMessage For="@(() => UserRegistrationBasicFieldsViewState.MobilePhone)" />
                </div>
            }

            @if (UserRegistrationBasicFieldsViewState.ShowEmail)
            {
                <div class="auth-field">
                    <label class="auth-field__label" for="rp-email">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_EMAIL_ADDRESS))
                    </label>
                    <div class="auth-field__input-wrap @(HasErrors(() => UserRegistrationBasicFieldsViewState.Email) ? "auth-field__input-wrap--invalid" : "")">
                        <input id="rp-email"
                               type="email"
                               class="auth-field__input"
                               value="@UserRegistrationBasicFieldsViewState.Email"
                               @oninput="OnEmailInput"
                               autocomplete="email"
                               inputmode="email"
                               maxlength="254"
                               placeholder="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_EMAIL_PLACEHOLDER))" />
                    </div>
                    <ValidationMessage For="@(() => UserRegistrationBasicFieldsViewState.Email)" />
                </div>
            }

            @if (UserRegistrationBasicFieldsViewState.ShowPhone)
            {
                <div class="auth-field">
                    <label class="auth-field__label" for="rp-phone">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_ADDITIONAL_PHONE))
                    </label>
                    <div class="auth-field__input-wrap @(HasErrors(() => UserRegistrationBasicFieldsViewState.Phone) ? "auth-field__input-wrap--invalid" : "")">
                        <input id="rp-phone"
                               type="tel"
                               class="auth-field__input"
                               value="@UserRegistrationBasicFieldsViewState.Phone"
                               @oninput="OnPhoneInput"
                               autocomplete="tel"
                               inputmode="tel"
                               maxlength="20" />
                    </div>
                    <ValidationMessage For="@(() => UserRegistrationBasicFieldsViewState.Phone)" />
                </div>
            }

        </div>

        </EditForm>

        <div class="registration-profile-actions">
            <button type="button"
                    class="auth-submit"
                    disabled="@IsSubmitDisabled"
                    @onclick="SubmitAsync">
                @LocalizationService.GetString(UserRegistrationBasicFieldsViewState.HasAdditionalFields
                    ? nameof(Autogenerated.Resources.GO_GEN_CONTINUE)
                    : nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_SUBMIT))
            </button>
        </div>

        <p class="registration-profile-note">
            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_NOTE))
        </p>

    </div>

</div>
