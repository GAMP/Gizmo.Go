@page "/registration-email-confirmation"
@layout LoginLayout

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_EMAIL_CONFIRMATION_PAGE_TITLE))</PageTitle>

<div class="page-create-account">

    <AuthBackHeader OnBack="NavigateBack"
                    BackText="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_BACK))"
                    AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_BACK))" />

    <div class="registration-email-confirmation-body">

        <div class="auth-hero">
            <h1 class="auth-hero__title">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_EMAIL_CONFIRMATION_HEADING))
            </h1>
            <p class="auth-hero__subtitle">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_EMAIL_CONFIRMATION_SUBTITLE_PREFIX))<span class="registration-email-confirmation-email">@RegistrationEmailConfirmationViewState.Email</span>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_EMAIL_CONFIRMATION_SUBTITLE_SUFFIX))
            </p>
        </div>

        <OtpDigitGroup Digits="@RegistrationEmailConfirmationViewState.Digits"
                       OnDigitChanged="@(async args => await RegistrationEmailConfirmationViewService.SetDigitAsync(args.Index, args.Value))"
                       OnDigitCleared="@(async idx => await RegistrationEmailConfirmationViewService.ClearDigitAsync(idx))"
                       AriaGroupLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_OTP_GROUP_ARIA))"
                       AriaLabelForIndex="@(i => LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_OTP_DIGIT_ARIA), i))" />

        <ErrorBlock Message="@RegistrationEmailConfirmationViewState.ErrorMessage" />

        <div class="confirmation-resend-row">
            @if (!RegistrationEmailConfirmationViewState.TimerExpired)
            {
                <p class="confirmation-timer">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_TIMER_PREFIX))<CountdownDisplay Seconds="@RegistrationEmailConfirmationViewState.SecondsLeft" />
                </p>
            }
            else
            {
                <button type="button" class="confirmation-resend-btn" @onclick="RestartTimer">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_RESEND))
                </button>
            }
            <button type="button" class="confirmation-change-number-btn" @onclick="NavigateBack">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_EMAIL_CONFIRMATION_CHANGE_EMAIL))
            </button>
        </div>

        <button type="button"
                class="auth-submit"
                disabled="@(!RegistrationEmailConfirmationViewState.CanSubmit || RegistrationEmailConfirmationViewState.IsSubmitting)"
                @onclick="ConfirmAsync">
            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_SUBMIT))
        </button>

        <p class="confirmation-hint">
            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_EMAIL_CONFIRMATION_HINT))
        </p>

    </div>

</div>
