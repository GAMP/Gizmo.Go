@attribute [Route(NavigationHelper.RegistrationErrorRoute)]
@layout LoginLayout

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_ERROR_TITLE))</PageTitle>

<div class="page-create-account">

    <AuthBackHeader OnBack="GoBack"
                    BackText="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_ERROR_BACK))"
                    AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_ERROR_BACK))" />

    <div class="auth-body">

        <div class="auth-card">

            <div class="auth-card__header">
                <div class="auth-card__logo" aria-hidden="true"></div>
                <div class="auth-card__titles">
                    <h1 class="auth-card__title">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_ERROR_TITLE))
                    </h1>
                    <p class="auth-card__subtitle">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_ERROR_SUBTITLE))
                    </p>
                </div>
            </div>

            <ErrorBlock Message="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_ERROR_ALERT))" ShowIcon="true" />

            <button type="button" class="auth-submit" @onclick="GoBack">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_ERROR_BACK))
            </button>

            <button type="button" class="auth-btn-secondary" @onclick="TryAgain">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_ERROR_RETRY))
            </button>

        </div>

        <div class="auth-footer">
            <span class="auth-footer__text">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_HAS_ACCOUNT))
            </span>
            <button type="button" class="auth-footer__link" @onclick="NavigateToLogin">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_SIGN_IN))
            </button>
        </div>

    </div>

</div>
