@attribute [Route(NavigationHelper.RegistrationErrorRoute)]
@layout LoginLayout

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_ERROR_TITLE))</PageTitle>

<div class="page-create-account">

    <AuthBackHeader OnBack="GoBack"
                    BackText="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_BACK))"
                    AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_ERROR_BACK))" />

    <div class="registration-error-body">

        <div class="registration-error-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 4L16 16M16 4L4 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
        </div>

        <div class="registration-error-content">
            <h1 class="registration-error-title">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_ERROR_TITLE))
            </h1>
            <p class="registration-error-subtitle">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_ERROR_SUBTITLE))
            </p>
        </div>

        <ErrorBlock Message="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_ERROR_ALERT))" />

        <div class="registration-error-actions">
            <button type="button" class="auth-submit" @onclick="GoBack">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_ERROR_BACK))
            </button>

            <button type="button" class="auth-text-btn" @onclick="TryAgain">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_ERROR_RETRY))
            </button>
        </div>

    </div>

</div>
