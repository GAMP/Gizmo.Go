@page "/registration-phone"
@layout LoginLayout

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_PAGE_TITLE))</PageTitle>

<div class="page-create-account">

    <header class="auth-header">
        <LangButton />
    </header>

    <div class="auth-body">

        <div class="auth-card">

            <div class="auth-card__header">
                <div class="auth-card__logo" aria-hidden="true"></div>
                <div class="auth-card__titles">
                    <h1 class="auth-card__title">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_HEADING))
                    </h1>
                    <p class="auth-card__subtitle">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_SUBTITLE))
                    </p>
                </div>
            </div>

            <EditForm EditContext="@RegistrationPhoneViewService.EditContext">

                <div class="create-account-fields">

                    <div class="auth-field">
                        <label class="auth-field__label" for="phone">
                            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_PHONE_LABEL))
                        </label>
                        <PhoneInputField Value="@RegistrationPhoneViewState.PhoneInput"
                                         ValueChanged="@(async v => await RegistrationPhoneViewService.UpdatePhoneAsync(v, RegistrationPhoneViewState.SelectedCountryIso2))"
                                         CountryIso2="@RegistrationPhoneViewState.SelectedCountryIso2"
                                         CountryIso2Changed="@(async iso => await RegistrationPhoneViewService.UpdatePhoneAsync("", iso))"
                                         Placeholder="@RegistrationPhoneViewState.SelectedCountryPlaceholder"
                                         CountryPlaceholder="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_COUNTRY_PLACEHOLDER))"
                                         DialCode="@RegistrationPhoneViewState.SelectedDialCode"
                                         MaxLength="@RegistrationPhoneViewState.PhoneLength"
                                         IsInvalid="@HasErrors(() => RegistrationPhoneViewState.PhoneInput)"
                                         Id="phone" />
                        <ValidationMessage For="@(() => RegistrationPhoneViewState.PhoneInput)" />
                    </div>

                </div>

                <div class="create-account-terms"
                     role="checkbox"
                     aria-checked="@RegistrationPhoneViewState.TermsAccepted"
                     tabindex="0"
                     @onclick="ToggleTerms"
                     @onkeydown="OnTermsKeyDown">
                    <div class="create-account-terms__checkbox @(RegistrationPhoneViewState.TermsAccepted ? "create-account-terms__checkbox--checked" : "")" aria-hidden="true">
                        @if (RegistrationPhoneViewState.TermsAccepted)
                        {
                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        }
                    </div>
                    <span class="create-account-terms__text">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_TERMS_PREFIX))
                        <button type="button"
                                class="create-account-terms__link"
                                @onclick:stopPropagation="true">
                            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_TERMS_LINK1))
                        </button>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_TERMS_AND))
                        <button type="button"
                                class="create-account-terms__link"
                                @onclick:stopPropagation="true">
                            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_TERMS_LINK2))
                        </button>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_TERMS_SUFFIX))
                    </span>
                </div>

                <ValidationMessage For="@(() => RegistrationPhoneViewState.TermsAccepted)" />

                <button type="button"
                        class="auth-submit create-account-submit"
                        disabled="@(!RegistrationPhoneViewState.TermsAccepted || string.IsNullOrEmpty(RegistrationPhoneViewState.PhoneE164))"
                        @onclick="SubmitAsync">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_SUBMIT))
                </button>

            </EditForm>

        </div>

        <div class="auth-footer">
            <span class="auth-footer__text">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_HAS_ACCOUNT))
            </span>
            <button type="button" class="auth-footer__link" @onclick="NavigateToLogin">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_SIGN_IN))
            </button>
        </div>

    </div>

</div>
