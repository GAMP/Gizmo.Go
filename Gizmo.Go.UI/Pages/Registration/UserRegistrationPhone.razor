@attribute [Route(NavigationHelper.RegistrationPhoneRoute)]
@layout LoginLayout

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_PAGE_TITLE))</PageTitle>

<div class="page-create-account">

    <AuthBackHeader OnBack="NavigateBack"
                    BackText="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_BACK))"
                    AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_BACK))" />

    <div class="auth-body">

        <div class="auth-card">

            <div class="auth-card__header">
                <div class="auth-card__logo" aria-hidden="true"></div>
                <div class="auth-card__titles">
                    <h1 class="auth-card__title">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_HEADING))
                    </h1>
                    <p class="auth-card__subtitle">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_SUBTITLE))
                    </p>
                </div>
            </div>

            <ErrorBlock Message="@(UserRegistrationPhoneViewState.HasError ? UserRegistrationPhoneViewState.ErrorMessage : null)" ShowIcon="true" />

            <EditForm EditContext="@UserRegistrationPhoneViewService.EditContext">

                <div class="create-account-fields">

                    <div class="auth-field">
                        <label class="auth-field__label" for="phone">
                            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_PHONE_LABEL))
                        </label>
                        <PhoneInputField Countries="@UserRegistrationPhoneViewState.Countries"
                                         RegionCode="@UserRegistrationPhoneViewState.RegionCode"
                                         RegionCodeChanged="@OnRegionCodeChanged"
                                         Value="@(UserRegistrationPhoneViewState.MobilePhone ?? string.Empty)"
                                         ValueChanged="@OnPhoneValueChanged"
                                         CountryPlaceholder="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_COUNTRY_PLACEHOLDER))"
                                         Disabled="@UserRegistrationPhoneViewState.IsLoading"
                                         IsInvalid="@HasErrors(() => UserRegistrationPhoneViewState.MobilePhone)"
                                         Id="phone" />
                        <ValidationMessage For="@(() => UserRegistrationPhoneViewState.MobilePhone)" />
                    </div>

                </div>

                <button type="button"
                        class="auth-submit create-account-submit"
                        disabled="@(UserRegistrationPhoneViewState.IsValid != true || UserRegistrationPhoneViewState.IsLoading)"
                        @onclick="SubmitAsync">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_SUBMIT))
                </button>

            </EditForm>

        </div>

        <div class="auth-footer">
            <span class="auth-footer__text">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_HAS_ACCOUNT))
            </span>
            <button type="button" class="auth-footer__link" @onclick="NavigateToLogin">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_SIGN_IN))
            </button>
        </div>

    </div>

</div>
