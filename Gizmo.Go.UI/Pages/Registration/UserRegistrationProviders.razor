@attribute [Route(NavigationHelper.RegistrationProvidersRoute)]
@layout LoginLayout

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_PAGE_TITLE))</PageTitle>

<div class="page-create-account page-registration-providers">

    <div class="auth-body">

        <div class="auth-card auth-card--plain">

            <ErrorBlock Message="@UserRegistrationProvidersViewState.ErrorMessage" />

            <div class="auth-card__header">
                <AuthCardLogo />
                <div class="auth-card__titles">
                    <h1 class="auth-card__title">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_HEADING))
                    </h1>
                    <p class="auth-card__subtitle">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_SUBTITLE))
                    </p>
                </div>
            </div>

            @if (UserRegistrationProvidersViewState.IsLoading)
            {
                <p class="auth-card__subtitle">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_LOADING))
                </p>
            }
            else if (UserRegistrationProvidersViewState.Providers.Count == 0)
            {
                <p class="auth-card__subtitle">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_EMPTY))
                </p>
            }
            else
            {
                <ul class="registration-providers-list" role="list">
                    @foreach (var provider in UserRegistrationProvidersViewState.PriorityProviders)
                    {
                        <li @key="provider.MethodId">
                            <ProviderButton IsPrimary="true"
                                            ChannelGuid="@provider.ChannelGuid"
                                            Text="@(LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_CONTINUE_WITH)) + provider.Name)"
                                            OnClick="() => SelectProviders(provider.MethodId)" />
                        </li>
                    }
                </ul>

                @if (UserRegistrationProvidersViewState.AltProviders.Count > 0
                    && (UserRegistrationProvidersViewState.HasError || UserRegistrationProvidersViewState.PriorityProviders.Count == 0 || UserRegistrationProvidersViewState.ShowAllProviders))
                {
                    <div class="registration-providers-alt">

                        @if (UserRegistrationProvidersViewState.PriorityProviders.Count > 0)
                        {
                            <div class="registration-providers-divider" aria-hidden="true">
                                <span class="registration-providers-divider__line"></span>
                                <span class="registration-providers-divider__badge">
                                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_ALT_DIVIDER))
                                </span>
                                <span class="registration-providers-divider__line"></span>
                            </div>

                            <p class="registration-providers-alt__description">
                                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_ALT_DESCRIPTION))
                            </p>
                        }

                        <ul class="registration-providers-alt__list" role="list">
                            @foreach (var provider in UserRegistrationProvidersViewState.AltProviders)
                            {
                                <li @key="provider.MethodId">
                                    <ProviderButton ChannelGuid="@provider.ChannelGuid"
                                                    Text="@provider.Name"
                                                    OnClick="() => SelectProviders(provider.MethodId)" />
                                </li>
                            }
                        </ul>

                    </div>
                }
            }

            @if (UserRegistrationProvidersViewState.Agreements.Count > 0)
            {
                <p class="registration-providers-terms">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROVIDERS_TERMS_PREFIX))@for (var i = 0; i < UserRegistrationProvidersViewState.Agreements.Count; i++){var agreement = UserRegistrationProvidersViewState.Agreements[i];@GetAgreementSeparator(i)<button type="button" class="create-account-terms__link" @onclick="() => ShowAgreement(agreement)">@agreement.Name</button>}.
                </p>
            }

        </div>

        <div class="auth-footer">
            <span class="auth-footer__text">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_HAS_ACCOUNT))
            </span>
            <button type="button" class="auth-footer__link" @onclick="NavigateToLogin">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_SIGN_IN))
            </button>
        </div>

    </div>

</div>
