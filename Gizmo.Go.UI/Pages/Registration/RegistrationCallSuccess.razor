@page "/registration-call-success"
@layout LoginLayout

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_SUCCESS_PAGE_TITLE))</PageTitle>

<div class="page-registration-call-success">

    <header class="auth-header">
        <LangButton />
    </header>

    <div class="call-success-body">

        <div class="call-success-content">

            <div class="call-success-icon-wrapper" aria-hidden="true">
                <div class="call-success-ring-outer"></div>
                <div class="call-success-icon-circle">
                    <svg viewBox="0 0 24 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M1 7.5L8.5 15L23 1" stroke="#57bcff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
            </div>

            <div class="call-success-hero">
                <h1 class="call-success-title">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_SUCCESS_HEADING))
                </h1>
                <p class="call-success-subtitle">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_SUCCESS_SUBTITLE_PREFIX))<span class="call-success-subtitle__phone">@RegistrationCallSuccessViewState.ServerPhoneNumber</span>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_SUCCESS_SUBTITLE_SUFFIX))
                </p>
            </div>

            <div class="call-success-card" role="status">
                <span class="call-success-card__icon" aria-hidden="true">
                    <svg width="12" height="10" viewBox="0 0 12 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M1 5L4.5 8.5L11 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </span>
                <div class="call-success-card__texts">
                    <p class="call-success-card__primary">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_SUCCESS_VERIFIED))
                    </p>
                    <p class="call-success-card__secondary">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_SUCCESS_CALL_RECEIVED))
                    </p>
                </div>
            </div>

        </div>

    </div>

</div>
