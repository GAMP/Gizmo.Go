@page "/registration-call-verify"
@layout LoginLayout

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_VERIFY_PAGE_TITLE))</PageTitle>

<div class="page-registration-call-verify">

    <AuthBackHeader OnBack="CancelAsync"
                    BackText="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_VERIFY_BACK))"
                    AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_VERIFY_BACK))" />

    <div class="call-verify-body">

        <div class="call-verify-content">

            <div class="auth-hero">
                <h1 class="auth-hero__title">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_VERIFY_HEADING))
                </h1>
            </div>

            <div class="auth-stepper" aria-label="Шаги регистрации">
                <div class="auth-stepper__step auth-stepper__step--completed">
                    <div class="auth-stepper__badge" aria-hidden="true">
                        <svg width="10" height="8" viewBox="0 0 10 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M1 3.5L3.5 6L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </div>
                    <span class="auth-stepper__label">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_PHONE_STEP1))
                    </span>
                </div>
                <div class="auth-stepper__line" aria-hidden="true"></div>
                <div class="auth-stepper__step auth-stepper__step--active">
                    <div class="auth-stepper__badge" aria-hidden="true">2</div>
                    <span class="auth-stepper__label">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_PHONE_STEP2))
                    </span>
                </div>
                <div class="auth-stepper__line" aria-hidden="true"></div>
                <div class="auth-stepper__step">
                    <div class="auth-stepper__badge" aria-hidden="true">3</div>
                    <span class="auth-stepper__label">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_PHONE_STEP3))
                    </span>
                </div>
            </div>

            <div class="call-verify-ring-wrapper" aria-hidden="true">
                <div class="call-verify-pulsing-ring">
                    <div class="call-verify-ring call-verify-ring--1"></div>
                    <div class="call-verify-ring call-verify-ring--2"></div>
                    <div class="call-verify-ring-inner">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M6.54 5c.06.89.21 1.76.45 2.59l-1.2 1.2c-.41-1.2-.67-2.47-.76-3.79h1.51m9.86 12.02c.85.24 1.72.39 2.6.45v1.49c-1.32-.09-2.59-.35-3.8-.75l1.2-1.19M7.5 3H4c-.55 0-1 .45-1 1 0 9.39 7.61 17 17 17 .55 0 1-.45 1-1v-3.49c0-.55-.45-1-1-1-1.24 0-2.45-.2-3.57-.57a.84.84 0 0 0-.31-.05c-.26 0-.51.1-.71.29l-2.2 2.2a15.149 15.149 0 0 1-6.59-6.59l2.2-2.2c.28-.28.38-.67.29-1.03A11.36 11.36 0 0 1 8.5 4c0-.55-.45-1-1-1z" fill="currentColor" />
                        </svg>
                    </div>
                </div>
            </div>

            <div class="call-verify-instruction">
                <p class="call-verify-instruction__text">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_VERIFY_INSTRUCTION))
                </p>
                <div class="call-verify-user-phone">
                    <span class="call-verify-user-phone__icon" aria-hidden="true">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M2.625 2.188H4.52l.875 2.187-1.093.875a7.875 7.875 0 0 0 3.937 3.938l.875-1.094 2.187.875v1.896A8.75 8.75 0 0 1 2.625 2.187z" fill="currentColor" />
                        </svg>
                    </span>
                    <span class="call-verify-user-phone__number">
                        @RegistrationCallPhoneViewState.SelectedDialCode @RegistrationCallPhoneViewState.PhoneInput
                    </span>
                    <button type="button" class="call-verify-user-phone__change" @onclick="CancelAsync">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_VERIFY_CHANGE))
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(RegistrationCallVerifyViewState.ServerPhoneNumber))
            {
                <div class="call-verify-number">
                    <button type="button"
                            class="call-verify-number__btn"
                            @onclick="CopyToClipboardAsync"
                            aria-label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_VERIFY_COPY_HINT))">
                        <span class="call-verify-number__text">
                            @RegistrationCallVerifyViewState.ServerPhoneNumber
                        </span>
                        <span class="call-verify-number__copy-icon" aria-hidden="true">
                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <rect x="7.5" y="7.5" width="10.833" height="10.833" rx="2" stroke="currentColor" stroke-width="1.5" />
                                <path d="M4.167 12.5H3.333A1.667 1.667 0 0 1 1.667 10.833V3.333A1.667 1.667 0 0 1 3.333 1.667h7.5A1.667 1.667 0 0 1 12.5 3.333v.834" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                            </svg>
                        </span>
                    </button>
                    <p class="call-verify-number__hint">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_VERIFY_COPY_HINT))
                    </p>
                </div>
            }

            <InfoBlock Message="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_VERIFY_INFO))" ShowIcon="true" />

            <div class="call-verify-timer">
                <div class="call-verify-timer__track" role="progressbar"
                     aria-valuenow="@RegistrationCallVerifyViewState.SecondsLeft"
                     aria-valuemin="0"
                     aria-valuemax="120">
                    <div class="call-verify-timer__fill"
                         style="width: @((RegistrationCallVerifyViewState.TimerProgress * 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%">
                    </div>
                </div>
                <p class="call-verify-timer__label">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_VERIFY_TIMER_PREFIX))<CountdownDisplay Seconds="@RegistrationCallVerifyViewState.SecondsLeft" />
                </p>
            </div>

            <button type="button" class="call-verify-cancel" @onclick="CancelAsync">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_VERIFY_CANCEL))
            </button>

        </div>

    </div>

</div>
