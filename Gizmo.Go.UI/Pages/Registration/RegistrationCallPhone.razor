@page "/registration-call-phone"
@layout LoginLayout

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_PHONE_PAGE_TITLE))</PageTitle>

<div class="page-registration-call-phone">

    <AuthBackHeader OnBack="NavigateBack"
                    BackText="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_PHONE_BACK))"
                    AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_PHONE_BACK))" />

    <div class="call-phone-body">

        <div class="call-phone-content">

            <div class="auth-hero">
                <h1 class="auth-hero__title">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_PHONE_HEADING))
                </h1>
                <p class="auth-hero__subtitle">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_PHONE_SUBTITLE))
                </p>
            </div>

            <div class="auth-stepper" aria-label="Шаги регистрации">
                <div class="auth-stepper__step auth-stepper__step--active">
                    <div class="auth-stepper__badge" aria-hidden="true">1</div>
                    <span class="auth-stepper__label">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_PHONE_STEP1))
                    </span>
                </div>
                <div class="auth-stepper__line" aria-hidden="true"></div>
                <div class="auth-stepper__step">
                    <div class="auth-stepper__badge" aria-hidden="true">2</div>
                    <span class="auth-stepper__label">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_PHONE_STEP2))
                    </span>
                </div>
                <div class="auth-stepper__line" aria-hidden="true"></div>
                <div class="auth-stepper__step">
                    <div class="auth-stepper__badge" aria-hidden="true">3</div>
                    <span class="auth-stepper__label">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_PHONE_STEP3))
                    </span>
                </div>
            </div>

            <div class="call-phone-phone-step">

                <div class="auth-field">
                    <label class="auth-field__label" for="call-phone-input">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_PHONE_LABEL))
                    </label>
                    <PhoneInputField Value="@RegistrationCallPhoneViewState.PhoneInput"
                                     ValueChanged="@(async v => await RegistrationCallPhoneViewService.UpdatePhoneAsync(v, RegistrationCallPhoneViewState.SelectedCountryIso2))"
                                     CountryIso2="@RegistrationCallPhoneViewState.SelectedCountryIso2"
                                     CountryIso2Changed="@(async iso => await RegistrationCallPhoneViewService.UpdatePhoneAsync("", iso))"
                                     Placeholder="@RegistrationCallPhoneViewState.SelectedCountryPlaceholder"
                                     CountryPlaceholder="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_COUNTRY_PLACEHOLDER))"
                                     DialCode="@RegistrationCallPhoneViewState.SelectedDialCode"
                                     MaxLength="@RegistrationCallPhoneViewState.PhoneLength"
                                     Id="call-phone-input" />
                </div>

                <button type="button"
                        class="auth-submit call-phone-submit"
                        disabled="@(string.IsNullOrEmpty(RegistrationCallPhoneViewState.PhoneE164))"
                        @onclick="SubmitAsync">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_PHONE_SUBMIT))
                </button>

            </div>

            <InfoBlock Message="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_PHONE_HINT))" ShowIcon="true" />

        </div>

    </div>

</div>
