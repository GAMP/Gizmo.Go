@page "/registration-call-phone"
@layout LoginLayout

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_PHONE_PAGE_TITLE))</PageTitle>

<div class="page-registration-call-phone">

    <header class="auth-header call-phone-header">
        <button class="call-phone-back-btn" type="button" @onclick="NavigateBack"
                aria-label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_PHONE_BACK))">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M12.5 6.25L8.75 10l3.75 3.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_PHONE_BACK))</span>
        </button>
        <LangButton />
    </header>

    <div class="call-phone-body">

        <div class="call-phone-content">

            <div class="call-phone-hero">
                <h1 class="call-phone-title">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_PHONE_HEADING))
                </h1>
                <p class="call-phone-subtitle">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_PHONE_SUBTITLE))
                </p>
            </div>

            <div class="call-phone-steps" aria-label="Шаги регистрации">
                <div class="call-phone-step call-phone-step--active">
                    <div class="call-phone-step__dot" aria-hidden="true">1</div>
                    <span class="call-phone-step__label">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_PHONE_STEP1))
                    </span>
                </div>
                <div class="call-phone-step__line" aria-hidden="true"></div>
                <div class="call-phone-step">
                    <div class="call-phone-step__dot" aria-hidden="true">2</div>
                    <span class="call-phone-step__label">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_PHONE_STEP2))
                    </span>
                </div>
                <div class="call-phone-step__line" aria-hidden="true"></div>
                <div class="call-phone-step">
                    <div class="call-phone-step__dot" aria-hidden="true">3</div>
                    <span class="call-phone-step__label">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_PHONE_STEP3))
                    </span>
                </div>
            </div>

            <div class="call-phone-phone-step">

                <div class="auth-field">
                    <label class="auth-field__label" for="call-phone-input">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_PHONE_LABEL))
                    </label>
                    <div class="auth-field__input-wrap call-phone-input-wrap">
                        <div class="call-phone-country-btn" aria-hidden="true">
                            <span class="call-phone-country-btn__flag">@RegistrationCallPhoneViewState.SelectedCountryFlag</span>
                            <span class="call-phone-country-btn__code">@RegistrationCallPhoneViewState.SelectedDialCode</span>
                            <svg class="call-phone-country-btn__chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </div>
                        <input id="call-phone-input"
                               type="tel"
                               inputmode="numeric"
                               class="auth-field__input"
                               autocomplete="tel"
                               value="@_phoneInputValue"
                               placeholder="@RegistrationCallPhoneViewState.SelectedCountryPlaceholder"
                               maxlength="@RegistrationCallPhoneViewState.PhoneLength"
                               @oninput="OnPhoneInputAsync"
                               @onchange="OnPhoneFormattedAsync" />
                    </div>
                </div>

                <button type="button"
                        class="auth-submit call-phone-submit"
                        disabled="@(string.IsNullOrEmpty(RegistrationCallPhoneViewState.PhoneE164))"
                        @onclick="SubmitAsync">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_PHONE_SUBMIT))
                </button>

            </div>

            <div class="call-phone-info" role="note">
                <div class="call-phone-info__icon" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="8" cy="8" r="6.667" stroke="currentColor" stroke-width="1.333" />
                        <path d="M8 5.333V8" stroke="currentColor" stroke-width="1.333" stroke-linecap="round" />
                        <circle cx="8" cy="10.667" r="0.667" fill="currentColor" />
                    </svg>
                </div>
                <p class="call-phone-info__text">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_CALL_PHONE_HINT))
                </p>
            </div>

        </div>

    </div>

</div>
