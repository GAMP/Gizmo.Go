@using System.Globalization
@attribute [Route(NavigationHelper.NewsDetailsRoute)]
@attribute [Authorize]

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_NEWS_PAGE_TITLE))</PageTitle>

<div class="page-shell page-shell--news page-news">

    @if (NewsDetailsViewState.News.Value is { } item && !NewsDetailsViewState.News.HasError)
    {
        <article class="news-details">
            @if (!string.IsNullOrEmpty(item.ImageUrl))
            {
                @* the image with the back button over it, the title on its lower edge *@
                <div class="news-details__hero">
                    <img class="news-details__image" src="@item.ImageUrl" alt="" />
                    <ScreenBackHeader IsOverlay="true"
                                      AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_BACK))"
                                      OnBack="BackAsync" />
                    <h1 class="news-details__title news-details__title--hero">@item.Title</h1>
                </div>
            }
            else
            {
                <ScreenBackHeader AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_BACK))"
                                  OnBack="BackAsync" />
                <h1 class="news-details__title">@item.Title</h1>
            }

            <div class="news-details__content">
                <div class="news-details__meta">
                    @if (item.Date is { } date)
                    {
                        <span class="news-details__date">@date.ToString("d MMMM yyyy", CultureInfo.CurrentCulture)</span>
                        <span class="news-details__dot" aria-hidden="true"></span>
                    }
                    <span class="news-details__club">@(item.BranchName ?? LocalizationService.GetString(nameof(Autogenerated.Resources.GO_HOME_NEWS_ALL_CLUBS)))</span>
                </div>
                <div class="news-details__divider"></div>
                @* operator content (trusted HTML), rendered as in the client news *@
                <div class="news-details__body">@((MarkupString)item.Body)</div>
            </div>
        </article>
    }
    else
    {
        <ScreenBackHeader Title="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_NEWS_PAGE_TITLE))"
                          AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_BACK))"
                          OnBack="BackAsync" />

        <div class="page-news__content">
            @if (NewsDetailsViewState.News.HasError)
            {
                <ErrorBlock Message="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_LOAD_ERROR))"
                            OnRetry="ReloadAsync" />
            }
            else if (NewsDetailsViewState.IsNotFound)
            {
                <ErrorBlock Message="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_NEWS_NOT_FOUND))" />
            }
            else
            {
                <div class="home-skeleton page-news__skeleton"></div>
            }
        </div>
    }
</div>
