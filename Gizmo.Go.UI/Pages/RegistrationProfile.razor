@page "/registration-profile"
@layout LoginLayout

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_PAGE_TITLE))</PageTitle>

<div style="display:flex; flex-direction:column; align-items:center; padding:2rem; gap:1rem; max-width:480px; margin:auto;">

    <h1 style="margin:0;">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_HEADING))</h1>
    <p style="margin:0; color:gray;">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_SUBTITLE))</p>

    <div style="display:flex; flex-direction:column; gap:0.25rem; width:100%;">
        <label for="rp-username">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_USERNAME_LABEL))</label>
        <input id="rp-username"
               type="text"
               required
               value="@RegistrationProfileViewState.Username"
               @oninput="OnUsernameInput"
               placeholder="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_USERNAME_PLACEHOLDER))" />
    </div>

    <div style="display:flex; flex-direction:column; gap:0.25rem; width:100%;">
        <label for="rp-email">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_EMAIL_LABEL))</label>
        <input id="rp-email"
               type="email"
               value="@RegistrationProfileViewState.Email"
               @oninput="OnEmailInput"
               placeholder="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_EMAIL_PLACEHOLDER))" />
    </div>

    <div style="display:flex; flex-direction:column; gap:0.25rem; width:100%;">
        <label for="rp-firstname">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_FIRST_NAME_LABEL))</label>
        <input id="rp-firstname"
               type="text"
               value="@RegistrationProfileViewState.FirstName"
               @oninput="OnFirstNameInput"
               placeholder="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_FIRST_NAME_PLACEHOLDER))" />
    </div>

    <div style="display:flex; flex-direction:column; gap:0.25rem; width:100%;">
        <label for="rp-lastname">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_LAST_NAME_LABEL))</label>
        <input id="rp-lastname"
               type="text"
               value="@RegistrationProfileViewState.LastName"
               @oninput="OnLastNameInput"
               placeholder="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_LAST_NAME_PLACEHOLDER))" />
    </div>

    <div style="display:flex; flex-direction:column; gap:0.25rem; width:100%;">
        <label for="rp-birthdate">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_BIRTH_DATE_LABEL))</label>
        <input id="rp-birthdate"
               type="date"
               value="@(RegistrationProfileViewState.BirthDate?.ToString("yyyy-MM-dd") ?? string.Empty)"
               @oninput="OnBirthDateInput" />
    </div>

    <div style="display:flex; flex-direction:column; gap:0.25rem; width:100%;">
        <label for="rp-address">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_ADDRESS_LABEL))</label>
        <input id="rp-address"
               type="text"
               value="@RegistrationProfileViewState.Address"
               @oninput="OnAddressInput"
               placeholder="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_ADDRESS_PLACEHOLDER))" />
    </div>

    <div style="display:flex; flex-direction:column; gap:0.25rem; width:100%;">
        <label for="rp-city">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_CITY_LABEL))</label>
        <input id="rp-city"
               type="text"
               value="@RegistrationProfileViewState.City"
               @oninput="OnCityInput"
               placeholder="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_CITY_PLACEHOLDER))" />
    </div>

    <div style="display:flex; flex-direction:column; gap:0.25rem; width:100%;">
        <label for="rp-country">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_COUNTRY_LABEL))</label>
        <input id="rp-country"
               type="text"
               value="@RegistrationProfileViewState.Country"
               @oninput="OnCountryInput"
               placeholder="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_COUNTRY_PLACEHOLDER))" />
    </div>

    <div style="display:flex; flex-direction:column; gap:0.25rem; width:100%;">
        <label for="rp-postcode">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_POST_CODE_LABEL))</label>
        <input id="rp-postcode"
               type="text"
               value="@RegistrationProfileViewState.PostCode"
               @oninput="OnPostCodeInput"
               placeholder="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_POST_CODE_PLACEHOLDER))" />
    </div>

    <div style="display:flex; flex-direction:column; gap:0.25rem; width:100%;">
        <label for="rp-phone">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_PHONE_LABEL))</label>
        <input id="rp-phone"
               type="tel"
               value="@RegistrationProfileViewState.Phone"
               @oninput="OnPhoneInput"
               placeholder="+7 000-000-00-00" />
    </div>

    <div style="display:flex; flex-direction:column; gap:0.25rem; width:100%;">
        <label for="rp-mobilephone">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_MOBILE_PHONE_LABEL))</label>
        <input id="rp-mobilephone"
               type="tel"
               value="@RegistrationProfileViewState.MobilePhone"
               @oninput="OnMobilePhoneInput"
               placeholder="+7 000-000-00-00" />
    </div>

    <div style="display:flex; flex-direction:column; gap:0.25rem; width:100%;">
        <label for="rp-sex">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_SEX_LABEL))</label>
        <select id="rp-sex"
                value="@((int)RegistrationProfileViewState.Sex)"
                @onchange="OnSexChange">
            <option value="0">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_SEX_UNSPECIFIED))</option>
            <option value="1">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_SEX_MALE))</option>
            <option value="2">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_SEX_FEMALE))</option>
        </select>
    </div>

    @if (RegistrationProfileViewState.ErrorCode != null)
    {
        <p style="color:red; margin:0;">@GetErrorMessage(RegistrationProfileViewState.ErrorCode.Value)</p>
    }

    <button type="button"
            style="width:100%; padding:0.75rem; background:#5865f2; color:#fff; border:none; border-radius:6px; font-size:1rem; cursor:pointer;"
            disabled="@(RegistrationProfileViewState.IsValid != true || RegistrationProfileViewState.IsSubmitting)"
            @onclick="SubmitAsync">
        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_PROFILE_SUBMIT))
    </button>

</div>
