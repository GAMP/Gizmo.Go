@page "/registration-profile"
@layout LoginLayout

<PageTitle>Профиль - Gizmo Go</PageTitle>

<div style="display:flex; flex-direction:column; align-items:center; padding:2rem; gap:1rem; max-width:480px; margin:auto;">

    <h1 style="margin:0;">Заполните профиль</h1>
    <p style="margin:0; color:gray;">Укажите данные для вашего аккаунта.</p>

    <div style="display:flex; flex-direction:column; gap:0.25rem; width:100%;">
        <label for="rp-username">Никнейм *</label>
        <input id="rp-username"
               type="text"
               required
               value="@RegistrationProfileViewState.Username"
               @oninput="OnUsernameInput"
               placeholder="Введите никнейм" />
    </div>

    <div style="display:flex; flex-direction:column; gap:0.25rem; width:100%;">
        <label for="rp-email">Email</label>
        <input id="rp-email"
               type="email"
               value="@RegistrationProfileViewState.Email"
               @oninput="OnEmailInput"
               placeholder="Введите email" />
    </div>

    <div style="display:flex; flex-direction:column; gap:0.25rem; width:100%;">
        <label for="rp-firstname">Имя</label>
        <input id="rp-firstname"
               type="text"
               value="@RegistrationProfileViewState.FirstName"
               @oninput="OnFirstNameInput"
               placeholder="Введите имя" />
    </div>

    <div style="display:flex; flex-direction:column; gap:0.25rem; width:100%;">
        <label for="rp-lastname">Фамилия</label>
        <input id="rp-lastname"
               type="text"
               value="@RegistrationProfileViewState.LastName"
               @oninput="OnLastNameInput"
               placeholder="Введите фамилию" />
    </div>

    <div style="display:flex; flex-direction:column; gap:0.25rem; width:100%;">
        <label for="rp-birthdate">Дата рождения</label>
        <input id="rp-birthdate"
               type="date"
               value="@(RegistrationProfileViewState.BirthDate?.ToString("yyyy-MM-dd") ?? string.Empty)"
               @oninput="OnBirthDateInput" />
    </div>

    <div style="display:flex; flex-direction:column; gap:0.25rem; width:100%;">
        <label for="rp-address">Адрес</label>
        <input id="rp-address"
               type="text"
               value="@RegistrationProfileViewState.Address"
               @oninput="OnAddressInput"
               placeholder="Введите адрес" />
    </div>

    <div style="display:flex; flex-direction:column; gap:0.25rem; width:100%;">
        <label for="rp-city">Город</label>
        <input id="rp-city"
               type="text"
               value="@RegistrationProfileViewState.City"
               @oninput="OnCityInput"
               placeholder="Введите город" />
    </div>

    <div style="display:flex; flex-direction:column; gap:0.25rem; width:100%;">
        <label for="rp-country">Страна</label>
        <input id="rp-country"
               type="text"
               value="@RegistrationProfileViewState.Country"
               @oninput="OnCountryInput"
               placeholder="Введите страну" />
    </div>

    <div style="display:flex; flex-direction:column; gap:0.25rem; width:100%;">
        <label for="rp-postcode">Почтовый индекс</label>
        <input id="rp-postcode"
               type="text"
               value="@RegistrationProfileViewState.PostCode"
               @oninput="OnPostCodeInput"
               placeholder="Введите индекс" />
    </div>

    <div style="display:flex; flex-direction:column; gap:0.25rem; width:100%;">
        <label for="rp-phone">Телефон</label>
        <input id="rp-phone"
               type="tel"
               value="@RegistrationProfileViewState.Phone"
               @oninput="OnPhoneInput"
               placeholder="+7 000-000-00-00" />
    </div>

    <div style="display:flex; flex-direction:column; gap:0.25rem; width:100%;">
        <label for="rp-mobilephone">Мобильный телефон</label>
        <input id="rp-mobilephone"
               type="tel"
               value="@RegistrationProfileViewState.MobilePhone"
               @oninput="OnMobilePhoneInput"
               placeholder="+7 000-000-00-00" />
    </div>

    <div style="display:flex; flex-direction:column; gap:0.25rem; width:100%;">
        <label for="rp-sex">Пол</label>
        <select id="rp-sex"
                value="@((int)RegistrationProfileViewState.Sex)"
                @onchange="OnSexChange">
            <option value="0">Не указан</option>
            <option value="1">Мужской</option>
            <option value="2">Женский</option>
        </select>
    </div>

    @if (RegistrationProfileViewState.ErrorCode != null)
    {
        <p style="color:red; margin:0;">@GetErrorMessage(RegistrationProfileViewState.ErrorCode.Value)</p>
    }

    <button type="button"
            style="width:100%; padding:0.75rem;"
            disabled="@(!RegistrationProfileViewState.CanSubmit || RegistrationProfileViewState.IsSubmitting)"
            @onclick="SubmitAsync">
        Завершить регистрацию
    </button>

</div>
