@attribute [Route(NavigationHelper.ProfilePolicyRoute)]
@attribute [Authorize]

<PageTitle>@(Title)</PageTitle>

<div class="page-shell page-profile-policy">

    <ScreenBackHeader Title="@Title"
                      IsCentered="true"
                      AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_BACK))"
                      OnBack="BackAsync" />

    <div class="screen-content">
        @if (ProfilePolicyViewState.Agreement.HasError)
        {
            <ErrorBlock Message="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_LOAD_ERROR))"
                        OnRetry="ReloadAsync" />
        }
        else if (ProfilePolicyViewState.IsNotFound)
        {
            <ErrorBlock Message="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_DOCUMENT_NOT_FOUND))"
                        OnBack="BackAsync" />
        }
        else if (ProfilePolicyViewState.Agreement.Value is { } agreement)
        {
            <DocumentText Text="@agreement.Text" IsHtml="true" />
        }
        else
        {
            <div class="home-skeleton document-list-skeleton"></div>
        }
    </div>
</div>
