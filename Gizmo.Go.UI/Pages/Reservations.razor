@attribute [Route(NavigationHelper.ReservationsRoute)]
@attribute [Authorize]

<PageTitle>@Title</PageTitle>

<div class="page-shell page-reservations">

    <ScreenBackHeader Title="@Title"
                      AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_BACK))"
                      IsCentered="true"
                      OnBack="BackAsync" />

    <div class="page-reservations__content">

        @if (ReservationsViewState.SingleId is not null)
        {
            @* the found reservation is shown even when the other list failed or still loads *@
            if (FindSingleReservation() is { Reservation: { } reservation } single)
            {
                <div class="page-reservations__list">
                    <ReservationCard @key="reservation.Id"
                                     Reservation="reservation"
                                     IsCompleted="single.IsCompleted"
                                     IsExpanded="@ReservationsViewState.ExpandedIds.Contains(reservation.Id)"
                                     IsConfirmingCancel="@(ReservationsViewState.ConfirmingCancelId == reservation.Id)"
                                     IsCanceling="@ReservationsViewState.IsCanceling"
                                     OnToggleDetails="OnToggleDetails"
                                     OnCancel="OnCancel"
                                     OnConfirmCancel="ReservationsViewService.ConfirmCancelAsync"
                                     OnKeep="OnKeep" />
                </div>
            }
            else if (ReservationsViewState.Current.HasError)
            {
                <ErrorBlock Message="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_LOAD_ERROR))"
                            OnRetry="ReservationsViewService.RetryCurrentAsync" />
            }
            else if (ReservationsViewState.Completed.HasError)
            {
                <ErrorBlock Message="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_LOAD_ERROR))"
                            OnRetry="ReservationsViewService.RetryCompletedAsync" />
            }
            else if (ReservationsViewState.Current.IsLoading || ReservationsViewState.Completed.IsLoading || ReservationsViewState.IsReloading)
            {
                <div class="home-skeleton page-reservations__skeleton"></div>
            }
            else
            {
                <div class="page-reservations__empty">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_RESERVATIONS_NOT_FOUND))</div>
            }
        }
        else
        {

            <h2 class="page-reservations__title">@CurrentTitle</h2>

            <div class="page-reservations__legend">
                <span class="page-reservations__legend-item page-reservations__legend-item--paid">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_RESERVATIONS_PAYMENT_PAID))
                </span>
                <span class="page-reservations__legend-item page-reservations__legend-item--unpaid">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="m21.7 18-8-14a2 2 0 0 0-3.4 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.7-3Z" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" />
                        <path d="M12 9v4M12 17h.01" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
                    </svg>
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_RESERVATIONS_PAYMENT_NOT_PAID))
                </span>
                <span class="page-reservations__legend-item page-reservations__legend-item--partial">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2.2" />
                        <path d="M12 2a10 10 0 0 0 0 20Z" fill="currentColor" />
                    </svg>
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_RESERVATIONS_PAYMENT_PARTIAL))
                </span>
            </div>

            <section class="page-reservations__section">
                @if (ReservationsViewState.Current.HasError)
                {
                    <ErrorBlock Message="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_LOAD_ERROR))"
                                OnRetry="ReservationsViewService.RetryCurrentAsync" />
                }
                else if (ReservationsViewState.Current.IsLoading)
                {
                    <div class="home-skeleton page-reservations__skeleton"></div>
                }
                else if (ReservationsViewState.Current.Value is { Count: 0 })
                {
                    <div class="page-reservations__empty">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_RESERVATIONS_EMPTY))</div>
                }
                else
                {
                    <div class="page-reservations__list">
                        @foreach (var reservation in ReservationsViewState.Current.Value ?? [])
                        {
                            <ReservationCard @key="reservation.Id"
                                             Reservation="reservation"
                                             IsExpanded="@ReservationsViewState.ExpandedIds.Contains(reservation.Id)"
                                             IsConfirmingCancel="@(ReservationsViewState.ConfirmingCancelId == reservation.Id)"
                                             IsCanceling="@ReservationsViewState.IsCanceling"
                                             OnToggleDetails="OnToggleDetails"
                                             OnCancel="OnCancel"
                                             OnConfirmCancel="ReservationsViewService.ConfirmCancelAsync"
                                             OnKeep="OnKeep" />
                        }
                    </div>
                }
            </section>

            @if (ReservationsViewState.Completed.HasError)
            {
                <section class="page-reservations__section">
                    <ErrorBlock Message="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_LOAD_ERROR))"
                                OnRetry="ReservationsViewService.RetryCompletedAsync" />
                </section>
            }
            else if (ReservationsViewState.Completed.IsLoading)
            {
                <div class="home-skeleton page-reservations__skeleton"></div>
            }
            else if (ReservationsViewState.Completed.Value is { Count: > 0 })
            {
                <section class="page-reservations__section">
                    <div class="page-reservations__divider">
                        <div class="page-reservations__divider-title">
                            <span class="page-reservations__divider-line"></span>
                            <h2 class="page-reservations__title">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_RESERVATIONS_COMPLETED_TITLE))</h2>
                            <span class="page-reservations__count">@ReservationsViewState.Completed.Value.Count</span>
                        </div>
                        <button type="button" class="page-reservations__toggle" aria-expanded="@(ReservationsViewState.IsCompletedCollapsed ? "false" : "true")"
                                @onclick="ReservationsViewService.ToggleCompleted">
                            <span>
                                @LocalizationService.GetString(ReservationsViewState.IsCompletedCollapsed
                                    ? nameof(Autogenerated.Resources.GO_RESERVATIONS_SHOW)
                                    : nameof(Autogenerated.Resources.GO_RESERVATIONS_HIDE))
                            </span>
                            <svg width="14" height="14" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                                <path d="M3 4.5L6 7.5l3-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </button>
                    </div>

                    @if (!ReservationsViewState.IsCompletedCollapsed)
                    {
                        <div class="page-reservations__list">
                            @foreach (var reservation in ReservationsViewState.Completed.Value)
                            {
                                <ReservationCard @key="reservation.Id"
                                                 Reservation="reservation"
                                                 IsCompleted="true"
                                                 IsExpanded="@ReservationsViewState.ExpandedIds.Contains(reservation.Id)"
                                                 OnToggleDetails="OnToggleDetails" />
                            }
                        </div>
                    }
                </section>
            }
        }
    </div>
</div>
