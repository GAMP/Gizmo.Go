@attribute [Route(NavigationHelper.ProfileAboutRoute)]
@attribute [Authorize]

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_ABOUT))</PageTitle>

<div class="page-shell page-profile-about">

    <ScreenBackHeader Title="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_ABOUT))"
                      IsCentered="true"
                      AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_BACK))"
                      OnBack="BackAsync" />

    <div class="screen-content">
        <div class="about-card">
            <h2 class="about-card__name">Gizmo</h2>
            <div class="about-card__version">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_ABOUT_VERSION), ProfileAboutViewState.Version)</div>
            <p class="about-card__description">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_ABOUT_DESCRIPTION))</p>
        </div>

        <section class="about-section">
            <h2 class="about-section__title">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_ABOUT_INFO))</h2>
            <DocumentList Items="GetItems()" OnSelect="OpenDocument" />
        </section>
    </div>
</div>
