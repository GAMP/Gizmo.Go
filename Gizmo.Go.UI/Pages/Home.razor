@attribute [Route(NavigationHelper.HomePage)]
@attribute [Authorize]

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_APP_NAME))</PageTitle>

<div class="page-shell page-home">

    <HomeHeader LogoUrl="@HomeViewState.Logo.Value"
                Level="@HomeViewState.Level.Value"
                OnLevelClick="HomeViewService.OpenLadderInfoAsync"
                OnProfileClick="HomeViewService.OpenProfile" />

    <div class="page-home__content">

        <BalanceCards Balance="@HomeViewState.Balance.Value" IsLoading="@HomeViewState.Balance.IsLoading" />

        @if (HomeViewState.Reservation.IsLoading || HomeViewState.Reservation.Value is not null)
        {
            <NearestReservationCard Reservation="@HomeViewState.Reservation.Value"
                                    IsLoading="@HomeViewState.Reservation.IsLoading"
                                    OnOpen="HomeViewService.OpenNearestReservation" />
        }

        <NewsCarousel News="@HomeViewState.News.Value"
                      IsLoading="@HomeViewState.News.IsLoading"
                      OnNewsClick="OnNewsClick"
                      OnAllNewsClick="HomeViewService.OpenAllNews" />

        <QuickActions OnOpenReservations="HomeViewService.OpenReservations" />

        <section class="page-home__clubs">
            @* the city selector follows the title *@
            <div class="page-home__clubs-header">
                <h2 class="page-home__section-title">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_HOME_CLUBS))</h2>
                @if (HomeViewState.Cities.Value is { Count: > 0 })
                {
                    <CitySelect Cities="@HomeViewState.Cities.Value"
                                SelectedCity="@HomeViewState.SelectedCity"
                                OnSelect="HomeViewService.SelectCityAsync" />
                }
            </div>

            @if (HomeViewState.Cities.HasError)
            {
                <ErrorBlock Message="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_LOAD_ERROR))"
                            OnRetry="HomeViewService.ReloadCitiesAsync" />
            }
            else if (HomeViewState.Clubs.HasError)
            {
                <ErrorBlock Message="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_LOAD_ERROR))"
                            OnRetry="HomeViewService.ReloadClubsAsync" />
            }
            else if (HomeViewState.Cities.IsLoading || HomeViewState.Clubs.IsLoading)
            {
                <div class="home-skeleton home-skeleton--club"></div>
                <div class="home-skeleton home-skeleton--club"></div>
            }
            else if (HomeViewState.Clubs.Value is { Count: > 0 })
            {
                <div class="page-home__clubs-list">
                    @foreach (var club in HomeViewState.Clubs.Value)
                    {
                        <ClubCard @key="club.Id" Club="club" />
                    }
                </div>
            }
            else
            {
                <div class="page-home__empty">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_HOME_NO_CLUBS))</div>
            }
        </section>
    </div>
</div>
