@page "/create-account"
@layout LoginLayout

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_PAGE_TITLE))</PageTitle>

<div class="page-create-account">

    <header class="auth-header">
        <LangButton />
    </header>

    <div class="auth-body">

        <div class="auth-card">

            <div class="auth-card__header">
                <div class="auth-card__logo" aria-hidden="true"></div>
                <div class="auth-card__titles">
                    <h1 class="auth-card__title">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_HEADING))
                    </h1>
                    <p class="auth-card__subtitle">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_SUBTITLE))
                    </p>
                </div>
            </div>

            <div class="create-account-fields">

                <div class="auth-field">
                    <label class="auth-field__label" for="country">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_COUNTRY_LABEL))
                    </label>
                    <button type="button"
                            id="country"
                            class="create-account-country-btn create-account-country-btn--selected"
                            aria-haspopup="listbox">
                        <span class="create-account-country-btn__text create-account-country-btn__text--filled">
                            <span class="create-account-country-btn__flag" aria-hidden="true">🇷🇺</span>
                            Россия
                        </span>
                        <svg class="create-account-country-btn__chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </button>
                </div>

                <div class="auth-field">
                    <label class="auth-field__label" for="phone">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_PHONE_LABEL))
                    </label>
                    <div class="auth-field__input-wrap">
                        <span class="create-account-phone-prefix">+7</span>
                        <input id="phone"
                               type="tel"
                               inputmode="numeric"
                               class="auth-field__input"
                               value="@CreateAccountViewState.Phone"
                               @oninput="OnPhoneInput"
                               autocomplete="tel"
                               maxlength="10"
                               placeholder="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_PHONE_PLACEHOLDER))" />
                    </div>
                </div>

            </div>

            <div class="create-account-terms"
                 role="checkbox"
                 aria-checked="@CreateAccountViewState.TermsAccepted"
                 tabindex="0"
                 @onclick="ToggleTerms"
                 @onkeydown="OnTermsKeyDown">
                <div class="create-account-terms__checkbox @(CreateAccountViewState.TermsAccepted ? "create-account-terms__checkbox--checked" : "")" aria-hidden="true">
                    @if (CreateAccountViewState.TermsAccepted)
                    {
                        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    }
                </div>
                <span class="create-account-terms__text">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_TERMS_PREFIX))<button type="button" class="create-account-terms__link" @onclick:stopPropagation="true">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_TERMS_LINK1))</button>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_TERMS_AND))<button type="button" class="create-account-terms__link" @onclick:stopPropagation="true">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_TERMS_LINK2))</button>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_TERMS_SUFFIX))
                </span>
            </div>

            <button type="button"
                    class="auth-submit create-account-submit"
                    disabled="@(!CreateAccountViewState.IsFormValid)"
                    @onclick="SubmitAsync">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_SUBMIT))
            </button>

        </div>

        <div class="auth-footer">
            <span class="auth-footer__text">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_HAS_ACCOUNT))
            </span>
            <button type="button" class="auth-footer__link" @onclick="NavigateToLogin">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_SIGN_IN))
            </button>
        </div>

    </div>

</div>
