@attribute [Route(NavigationHelper.ProfilePoliciesRoute)]
@attribute [Authorize]

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_POLICIES))</PageTitle>

<div class="page-shell page-profile-policies">

    <ScreenBackHeader Title="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_POLICIES))"
                      IsCentered="true"
                      AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_BACK))"
                      OnBack="BackAsync" />

    <div class="screen-content">
        @if (ProfilePoliciesViewState.Agreements.HasError)
        {
            <ErrorBlock Message="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_LOAD_ERROR))"
                        OnRetry="ProfilePoliciesViewService.LoadAsync" />
        }
        else if (ProfilePoliciesViewState.Agreements.IsLoading)
        {
            <div class="home-skeleton document-list-skeleton"></div>
        }
        else if (ProfilePoliciesViewState.Agreements.Value is { Count: > 0 } agreements)
        {
            <DocumentList Items="GetItems(agreements)" OnSelect="OpenPolicy" />
        }
        else
        {
            <div class="document-empty">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_DOCUMENTS_EMPTY))</div>
        }
    </div>
</div>
