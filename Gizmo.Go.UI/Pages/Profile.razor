@attribute [Route(NavigationHelper.ProfileRoute)]
@attribute [Authorize]

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_PAGE_TITLE))</PageTitle>

<div class="page-shell page-profile">

    <ScreenBackHeader Title="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_PAGE_TITLE))"
                      IsCentered="true"
                      AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_BACK))"
                      OnBack="BackAsync" />

    <div class="page-profile__content">

        @if (ProfileViewState.Profile.HasError)
        {
            <ErrorBlock Message="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_LOAD_ERROR))"
                        OnRetry="ProfileViewService.LoadAsync" />
        }
        else if (ProfileViewState.Profile.IsLoading)
        {
            <div class="home-skeleton page-profile__skeleton"></div>
        }
        else
        {
            <div class="profile-summary">
                <div class="profile-summary__avatar">
                    <span>@ProfileViewState.Initials</span>
                    @if (ProfileViewState.Level.Value is { } level)
                    {
                        <button type="button" class="profile-summary__level" @onclick="ProfileViewService.OpenLadderInfoAsync">
                            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_HOME_LADDER_LEVEL_SHORT), level.Ordinal)
                        </button>
                    }
                </div>
                <div class="profile-summary__identity">
                    <h2 class="profile-summary__name">@ProfileViewState.Nickname</h2>
                    @if (!string.IsNullOrEmpty(ProfileViewState.MaskedPhone))
                    {
                        <div class="profile-summary__phone">@ProfileViewState.MaskedPhone</div>
                    }
                    @if (!string.IsNullOrEmpty(ProfileViewState.SinceText))
                    {
                        <div class="profile-summary__since">@ProfileViewState.SinceText</div>
                    }
                </div>
            </div>
        }

        <div class="profile-divider"></div>

        <section class="profile-section">
            <h2 class="profile-section__title">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_NOTIFICATIONS))</h2>
            <div class="profile-section__card">
                <button type="button" class="profile-row profile-row--switch" role="switch"
                        aria-checked="@(ProfileViewState.PersonalNotifications ? "true" : "false")"
                        @onclick="ProfileViewService.TogglePersonalNotificationsAsync">
                    <span class="profile-row__text">
                        <span class="profile-row__label">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_NOTIFY_PUSH))</span>
                        <span class="profile-row__detail">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_NOTIFY_PUSH_TEXT))</span>
                    </span>
                    <span class="profile-switch @(ProfileViewState.PersonalNotifications ? "profile-switch--on" : "")" aria-hidden="true"></span>
                </button>
                <button type="button" class="profile-row profile-row--switch" role="switch"
                        aria-checked="@(ProfileViewState.NewsNotifications ? "true" : "false")"
                        @onclick="ProfileViewService.ToggleNewsNotificationsAsync">
                    <span class="profile-row__text">
                        <span class="profile-row__label">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_NOTIFY_PROMO))</span>
                        <span class="profile-row__detail">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_NOTIFY_PROMO_TEXT))</span>
                    </span>
                    <span class="profile-switch @(ProfileViewState.NewsNotifications ? "profile-switch--on" : "")" aria-hidden="true"></span>
                </button>
            </div>
        </section>

        <section class="profile-section">
            <h2 class="profile-section__title">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_SETTINGS))</h2>
            <div class="profile-section__card">
                <button type="button" class="profile-row" @onclick="ProfileViewService.OpenLanguage">
                    <span class="profile-row__icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M3 12h18M12 3c2.5 2.5 3.8 5.5 3.8 9s-1.3 6.5-3.8 9c-2.5-2.5-3.8-5.5-3.8-9S9.5 5.5 12 3z" />
                        </svg>
                    </span>
                    <span class="profile-row__text">
                        <span class="profile-row__label profile-row__label--large">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_LANGUAGE))</span>
                        <span class="profile-row__detail profile-row__detail--small">@ProfileViewState.LanguageName</span>
                    </span>
                    <ProfileRowChevron />
                </button>
                <button type="button" class="profile-row" @onclick="ProfileViewService.OpenChangePassword">
                    <span class="profile-row__icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="5" y="11" width="14" height="10" rx="2" />
                            <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                        </svg>
                    </span>
                    <span class="profile-row__text">
                        <span class="profile-row__label profile-row__label--large">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_CHANGE_PASSWORD))</span>
                        <span class="profile-row__detail profile-row__detail--small">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_CHANGE_PASSWORD_TEXT))</span>
                    </span>
                    <ProfileRowChevron />
                </button>
                <button type="button" class="profile-row" @onclick="ProfileViewService.OpenPolicies">
                    <span class="profile-row__icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
                            <path d="M14 3v5h5M9 13h6M9 17h6" />
                        </svg>
                    </span>
                    <span class="profile-row__text">
                        <span class="profile-row__label profile-row__label--large">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_POLICIES))</span>
                        <span class="profile-row__detail profile-row__detail--small">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_POLICIES_TEXT))</span>
                    </span>
                    <ProfileRowChevron />
                </button>
                <button type="button" class="profile-row" @onclick="ProfileViewService.OpenAbout">
                    <span class="profile-row__icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M12 11v5M12 8h.01" />
                        </svg>
                    </span>
                    <span class="profile-row__text">
                        <span class="profile-row__label profile-row__label--large">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_ABOUT))</span>
                        <span class="profile-row__detail profile-row__detail--small">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_ABOUT_TEXT))</span>
                    </span>
                    <ProfileRowChevron />
                </button>
            </div>
        </section>

        <div class="profile-actions">
            <button type="button" class="profile-action" @onclick="ProfileViewService.LogoutAsync">
                <span class="profile-row__icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" />
                    </svg>
                </span>
                <span class="profile-action__label">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_LOGOUT))</span>
                <ProfileRowChevron />
            </button>
            <button type="button" class="profile-action profile-action--danger" @onclick="ProfileViewService.DeleteAccountAsync">
                <span class="profile-row__icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2M6 6l1 14a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-14" />
                    </svg>
                </span>
                <span class="profile-action__label">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_DELETE_ACCOUNT))</span>
                <ProfileRowChevron />
            </button>
        </div>
    </div>
</div>
