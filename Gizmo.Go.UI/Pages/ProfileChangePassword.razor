@attribute [Route(NavigationHelper.ProfileChangePasswordRoute)]
@attribute [Authorize]

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_CHANGE_PASSWORD))</PageTitle>

@if (ProfileChangePasswordViewState.IsSuccess)
{
    <SuccessScreen CssClass="registration-success--recovery"
                   Title="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_SUCCESS_HEADING))"
                   ButtonText="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_CHANGE_PASSWORD_DONE))"
                   OnButtonClick="DoneAsync">
        <Subtitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_CHANGE_PASSWORD_SUCCESS_TEXT))</Subtitle>
    </SuccessScreen>
}
else
{
    @* the layout of the auth form steps inside the main zone *@
    <div class="auth-form-page page-profile-change-password">

        <ScreenBackHeader AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_BACK))"
                          OnBack="BackAsync" />

        <div class="auth-form">

            <ErrorBlock Message="@(ProfileChangePasswordViewState.HasError ? ProfileChangePasswordViewState.ErrorMessage : null)" />

            <div class="auth-hero">
                <h1 class="auth-hero__title">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_NEW_PASSWORD))
                </h1>
                <p class="auth-hero__subtitle">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_SET_PASSWORD_MESSAGE))
                </p>
            </div>

            <EditForm EditContext="@ProfileChangePasswordViewService.EditContext">

                <div class="auth-form__fields">

                    <div class="auth-field">
                        <label class="auth-field__label" for="cp-current-password">
                            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_CHANGE_PASSWORD_CURRENT_LABEL))
                        </label>
                        <div class="auth-field__input-wrap @(HasErrors(() => ProfileChangePasswordViewState.CurrentPassword) ? "auth-field__input-wrap--invalid" : "")">
                            <input id="cp-current-password"
                                   type="@(_showCurrent ? "text" : "password")"
                                   class="auth-field__input"
                                   value="@ProfileChangePasswordViewState.CurrentPassword"
                                   @oninput="OnCurrentPasswordInput"
                                   disabled="@ProfileChangePasswordViewState.IsLoading"
                                   autocomplete="current-password"
                                   placeholder="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PROFILE_CHANGE_PASSWORD_CURRENT_PLACEHOLDER))" />
                            <EyeToggleButton Visible="_showCurrent" OnToggle="ToggleShowCurrent" />
                        </div>
                        <ValidationMessage For="@(() => ProfileChangePasswordViewState.CurrentPassword)" />
                    </div>

                    <div class="auth-field">
                        <label class="auth-field__label" for="cp-new-password">
                            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_PASSWORD_PASSWORD_LABEL))
                        </label>
                        <div class="auth-field__input-wrap @(HasErrors(() => ProfileChangePasswordViewState.NewPassword) ? "auth-field__input-wrap--invalid" : "")">
                            <input id="cp-new-password"
                                   type="@(_showPassword ? "text" : "password")"
                                   class="auth-field__input"
                                   value="@ProfileChangePasswordViewState.NewPassword"
                                   @oninput="OnNewPasswordInput"
                                   disabled="@ProfileChangePasswordViewState.IsLoading"
                                   autocomplete="new-password"
                                   placeholder="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_PASSWORD_PASSWORD_PLACEHOLDER))" />
                            <EyeToggleButton Visible="_showPassword" OnToggle="ToggleShowPassword" />
                        </div>
                        <ValidationMessage For="@(() => ProfileChangePasswordViewState.NewPassword)" />
                    </div>

                    <div class="auth-field">
                        <label class="auth-field__label" for="cp-repeat-password">
                            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_PASSWORD_CONFIRM_LABEL))
                        </label>
                        <div class="auth-field__input-wrap @(HasErrors(() => ProfileChangePasswordViewState.RepeatPassword) ? "auth-field__input-wrap--invalid" : "")">
                            <input id="cp-repeat-password"
                                   type="@(_showConfirm ? "text" : "password")"
                                   class="auth-field__input"
                                   value="@ProfileChangePasswordViewState.RepeatPassword"
                                   @oninput="OnRepeatPasswordInput"
                                   disabled="@ProfileChangePasswordViewState.IsLoading"
                                   autocomplete="new-password"
                                   placeholder="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_PASSWORD_CONFIRM_PLACEHOLDER))" />
                            <EyeToggleButton Visible="_showConfirm" OnToggle="ToggleShowConfirm" />
                        </div>
                        <ValidationMessage For="@(() => ProfileChangePasswordViewState.RepeatPassword)" />
                    </div>

                </div>

            </EditForm>

            @if (Tooltip.TotalRules > 0)
            {
                <div class="create-password-requirements">
                    <p class="create-password-requirements__title">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_PASSWORD_REQUIREMENTS_TITLE))
                    </p>
                    <ul class="create-password-requirements__list" aria-label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_PASSWORD_REQUIREMENTS_ARIA))">
                        @if (Tooltip.MinimumLengthRule > 0 && Tooltip.MaximumLengthRule > 0)
                        {
                            <li class="create-password-req @(Tooltip.LengthRulePassed ? "create-password-req--met" : "")">
                                <svg class="create-password-req__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M6.483 9.85l4.984-4.983a.58.58 0 0 1 .85 0 .58.58 0 0 1 0 .85l-5.4 5.417a.58.58 0 0 1-.85 0L3.683 8.75a.58.58 0 0 1 0-.85.58.58 0 0 1 .85 0l1.95 1.95z" fill="currentColor" /></svg>
                                <span>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RULE_RANGE_LENGTH), Tooltip.MinimumLengthRule, Tooltip.MaximumLengthRule)</span>
                            </li>
                        }
                        else if (Tooltip.MinimumLengthRule > 0)
                        {
                            <li class="create-password-req @(Tooltip.LengthRulePassed ? "create-password-req--met" : "")">
                                <svg class="create-password-req__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M6.483 9.85l4.984-4.983a.58.58 0 0 1 .85 0 .58.58 0 0 1 0 .85l-5.4 5.417a.58.58 0 0 1-.85 0L3.683 8.75a.58.58 0 0 1 0-.85.58.58 0 0 1 .85 0l1.95 1.95z" fill="currentColor" /></svg>
                                <span>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RULE_MIN_LENGTH), Tooltip.MinimumLengthRule)</span>
                            </li>
                        }
                        else if (Tooltip.MaximumLengthRule > 0)
                        {
                            <li class="create-password-req @(Tooltip.LengthRulePassed ? "create-password-req--met" : "")">
                                <svg class="create-password-req__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M6.483 9.85l4.984-4.983a.58.58 0 0 1 .85 0 .58.58 0 0 1 0 .85l-5.4 5.417a.58.58 0 0 1-.85 0L3.683 8.75a.58.58 0 0 1 0-.85.58.58 0 0 1 .85 0l1.95 1.95z" fill="currentColor" /></svg>
                                <span>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RULE_MAX_LENGTH), Tooltip.MaximumLengthRule)</span>
                            </li>
                        }
                        @if (Tooltip.HasLowerCaseCharactersRule)
                        {
                            <li class="create-password-req @(Tooltip.LowerCaseCharactersRulePassed ? "create-password-req--met" : "")">
                                <svg class="create-password-req__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M6.483 9.85l4.984-4.983a.58.58 0 0 1 .85 0 .58.58 0 0 1 0 .85l-5.4 5.417a.58.58 0 0 1-.85 0L3.683 8.75a.58.58 0 0 1 0-.85.58.58 0 0 1 .85 0l1.95 1.95z" fill="currentColor" /></svg>
                                <span>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RULE_LOWER_CASE))</span>
                            </li>
                        }
                        @if (Tooltip.HasUpperCaseCharactersRule)
                        {
                            <li class="create-password-req @(Tooltip.UpperCaseCharactersRulePassed ? "create-password-req--met" : "")">
                                <svg class="create-password-req__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M6.483 9.85l4.984-4.983a.58.58 0 0 1 .85 0 .58.58 0 0 1 0 .85l-5.4 5.417a.58.58 0 0 1-.85 0L3.683 8.75a.58.58 0 0 1 0-.85.58.58 0 0 1 .85 0l1.95 1.95z" fill="currentColor" /></svg>
                                <span>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RULE_UPPER_CASE))</span>
                            </li>
                        }
                        @if (Tooltip.HasNumbersRule)
                        {
                            <li class="create-password-req @(Tooltip.NumbersRulePassed ? "create-password-req--met" : "")">
                                <svg class="create-password-req__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M6.483 9.85l4.984-4.983a.58.58 0 0 1 .85 0 .58.58 0 0 1 0 .85l-5.4 5.417a.58.58 0 0 1-.85 0L3.683 8.75a.58.58 0 0 1 0-.85.58.58 0 0 1 .85 0l1.95 1.95z" fill="currentColor" /></svg>
                                <span>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RULE_NUMBER))</span>
                            </li>
                        }
                    </ul>
                </div>
            }

            <button type="button"
                    class="auth-submit"
                    disabled="@IsSubmitDisabled"
                    @onclick="SubmitAsync">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_SAVE_PASSWORD))
            </button>

        </div>

    </div>
}
