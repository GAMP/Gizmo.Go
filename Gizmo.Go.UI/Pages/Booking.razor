@attribute [Route(NavigationHelper.BookingRoute)]
@attribute [Authorize]

<PageTitle>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_TITLE))</PageTitle>

<div class="page-shell page-booking">

    @if (BookingViewState.Club.Value is not null && BookingViewState.Options.Value is not null && !BookingViewState.IsNotFound)
    {
        <BookingHeader State="BookingViewState" />

        <div class="booking">
            @switch (BookingViewState.Step)
            {
                case 1:
                    <BookingSessionStep State="BookingViewState" />
                    break;
                case 2:
                    <BookingHostsStep State="BookingViewState" />
                    break;
                default:
                    if (BookingViewState.Offer is not null)
                    {
                        <BookingConfirmStep State="BookingViewState" />
                    }
                    break;
            }
        </div>
    }
    else
    {
        <ScreenBackHeader Title="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_TITLE))"
                          AriaLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_BACK))"
                          OnBack="BackAsync" />

        <div class="page-booking__state">
            @if (BookingViewState.Club.HasError || BookingViewState.Options.HasError)
            {
                <ErrorBlock Message="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_LOAD_ERROR))"
                            OnRetry="ReloadAsync" />
            }
            else if (BookingViewState.IsNotFound)
            {
                <ErrorBlock Message="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CLUB_NOT_FOUND))" />
            }
            else
            {
                <div class="home-skeleton page-booking__skeleton"></div>
            }
        </div>
    }
</div>
