@{
    var club = State.Club.Value!.Branch;
    var zone = BranchScheduleHelper.GetTimeZone(club);
    var now = BranchScheduleHelper.ToBranchTime(club, DateTime.UtcNow);
    var today = DateOnly.FromDateTime(now);
    var groups = new (string Key, int From, int To)[]
    {
        (nameof(Autogenerated.Resources.GO_BOOKING_PART_MORNING), 0, 24),
        (nameof(Autogenerated.Resources.GO_BOOKING_PART_DAY), 24, 34),
        (nameof(Autogenerated.Resources.GO_BOOKING_PART_EVENING), 34, 48)
    };
}

<section class="booking-step booking-session">
    <div class="booking-block">
        <h2 class="booking-block__label">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_DATE))</h2>
        <div class="booking-dates">
            @for (var offset = 0; offset < BookingTimeHelper.DaysAhead; offset++)
            {
                var day = today.AddDays(offset);
                var weekday = offset switch
                {
                    0 => LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_TODAY_SHORT)),
                    1 => LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_TOMORROW_SHORT)),
                    _ => BookingTimeHelper.FormatWeekday(day)
                };
                var hasSlots = BookingTimeHelper.HasSelectableSlot(zone, now, day);
                var isWeekend = day.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;

                <button type="button"
                        class="booking-date @(State.Date == day ? "booking-date--selected" : "") @(isWeekend ? "booking-date--weekend" : "")"
                        disabled="@(!hasSlots || State.IsBusy)"
                        @onclick="() => Service.SelectDate(day)">
                    <span class="booking-date__weekday">@weekday</span>
                    <span class="booking-date__day">@day.Day</span>
                    <span class="booking-date__month">@BookingTimeHelper.FormatMonth(day)</span>
                </button>
            }
        </div>
    </div>

    <div class="booking-block">
        <h2 class="booking-block__label">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_START_TIME))</h2>

        @if (State.Date is { } date)
        {
            foreach (var group in groups)
            {
                <div class="booking-time__group">
                    <span class="booking-time__group-name">@LocalizationService.GetString(group.Key)</span>
                    <div class="booking-time__grid">
                        @for (var index = group.From; index < group.To; index++)
                        {
                            var slot = BookingTimeHelper.Slots[index];
                            var isSelectable = BookingTimeHelper.IsSlotSelectable(zone, now, date, slot);

                            <button type="button"
                                    class="booking-slot @(State.StartTime == slot ? "booking-slot--selected" : "")"
                                    disabled="@(!isSelectable || State.IsBusy)"
                                    @onclick="() => Service.SelectStartTime(slot)">
                                @BookingTimeHelper.FormatTime(slot)
                            </button>
                        }
                    </div>
                </div>
            }
        }
    </div>

    <div class="booking-block">
        <h2 class="booking-block__label">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_DURATION))</h2>
        @if (State.Durations.Count == 0)
        {
            <p class="booking-block__note">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_NO_OPTIONS_HINT))</p>
        }
        else
        {
            <div class="booking-durations">
                @foreach (var minutes in State.Durations)
                {
                    var value = minutes;

                    <button type="button"
                            class="booking-duration @(State.Duration == value ? "booking-duration--selected" : "")"
                            disabled="@State.IsBusy"
                            @onclick="() => Service.SelectDuration(value)">
                        @BookingTimeHelper.FormatDuration(value, LocalizationService)
                    </button>
                }
            </div>
        }
    </div>

    @if (State.HasSession)
    {
        <div class="booking-summary-card">
            <span class="booking-summary-card__icon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z" />
                </svg>
            </span>
            <span class="booking-summary-card__text">
                <span class="booking-summary-card__title">@BookingTimeHelper.FormatDate(State.Date!.Value) · @BookingTimeHelper.FormatTimeRange(State.StartTime!.Value, State.Duration!.Value)</span>
                <span class="booking-summary-card__sub">@BookingTimeHelper.FormatDuration(State.Duration!.Value, LocalizationService)</span>
            </span>
            <svg class="booking-summary-card__check" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8.5l3.2 3.2L13 4.8" stroke="currentColor" stroke-width="1.33" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </div>
    }

    @if (State.HasActionError)
    {
        <ErrorBlock Message="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_LOAD_ERROR))" OnRetry="Service.RetryAsync" />
    }

    <div class="booking-bar">
        <button type="button" class="booking-action" disabled="@(!State.HasSession || State.IsBusy)" @onclick="Service.SelectHostsAsync">
            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_SELECT_PC))
        </button>
    </div>
</section>
