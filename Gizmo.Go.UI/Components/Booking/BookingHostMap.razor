@using Gizmo.Go.UI.View.Services.Pages
@{
    // every row of the layout is drawn, an empty row keeps the gap between the host rows
    var hostsByRow = Tab.Hosts.ToLookup(item => item.Row);
    var rows = Enumerable.Range(0, Tab.Hosts.Max(item => item.Row) + 1).Select(row => hostsByRow[row]).ToList();
    var columns = Tab.Hosts.Max(item => item.Column) + 1;
}

<div class="booking-map">
    <div class="booking-map__viewport">
        <div class="booking-map__grid booking-map__grid--zoom-@State.Zoom">
            @foreach (var row in rows)
            {
                <div class="booking-map__row">
                    @for (var column = 0; column < columns; column++)
                    {
                        var item = row.FirstOrDefault(host => host.Column == column);

                        if (item is null)
                        {
                            <span class="booking-tile booking-tile--empty"></span>
                            continue;
                        }

                        var hostId = item.Host.Id;
                        var isFree = State.FreeHostIds.Contains(hostId);
                        var isSelected = State.SelectedHostIds.Contains(hostId);

                        <button type="button"
                                class="booking-tile booking-group-color--@State.GetGroupColor(item.Host.HostGroupId) @(isSelected ? "booking-tile--selected" : "") @(!isFree ? "booking-tile--busy" : "")"
                                disabled="@(!isFree || State.IsBusy)"
                                aria-pressed="@isSelected.ToString().ToLowerInvariant()"
                                aria-label="@BookingTimeHelper.FormatHost(item.Host.Number, LocalizationService)"
                                @onclick="() => Service.ToggleHost(hostId)">
                            <span class="booking-tile__number">@item.Host.Number.ToString("00")</span>
                            @if (isSelected)
                            {
                                <svg class="booking-tile__check" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                                    <path d="M3.5 8.3l3 3L12.5 5" stroke="currentColor" stroke-width="1.33" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            }
                        </button>
                    }
                </div>
            }
        </div>
    </div>

    <div class="booking-map__controls">
        <button type="button" class="booking-map__control" aria-label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_ZOOM_IN))" disabled="@(State.Zoom >= MapZoom.Max)" @onclick="Service.ZoomIn">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M7 2.5v9M2.5 7h9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
        </button>
        <button type="button" class="booking-map__control" aria-label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_ZOOM_OUT))" disabled="@(State.Zoom <= MapZoom.Min)" @onclick="Service.ZoomOut">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2.5 7h9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
        </button>
        <button type="button" class="booking-map__control" aria-label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_ZOOM_FIT))" @onclick="Service.ZoomFit">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M2.5 5.5v-3h3M10.5 2.5h3v3M13.5 10.5v3h-3M5.5 13.5h-3v-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                <rect x="5" y="5" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.3" />
            </svg>
        </button>
    </div>

    <span class="booking-map__zoom">@State.Zoom%</span>
</div>
