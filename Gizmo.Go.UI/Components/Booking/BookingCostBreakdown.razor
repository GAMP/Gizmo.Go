@using Gizmo.Go.Core.Models.Booking
@{
    var offer = State.Offer!;
    var options = State.Options.Value!;
    var duration = BookingTimeHelper.FormatDuration(offer.Duration, LocalizationService);
    var showMinimum = offer.MinimumPayment > 0 && offer.MinimumPayment < offer.Total;
}

<div class="booking-cost">
    <h3 class="booking-cost__title">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_COST_TITLE))</h3>

    @foreach (var item in offer.Hosts.OrderBy(entry => State.GetHost(entry.HostId)?.Number))
    {
        var host = State.GetHost(item.HostId);
        var rate = BookingTimeHelper.FormatRate(State.GetHourlyRate(item.HostGroupId), LocalizationService);
        var calculation = rate.Length > 0 ? $"1 × {duration} × {rate}" : $"1 × {duration}";

        <div class="booking-cost__row booking-group-color--@State.GetGroupColor(item.HostGroupId)">
            <div class="booking-cost__line">
                <span class="booking-cost__name">
                    <span class="booking-cost__dot"></span>
                    @State.GetGroupName(item.HostGroupId)
                </span>
                <span class="booking-cost__amount">@ReservationDisplayHelper.FormatAmount(item.Price)</span>
            </div>
            <span class="booking-cost__sub">@(host is null ? calculation : $"{BookingTimeHelper.FormatHost(host.Number, LocalizationService)} · {calculation}")</span>
        </div>
    }

    @if (offer.Fee is > 0)
    {
        <div class="booking-cost__row booking-cost__row--fee">
            <div class="booking-cost__line">
                <span class="booking-cost__fee">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L2 12V2h10l8.6 8.6a2 2 0 0 1 0 2.8z" />
                        <path d="M7 7h.01" />
                    </svg>
                    @if (options.FeeType == BookingFeeType.Percentage)
                    {
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_FEE_PERCENT), options.Fee.ToString("0.##"))
                    }
                    else
                    {
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_FEE))
                    }
                </span>
                <span class="booking-cost__fee-amount">@ReservationDisplayHelper.FormatAmount(offer.Fee.Value)</span>
            </div>
        </div>
    }

    <div class="booking-cost__row booking-cost__row--total">
        <div class="booking-cost__line">
            <span class="booking-cost__total-label">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_TOTAL))</span>
            <span class="booking-cost__total">@ReservationDisplayHelper.FormatAmount(offer.Total)</span>
        </div>
    </div>

    @if (showMinimum)
    {
        <p class="booking-cost__note">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10" />
                <path d="M12 16v-4M12 8h.01" />
            </svg>
            <span>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_MINIMUM_NOTE), ReservationDisplayHelper.FormatAmount(offer.MinimumPayment))</span>
        </p>
    }
</div>
