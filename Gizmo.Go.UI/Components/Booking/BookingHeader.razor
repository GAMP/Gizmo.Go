@{
    var club = State.Club.Value?.Branch;
    var steps = new[]
    {
        nameof(Autogenerated.Resources.GO_BOOKING_STEP_SESSION),
        nameof(Autogenerated.Resources.GO_BOOKING_STEP_HOSTS),
        nameof(Autogenerated.Resources.GO_BOOKING_STEP_CONFIRM)
    };
}

<header class="booking-header">
    <div class="booking-header__bar">
        <button type="button" class="booking-header__button" aria-label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_BACK))" @onclick="BackAsync">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <path d="M11 4.5L6.5 9l4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>

        <div class="booking-header__titles">
            <h1 class="booking-header__title">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_TITLE))</h1>
            <span class="booking-header__club">@club?.Name</span>
        </div>

        @if (State.Step > 1)
        {
            <button type="button" class="booking-header__button booking-header__button--close" aria-label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_CLOSE))" @onclick="Service.CloseAsync">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path d="M2 2L10 10M10 2L2 10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                </svg>
            </button>
        }
        else
        {
            <span class="booking-header__spacer" aria-hidden="true"></span>
        }
    </div>

    <ol class="booking-progress">
        @for (var index = 0; index < steps.Length; index++)
        {
            var number = index + 1;
            var state = number < State.Step ? "done" : number == State.Step ? "current" : "next";

            if (index > 0)
            {
                <li class="booking-progress__line @(number <= State.Step ? "booking-progress__line--done" : "")" aria-hidden="true"></li>
            }

            <li class="booking-progress__step booking-progress__step--@state" aria-current="@(state == "current" ? "step" : null)">
                <span class="booking-progress__mark">
                    @if (state == "done")
                    {
                        <svg width="10" height="8" viewBox="0 0 10 8" fill="none" aria-hidden="true">
                            <path d="M1 4.2l2.6 2.6L9 1.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    }
                    else
                    {
                        @number
                    }
                </span>
                <span class="booking-progress__label">@LocalizationService.GetString(steps[index])</span>
            </li>
        }
    </ol>

    @if (State.Step > 1 && State.HasSession)
    {
        <div class="booking-chips">
            <span class="booking-chip">
                <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <rect x="1.5" y="2.5" width="9" height="8" rx="1.5" stroke="currentColor" stroke-width="1" />
                    <path d="M1.5 5h9M4 1.5v2M8 1.5v2" stroke="currentColor" stroke-width="1" stroke-linecap="round" />
                </svg>
                @BookingTimeHelper.FormatDayMonth(State.Date!.Value) · @BookingTimeHelper.FormatTimeRange(State.StartTime!.Value, State.Duration!.Value) · @BookingTimeHelper.FormatDuration(State.Duration!.Value, LocalizationService)
            </span>
            @if (State.Step > 2 && State.Offer is { } offer)
            {
                <span class="booking-chip">
                    <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                        <rect x="1.5" y="2" width="9" height="6" rx="1" stroke="currentColor" stroke-width="1" />
                        <path d="M4.5 10.5h3M6 8v2.5" stroke="currentColor" stroke-width="1" stroke-linecap="round" />
                    </svg>
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_PCS_CHIP), offer.Hosts.Count)
                </span>
            }
        </div>
    }
</header>
