@using Gizmo.Go.UI.View.States.Pages
@{
    var count = State.SelectedHostIds.Count;
    var duration = BookingTimeHelper.FormatDuration(State.Duration ?? 0, LocalizationService);
}

@if (count == 0)
{
    <div class="booking-bar">
        <button type="button" class="booking-action" disabled>
            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_TO_CONFIRM))
        </button>
    </div>
}
else
{
    <div class="booking-selection">
        <div class="booking-selection__panel">
            <div class="booking-selection__header">
                <svg class="booking-selection__icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <rect x="1.5" y="2" width="11" height="7.5" rx="1.2" stroke="currentColor" stroke-width="1.1" />
                    <path d="M5 12h4M7 9.5V12" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" />
                </svg>

                <div class="booking-selection__summary">
                    <span class="booking-selection__count">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_SELECTED_COUNT), count)</span>
                    <button type="button" class="booking-selection__clear" disabled="@State.IsBusy" @onclick="Service.ClearHosts">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_CLEAR_ALL))
                    </button>
                </div>

                <div class="booking-selection__total">
                    <span class="booking-selection__sum">@ReservationDisplayHelper.FormatAmount(State.SelectedTotal)</span>
                    <span class="booking-selection__for">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_FOR_DURATION), duration)</span>
                </div>

                <button type="button"
                        class="booking-selection__toggle"
                        aria-label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_SELECTED_COUNT), count)"
                        aria-expanded="@State.IsSummaryExpanded.ToString().ToLowerInvariant()"
                        @onclick="Service.ToggleSummary">
                    <svg class="booking-selection__chevron @(State.IsSummaryExpanded ? "" : "booking-selection__chevron--up")" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                        <path d="M3.5 5.25L7 8.75l3.5-3.5" stroke="currentColor" stroke-width="1.17" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>
            </div>

            @if (State.IsSummaryExpanded)
            {
                <ul class="booking-selection__list">
                    @foreach (var hostId in State.SelectedHostIds)
                    {
                        var id = hostId;
                        var host = State.GetHost(id);
                        if (host is null)
                        {
                            continue;
                        }

                        // a club without halls has only the "All PCs" tab, which is not a hall name
                        var hall = State.Tabs.FirstOrDefault(tab => tab.Key != BookingTab.AllKey && tab.Hosts.Any(item => item.Host.Id == id))?.Name;
                        var groupName = State.GetGroupName(host.HostGroupId);
                        var rate = BookingTimeHelper.FormatRate(State.GetHourlyRate(host.HostGroupId), LocalizationService);
                        var details = string.Join(" · ", new[] { hall, groupName }.Where(text => !string.IsNullOrEmpty(text)));

                        <li class="booking-selection__item booking-group-color--@State.GetGroupColor(host.HostGroupId)">
                            <span class="booking-selection__dot"></span>
                            <span class="booking-selection__text">
                                <span class="booking-selection__host">@BookingTimeHelper.FormatHost(host.Number, LocalizationService)</span>
                                <span class="booking-selection__details">@details</span>
                            </span>
                            <span class="booking-selection__price">
                                <span class="booking-selection__amount">@ReservationDisplayHelper.FormatAmount(State.GetPrice(host.HostGroupId) ?? 0)</span>
                                @if (rate.Length > 0)
                                {
                                    <span class="booking-selection__rate">@rate</span>
                                }
                            </span>
                            <button type="button" class="booking-selection__remove" aria-label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_REMOVE))" disabled="@State.IsBusy" @onclick="() => Service.ToggleHost(id)">
                                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                                    <path d="M2.5 2.5l7 7M9.5 2.5l-7 7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                                </svg>
                            </button>
                        </li>
                    }
                </ul>
            }

            <div class="booking-selection__footer">
                <button type="button" class="booking-action" disabled="@State.IsBusy" @onclick="Service.ContinueAsync">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_TO_CONFIRM))
                </button>
            </div>
        </div>
    </div>
}
