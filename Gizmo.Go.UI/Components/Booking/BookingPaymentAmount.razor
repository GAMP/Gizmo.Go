@using Gizmo.Go.UI.View.States.Pages
@{
    var offer = State.Offer!;
    var isFree = offer.Total == 0;
    var showMinimum = !isFree && offer.MinimumPayment < offer.Total;
    var isMinimum = State.AmountKind == BookingAmountKind.Minimum && showMinimum;
    var rest = offer.Total - offer.MinimumPayment;
}

<div class="booking-block">
    <h3 class="booking-block__label">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_AMOUNT_TITLE))</h3>

    <div class="booking-options" role="radiogroup">
        @if (isFree)
        {
            <div class="booking-option booking-option--selected" role="radio" aria-checked="true">
                <span class="booking-option__radio"></span>
                <span class="booking-option__text">
                    <span class="booking-option__title">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_AMOUNT_NONE))</span>
                    <span class="booking-option__sub">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_AMOUNT_NONE_SUB))</span>
                </span>
            </div>
        }
        else
        {
            if (showMinimum)
            {
                <button type="button" class="booking-option @(isMinimum ? "booking-option--selected" : "")" role="radio" aria-checked="@isMinimum.ToString().ToLowerInvariant()" @onclick="() => Service.SelectAmountKind(BookingAmountKind.Minimum)">
                    <span class="booking-option__radio"></span>
                    <span class="booking-option__text">
                        @if (offer.MinimumPayment == 0)
                        {
                            <span class="booking-option__title">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_AMOUNT_NONE))</span>
                            <span class="booking-option__sub">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_AMOUNT_NONE_SUB))</span>
                        }
                        else
                        {
                            <span class="booking-option__line">
                                <span class="booking-option__title">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_AMOUNT_MINIMUM))</span>
                                <span class="booking-option__amount">@ReservationDisplayHelper.FormatAmount(offer.MinimumPayment)</span>
                            </span>
                            <span class="booking-option__sub">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_AMOUNT_MINIMUM_SUB), ReservationDisplayHelper.FormatAmount(rest))</span>
                        }
                    </span>
                </button>
            }

            <button type="button" class="booking-option @(!isMinimum ? "booking-option--selected" : "")" role="radio" aria-checked="@((!isMinimum).ToString().ToLowerInvariant())" @onclick="() => Service.SelectAmountKind(BookingAmountKind.Full)">
                <span class="booking-option__radio"></span>
                <span class="booking-option__text">
                    <span class="booking-option__line">
                        <span class="booking-option__title">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_AMOUNT_FULL))</span>
                        <span class="booking-option__amount">@ReservationDisplayHelper.FormatAmount(offer.Total)</span>
                    </span>
                    <span class="booking-option__sub">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_AMOUNT_FULL_SUB))</span>
                </span>
            </button>
        }
    </div>
</div>
