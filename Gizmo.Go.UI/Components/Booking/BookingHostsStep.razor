@{
    var tab = State.Tabs.FirstOrDefault(item => item.Key == State.SelectedTabKey);
    var hintKey = State.IsMapView
        ? nameof(Autogenerated.Resources.GO_BOOKING_HINT_MAP)
        : nameof(Autogenerated.Resources.GO_BOOKING_HINT_LIST);
}

<section class="booking-step booking-hosts">
    @if (State.Tabs.Count > 0)
    {
        <div class="booking-hosts__toolbar">
            <BookingHallTabs State="State" />

            <div class="booking-view-toggle" role="group">
                <button type="button"
                        class="booking-view-toggle__button @(State.IsMapView ? "booking-view-toggle__button--active" : "")"
                        aria-label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_VIEW_MAP))"
                        aria-pressed="@State.IsMapView.ToString().ToLowerInvariant()"
                        @onclick="() => Service.SetMapView(true)">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                        <rect x="1" y="1" width="4" height="4" rx="1" stroke="currentColor" stroke-width="1" />
                        <rect x="7" y="1" width="4" height="4" rx="1" stroke="currentColor" stroke-width="1" />
                        <rect x="1" y="7" width="4" height="4" rx="1" stroke="currentColor" stroke-width="1" />
                        <rect x="7" y="7" width="4" height="4" rx="1" stroke="currentColor" stroke-width="1" />
                    </svg>
                </button>
                <button type="button"
                        class="booking-view-toggle__button @(!State.IsMapView ? "booking-view-toggle__button--active" : "")"
                        aria-label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_VIEW_LIST))"
                        aria-pressed="@((!State.IsMapView).ToString().ToLowerInvariant())"
                        @onclick="() => Service.SetMapView(false)">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                        <path d="M4 3h7M4 6h7M4 9h7M1.5 3h.01M1.5 6h.01M1.5 9h.01" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" />
                    </svg>
                </button>
            </div>
        </div>
    }

    @if (State.IsMapView)
    {
        if (tab is not null)
        {
            <BookingHostMap State="State" Tab="tab" />
        }
    }
    else
    {
        <BookingHostList State="State" />
    }

    <BookingLegend State="State" />

    @if (State.SelectedHostIds.Count == 0)
    {
        <p class="booking-hosts__hint">@LocalizationService.GetString(hintKey)</p>
    }

    @if (State.HasActionError)
    {
        <ErrorBlock Message="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_LOAD_ERROR))" OnRetry="Service.RetryAsync" />
    }

    <BookingSelectionSummary State="State" />
</section>
