@{
    var offer = State.Offer!;
    var club = State.Club.Value!.Branch;
    var amount = State.PaymentAmount ?? 0;
    var hasDeposit = State.Balance.Value is not null;
    var canPay = amount == 0 || (hasDeposit && State.Balance.Value!.Deposits >= amount);
    var duration = BookingTimeHelper.FormatDuration(State.Duration!.Value, LocalizationService);
}

<section class="booking-step booking-confirm">
    <div class="booking-confirm__intro">
        <h2 class="booking-confirm__title">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_CONFIRM_TITLE))</h2>
        <p class="booking-confirm__text">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_CONFIRM_TEXT))</p>
    </div>

    <dl class="booking-details">
        <div class="booking-details__row">
            <span class="booking-details__icon">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                    <circle cx="12" cy="10" r="3" />
                </svg>
            </span>
            <dt>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_DETAIL_CLUB))</dt>
            <dd>@club.Name</dd>
        </div>
        <div class="booking-details__row">
            <span class="booking-details__icon">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="4" width="18" height="18" rx="2" />
                    <path d="M16 2v4M8 2v4M3 10h18" />
                </svg>
            </span>
            <dt>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_DETAIL_DATE))</dt>
            <dd>@BookingTimeHelper.FormatFullDate(State.Date!.Value)</dd>
        </div>
        <div class="booking-details__row">
            <span class="booking-details__icon">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v5l3 2" />
                </svg>
            </span>
            <dt>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_DETAIL_TIME))</dt>
            <dd>@BookingTimeHelper.FormatTimeRange(State.StartTime!.Value, State.Duration!.Value)</dd>
        </div>
        <div class="booking-details__row">
            <span class="booking-details__icon">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z" />
                </svg>
            </span>
            <dt>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_DETAIL_SESSION))</dt>
            <dd>@duration</dd>
        </div>
        <div class="booking-details__row">
            <span class="booking-details__icon">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2" y="3" width="20" height="14" rx="2" />
                    <path d="M8 21h8M12 17v4" />
                </svg>
            </span>
            <dt>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_DETAIL_PCS))</dt>
            <dd>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_PCS_COUNT), offer.Hosts.Count)</dd>
        </div>
    </dl>

    <BookingCostBreakdown State="State" />

    <button type="button" class="club-page__row" @onclick="Service.ShowBookingRulesAsync">
        <span class="club-page__row-icon">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            </svg>
        </span>
        <span class="club-page__row-text">
            <span class="club-page__row-title">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CLUB_RULES_BOOKING))</span>
            <span class="club-page__row-hint">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_NO_API_DATA))</span>
        </span>
        <svg class="club-page__row-chevron" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
    </button>

    <BookingPaymentAmount State="State" />

    <p class="booking-warning">
        <svg class="booking-warning__icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" />
            <path d="M12 9v4M12 17h.01" />
        </svg>
        <span>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_WARNING))</span>
    </p>

    @if (amount > 0)
    {
        <BookingPaymentMethods State="State" />
    }

    @if (State.HasActionError)
    {
        <ErrorBlock Message="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_LOAD_ERROR))" OnRetry="Service.RetryAsync" />
    }

    <div class="booking-footer">
        <div class="booking-footer__total">
            <span class="booking-footer__info">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_FOOTER_INFO), offer.Hosts.Count, duration)</span>
            <span class="booking-footer__amount">@ReservationDisplayHelper.FormatAmount(offer.Total)</span>
        </div>
        <button type="button" class="booking-action" disabled="@(State.IsBusy || !canPay)" @onclick="Service.BookAsync">
            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_BOOK))
        </button>
    </div>
</section>
