<div class="booking-list">
    @foreach (var hall in State.Tabs)
    {
        var free = hall.Hosts.Count(item => State.FreeHostIds.Contains(item.Host.Id));

        <section class="booking-list__section">
            <div class="booking-list__heading">
                <h3 class="booking-list__hall">@hall.Name</h3>
                <span class="booking-list__free">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_FREE_COUNT), free)</span>
            </div>

            @foreach (var item in hall.Hosts.OrderBy(entry => entry.Host.Number))
            {
                var host = item.Host;
                var hostId = host.Id;
                var isFree = State.FreeHostIds.Contains(hostId);
                var isSelected = State.SelectedHostIds.Contains(hostId);
                var rate = BookingTimeHelper.FormatRate(State.GetHourlyRate(host.HostGroupId), LocalizationService);
                var group = State.GetGroupName(host.HostGroupId);

                <button type="button"
                        class="booking-host-row booking-group-color--@State.GetGroupColor(host.HostGroupId) @(isSelected ? "booking-host-row--selected" : "") @(!isFree ? "booking-host-row--busy" : "")"
                        disabled="@(!isFree || State.IsBusy)"
                        aria-pressed="@isSelected.ToString().ToLowerInvariant()"
                        @onclick="() => Service.ToggleHost(hostId)">
                    <span class="booking-host-row__bar"></span>
                    <span class="booking-host-row__number">@host.Number.ToString("00")</span>
                    <span class="booking-host-row__text">
                        <span class="booking-host-row__name">@host.Name</span>
                        <span class="booking-host-row__group">
                            <span class="booking-host-row__dot"></span>
                            @(rate.Length > 0 ? $"{group} · {rate}" : group)
                        </span>
                    </span>
                    @if (isFree)
                    {
                        <span class="booking-host-row__mark">
                            @if (isSelected)
                            {
                                <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                                    <path d="M2.5 6.2l2.4 2.4 4.6-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            }
                        </span>
                    }
                    else
                    {
                        <span class="booking-host-row__busy">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_LEGEND_BUSY))</span>
                    }
                </button>
            }
        </section>
    }
</div>
