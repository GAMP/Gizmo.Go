@{
    var amount = State.PaymentAmount ?? 0;
    var deposit = State.Balance.Value?.Deposits;
    var isEnough = deposit is { } value && value >= amount;
}

<div class="booking-block">
    <h3 class="booking-block__label">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_METHOD_TITLE))</h3>

    <div class="booking-options" role="radiogroup">
        <div class="booking-option booking-option--selected" role="radio" aria-checked="true">
            <span class="booking-option__radio"></span>
            <span class="booking-option__text">
                <span class="booking-option__title">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_METHOD_BALANCE))</span>
                @if (State.Balance.HasError)
                {
                    <span class="booking-option__sub booking-option__sub--error">
                        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_LOAD_ERROR))
                        <button type="button" class="booking-option__retry" @onclick="Service.RetryBalanceAsync">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_ERROR_BLOCK_RETRY))</button>
                    </span>
                }
                else if (deposit is { } balance)
                {
                    <span class="booking-option__sub @(isEnough ? "booking-option__sub--ok" : "booking-option__sub--error")">
                        @if (isEnough)
                        {
                            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_BALANCE_ENOUGH), ReservationDisplayHelper.FormatAmount(balance))
                        }
                        else
                        {
                            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_BALANCE_SHORT), ReservationDisplayHelper.FormatAmount(balance), ReservationDisplayHelper.FormatAmount(amount - balance))
                        }
                    </span>
                }
            </span>
            <span class="booking-option__icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 7H5a2 2 0 0 1 0-4h13v4" />
                    <path d="M3 5v14a2 2 0 0 0 2 2h15V7" />
                    <path d="M16 14h.01" />
                </svg>
            </span>
        </div>

        <div class="booking-option booking-option--inactive" role="radio" aria-checked="false" aria-disabled="true">
            <span class="booking-option__radio"></span>
            <span class="booking-option__text">
                <span class="booking-option__title">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_METHOD_TOPUP))</span>
                <span class="booking-option__sub">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_METHOD_TOPUP_SUB))</span>
            </span>
            <span class="booking-option__icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M17 7 7 17M17 17H7V7" />
                </svg>
            </span>
        </div>

        <div class="booking-option booking-option--inactive" role="radio" aria-checked="false" aria-disabled="true">
            <span class="booking-option__radio"></span>
            <span class="booking-option__text">
                <span class="booking-option__title">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_METHOD_PAY))</span>
                <span class="booking-option__sub">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_METHOD_PAY_SUB))</span>
            </span>
            <span class="booking-option__icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2" y="5" width="20" height="14" rx="2" />
                    <path d="M2 10h20" />
                </svg>
            </span>
        </div>
    </div>
</div>
