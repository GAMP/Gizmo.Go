@{
    var groupIds = State.Halls?.HostGroups
        .Select(group => group.Id)
        .OrderBy(id => State.GetGroupName(id), StringComparer.CurrentCulture)
        .ToList() ?? [];
}

<div class="booking-legend">
    <div class="booking-legend__states">
        <span class="booking-legend__state">
            <span class="booking-legend__swatch"></span>
            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_LEGEND_FREE))
        </span>
        <span class="booking-legend__state">
            <span class="booking-legend__swatch booking-legend__swatch--selected">
                <svg width="8" height="8" viewBox="0 0 8 8" fill="none" aria-hidden="true">
                    <path d="M1.5 4.1l1.6 1.6L6.5 2.3" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>
            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_LEGEND_SELECTED))
        </span>
        <span class="booking-legend__state">
            <span class="booking-legend__swatch booking-legend__swatch--busy"></span>
            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_LEGEND_BUSY))
        </span>
        <span class="booking-legend__note">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_LEGEND_COLOR))</span>
    </div>

    <div class="booking-legend__groups">
        @foreach (var groupId in groupIds)
        {
            var rate = BookingTimeHelper.FormatRate(State.GetHourlyRate(groupId), LocalizationService);

            <span class="booking-group-chip booking-group-color--@State.GetGroupColor(groupId)">
                <span class="booking-group-chip__dot"></span>
                @(rate.Length > 0 ? $"{State.GetGroupName(groupId)} · {rate}" : State.GetGroupName(groupId))
            </span>
        }
    </div>
</div>
