<div class="confirmation-body">

    <ErrorBlock Message="@ErrorMessage" ShowHomeLink="true" />

    <div class="auth-hero">
        <h1 class="auth-hero__title">@Title</h1>
        <p class="auth-hero__subtitle">@Subtitle</p>
    </div>

    <OtpDigitGroup Digits="@Digits"
                   OnDigitChanged="@OnDigitChanged"
                   OnDigitCleared="@OnDigitCleared"
                   AriaGroupLabel="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_OTP_GROUP_ARIA), Digits.Length)"
                   AriaLabelForIndex="@(i => LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_OTP_DIGIT_ARIA), i))" />

    <div class="confirmation-actions">
        <div class="confirmation-resend-row">
            @if (!TimerExpired)
            {
                <p class="confirmation-timer">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_TIMER_PREFIX))<CountdownDisplay Seconds="@SecondsLeft" />
                </p>
            }
            else
            {
                <button type="button" class="confirmation-resend-btn" @onclick="OnResend">
                    @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_RESEND))
                </button>
            }
            <button type="button" class="confirmation-change-number-btn" @onclick="OnChange">
                @ChangeText
            </button>
        </div>

        <p class="confirmation-hint">@Hint</p>
    </div>

    <button type="button"
            class="auth-submit"
            disabled="@(!CanSubmit || IsLoading)"
            @onclick="OnConfirm">
        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CONFIRMATION_SUBMIT))
    </button>

</div>
