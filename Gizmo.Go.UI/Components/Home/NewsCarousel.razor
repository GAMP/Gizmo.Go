@if (IsLoading)
{
    <div class="news-carousel">
        <div class="news-carousel__track">
            <div class="home-skeleton home-skeleton--news"></div>
            <div class="home-skeleton home-skeleton--news"></div>
        </div>
    </div>
}
else if (News is { Count: > 0 })
{
    <div class="news-carousel">
        <div class="news-carousel__track">
            @for (var i = 0; i < News.Count; i++)
            {
                var item = News[i];
                <NewsCard @key="item.Id" Item="item" Index="i" OnClick="OnNewsClick" />
            }

            <button type="button" class="news-card news-card--carousel news-card--all" @onclick="OnAllNewsClick">
                <span class="news-card__content">
                    <span class="news-card__text-block">
                        <span class="news-card__title">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_HOME_ALL_NEWS))</span>
                        <span class="news-card__text">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_HOME_ALL_NEWS_TEXT))</span>
                    </span>
                    <span class="news-card__footer">
                        <svg class="news-card__arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M9 12h6M12.5 9l3 3-3 3" />
                        </svg>
                    </span>
                </span>
            </button>
        </div>
    </div>
}
