<div class="balance-cards">
    <div class="balance-card balance-card--main">
        <div class="balance-card__body">
            <span class="balance-card__label">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_HOME_MAIN_BALANCE))</span>
            @if (IsLoading)
            {
                <span class="home-skeleton home-skeleton--text"></span>
            }
            else
            {
                <span class="balance-card__value">@MainBalanceText</span>
            }
        </div>
        @* inactive: top up is not implemented yet *@
        <button type="button"
                class="balance-card__add"
                aria-label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_HOME_TOP_UP))">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <path d="M9 3v12M3 9h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
        </button>
    </div>

    <div class="balance-card balance-card--bonuses">
        <div class="balance-card__body">
            <span class="balance-card__label">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_HOME_BONUSES))</span>
            @if (IsLoading)
            {
                <span class="home-skeleton home-skeleton--text"></span>
            }
            else
            {
                <span class="balance-card__value">
                    <svg class="balance-card__bolt" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M13 2L4 14h6l-1 8 9-12h-6z" />
                    </svg>
                    @BonusesText
                </span>
            }
        </div>
    </div>
</div>
