<article class="club-card">
    <div class="club-card__row">
        <div class="club-card__thumb">
            @if (!string.IsNullOrEmpty(Club.ImageUrl))
            {
                <img class="club-card__image" src="@Club.ImageUrl" alt="" loading="lazy" />
            }
        </div>

        <div class="club-card__info">
            <div class="club-card__heading">
                <h3 class="club-card__name">@Club.Name</h3>
                @if (IsOpen is { } isOpen)
                {
                    <span class="club-card__state @(isOpen ? "club-card__state--open" : "club-card__state--closed")">
                        @LocalizationService.GetString(isOpen ? nameof(Autogenerated.Resources.GO_HOME_CLUB_OPEN) : nameof(Autogenerated.Resources.GO_HOME_CLUB_CLOSED))
                    </span>
                }
            </div>

            <div class="club-card__details">
                @if (!string.IsNullOrEmpty(Club.Address))
                {
                    <div class="club-card__address">@Club.Address</div>
                }
                @if (!string.IsNullOrEmpty(HoursText))
                {
                    <div class="club-card__hours">
                        <svg width="13" height="13" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="0.92" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="7" cy="7" r="5.25" />
                            <path d="M7 4.5V7l1.5 1.5" />
                        </svg>
                        <span>@HoursText</span>
                    </div>
                }
            </div>
        </div>
    </div>

    @* inactive: booking is not implemented yet *@
    <button type="button" class="club-card__book">
        @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_HOME_CLUB_BOOK))
    </button>
</article>
