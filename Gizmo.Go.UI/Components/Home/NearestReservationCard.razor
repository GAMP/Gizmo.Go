@using Gizmo.Go.Core.Models.Reservation
@if (IsLoading || Reservation is null)
{
    <div class="home-skeleton home-skeleton--reservation"></div>
}
else
{
    <div class="reservation-card @(Reservation.Status == GoReservationStatus.Active ? "reservation-card--active" : "")">
        <div class="reservation-card__top">
            <div class="reservation-card__title">
                <span class="reservation-card__dot"></span>
                <span>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_HOME_NEAREST_RESERVATION))</span>
            </div>
            @if (!string.IsNullOrEmpty(HostName))
            {
                <span class="reservation-card__host">@HostName</span>
            }
        </div>

        <div class="reservation-card__body">
            <div class="reservation-card__club">
                <div class="reservation-card__club-name">@Reservation.BranchName</div>
                @if (!string.IsNullOrEmpty(Reservation.BranchAddress))
                {
                    <div class="reservation-card__club-address">@Reservation.BranchAddress</div>
                }
            </div>
            <div class="reservation-card__when">
                <div class="reservation-card__day">@DayText</div>
                <div class="reservation-card__time">@TimeText</div>
                @if (ShowClubTimeHint)
                {
                    <div class="reservation-card__hint">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_RESERVATIONS_CLUB_TIME))</div>
                }
            </div>
        </div>

        <div class="reservation-card__footer">
            <span class="reservation-card__status @StatusModifier">@StatusText</span>
            <button type="button" class="reservation-card__open" @onclick="OnOpen">
                <span>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_HOME_OPEN_RESERVATION))</span>
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M5.5 3.5L9 7l-3.5 3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </button>
        </div>
    </div>
}
