<section class="club-schedule">
    <button type="button" class="club-schedule__summary" aria-expanded="@IsExpanded.ToString().ToLowerInvariant()" @onclick="OnToggle">
        <span class="club-schedule__icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 7v5l3 2" />
            </svg>
        </span>
        <span class="club-schedule__text">
            <span class="club-schedule__today">
                <span>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CLUB_TODAY), TodayText)</span>
                @if (IsOpen is { } isOpen)
                {
                    <span class="club-schedule__dot @(isOpen ? "club-schedule__dot--open" : "club-schedule__dot--closed")" aria-hidden="true"></span>
                }
            </span>
            <span class="club-schedule__weekday">@DayName(Today)</span>
        </span>
        <svg class="club-schedule__chevron @(IsExpanded ? "club-schedule__chevron--up" : "")" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M3.5 5.25 7 8.75l3.5-3.5" stroke="currentColor" stroke-width="1.17" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
    </button>

    @if (IsExpanded)
    {
        <ul class="club-schedule__week">
            @foreach (var day in WeekDays)
            {
                <li class="club-schedule__day @(day == Today ? "club-schedule__day--today" : "")">
                    <span class="club-schedule__day-name">@ShortDayName(day)</span>
                    <span class="club-schedule__day-hours">@DayHours(day)</span>
                </li>
            }
        </ul>
    }
</section>
