<header class="auth-header @(string.IsNullOrEmpty(BackText) && string.IsNullOrEmpty(_iconCls) ? "" : "auth-header--with-back")">
    <button type="button"
            class="auth-back-btn @_iconCls"
            @onclick="OnBack"
            aria-label="@AriaLabel">
        @if (IconShape == BackIconShape.Circle)
        {
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M10 4L6 8l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        }
        else
        {
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M12.5 6.25L8.75 10l3.75 3.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        }
        @if (!string.IsNullOrEmpty(BackText))
        {
            <span>@BackText</span>
        }
    </button>
    @if (Trailing is not null)
    {
        @Trailing
    }
    else
    {
        <LangButton />
    }
</header>
