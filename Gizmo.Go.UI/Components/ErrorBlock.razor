@inject Gizmo.UI.Services.ILocalizationService LocalizationService
@inject Gizmo.Go.UI.View.Services.WelcomeViewService WelcomeViewService

@if (!string.IsNullOrEmpty(Message))
{
    <div class="giz-error-block" role="alert">
        <span>@Message</span>
        @if (ShowHomeLink)
        {
            <button type="button" class="giz-error-block__link" @onclick="GoHomeAsync">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_ERROR_BLOCK_GO_HOME))
            </button>
        }
    </div>
}
