@inject Gizmo.UI.Services.ILocalizationService LocalizationService

@if (!string.IsNullOrEmpty(Message))
{
    <div class="giz-error-block" role="alert">
        <span>@Message</span>
        @if (OnRetry.HasDelegate)
        {
            <button type="button" class="giz-error-block__link" @onclick="OnRetry">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_ERROR_BLOCK_RETRY))
            </button>
        }
        @if (ShowHomeLink)
        {
            <button type="button" class="giz-error-block__link" @onclick="GoHome">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_ERROR_BLOCK_GO_HOME))
            </button>
        }
    </div>
}
