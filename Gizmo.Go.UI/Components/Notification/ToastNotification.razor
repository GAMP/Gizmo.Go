<div class="giz-toast @TypeClass @(Route is null ? null : "giz-toast--link")" role="@(Route is null ? null : "button")" @onclick="OnOpen">
    <span class="giz-toast__message">@Message</span>
    @if (Route is not null)
    {
        @* the whole toast opens the route, the label only shows that it can be tapped *@
        <span class="giz-toast__details">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_NOTIFY_DETAILS)) ›</span>
    }
    <button class="giz-toast__close" type="button" @onclick="OnDismiss" @onclick:stopPropagation="true">&times;</button>
</div>
