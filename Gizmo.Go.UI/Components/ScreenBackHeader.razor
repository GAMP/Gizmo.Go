<header class="screen-back-header @(IsCentered ? "screen-back-header--centered" : "") @(IsOverlay ? "screen-back-header--overlay" : "")">
    <button type="button" class="screen-back-header__back" aria-label="@AriaLabel" @onclick="OnBack">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M11 4.5L6.5 9l4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
    </button>
    @if (!string.IsNullOrEmpty(Title))
    {
        <h1 class="screen-back-header__title">@Title</h1>
    }
</header>
