@inject Gizmo.UI.Services.ILocalizationService LocalizationService

<button type="button" class="auth-field__eye" @onclick="OnToggle" aria-label="@(Visible ? LocalizationService.GetString(nameof(Autogenerated.Resources.GO_EYE_TOGGLE_HIDE)) : LocalizationService.GetString(nameof(Autogenerated.Resources.GO_EYE_TOGGLE_SHOW)))">
    @if (Visible)
    {
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M1 9s3.273-6 8-6 8 6 8 6-3.273 6-8 6-8-6-8-6z" stroke="#aaabad" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            <circle cx="9" cy="9" r="2.5" stroke="#aaabad" stroke-width="1.5" />
        </svg>
    }
    else
    {
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M13.45 13.45C12.19 14.3 10.64 14.875 9 14.875c-5 0-8-6-8-6a14.78 14.78 0 0 1 3.55-4.45M7.27 3.27A7.74 7.74 0 0 1 9 3.125c5 0 8 6 8 6a14.79 14.79 0 0 1-1.87 2.78M10.73 10.73A2.5 2.5 0 0 1 7.27 7.27" stroke="#aaabad" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M1.5 1.5l15 15" stroke="#aaabad" stroke-width="1.5" stroke-linecap="round" />
        </svg>
    }
</button>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }
}
