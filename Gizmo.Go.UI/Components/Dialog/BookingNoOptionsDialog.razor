<div class="giz-dialog__card giz-booking-dialog giz-booking-dialog--no-options" role="alertdialog" @onclick:stopPropagation="true">
    <div class="giz-booking-dialog__text-block">
        <span class="giz-booking-dialog__caption">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_NO_OPTIONS_CAPTION))</span>
        <div class="giz-booking-dialog__title">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_NO_OPTIONS_TITLE))</div>
        <div class="giz-booking-dialog__text giz-booking-dialog__text--main">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_NO_OPTIONS_TEXT))</div>
        <div class="giz-booking-dialog__text">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_NO_OPTIONS_HINT))</div>
    </div>
    <div class="giz-booking-dialog__actions">
        <button type="button" class="giz-booking-dialog__button giz-booking-dialog__button--primary" @onclick="ChooseTimeAsync">
            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_CHOOSE_OTHER_TIME))
        </button>
        <button type="button" class="giz-booking-dialog__button giz-booking-dialog__button--link" @onclick="CloseAsync">
            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_CLOSE))
        </button>
    </div>
</div>
