<div class="giz-dialog__card giz-booking-dialog giz-booking-dialog--center giz-booking-dialog--success" role="alertdialog" @onclick:stopPropagation="true">
    <span class="giz-booking-dialog__icon giz-booking-dialog__icon--success">
        <svg width="36" height="36" viewBox="0 0 36 36" fill="none" aria-hidden="true">
            <path d="M6 18.5l7.5 7.5L30 9.5" stroke="currentColor" stroke-width="3.75" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
    </span>

    <div class="giz-booking-dialog__text-block">
        <div class="giz-booking-dialog__title">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_SUCCESS_TITLE))</div>
        <div class="giz-booking-dialog__text">@Hosts · @Period</div>
    </div>

    <div class="giz-booking-dialog__facts">
        <div class="giz-booking-dialog__fact">
            <span>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_SUCCESS_COST))</span>
            <span class="giz-booking-dialog__fact-value">@Cost</span>
        </div>
        <div class="giz-booking-dialog__pin">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z" />
            </svg>
            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_SUCCESS_PIN))
        </div>
    </div>

    <div class="giz-booking-dialog__actions">
        <button type="button" class="giz-booking-dialog__button giz-booking-dialog__button--primary" @onclick="OpenReservationAsync">
            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_SUCCESS_RESERVATIONS))
        </button>
        <button type="button" class="giz-booking-dialog__button" @onclick="GoHomeAsync">
            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_SUCCESS_HOME))
        </button>
    </div>
</div>
