<div class="giz-dialog__card giz-confirm-dialog" role="alertdialog" aria-labelledby="confirm-dialog-title" @onclick:stopPropagation="true">
    <div class="giz-confirm-dialog__text-block">
        <div class="giz-confirm-dialog__title" id="confirm-dialog-title">@Title</div>
        <div class="giz-confirm-dialog__text">@Text</div>
    </div>
    <div class="giz-confirm-dialog__actions">
        <button type="button" class="giz-confirm-dialog__button giz-confirm-dialog__button--primary @(IsDanger ? "giz-confirm-dialog__button--danger" : "")" @onclick="ConfirmAsync">
            @ConfirmText
        </button>
        <button type="button" class="giz-confirm-dialog__button" @onclick="CancelAsync">
            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_CANCEL))
        </button>
    </div>
</div>
