<div class="giz-dialog__card giz-user-agreement-dialog">
    <div class="giz-dialog__header">
        <div class="giz-dialog__title">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_USER_AGREEMENT_DIALOG_TITLE))</div>
        <div class="giz-dialog__subtitle">@Name</div>
    </div>
    <div class="giz-dialog__body">
        <div class="giz-user-agreement">
            @((MarkupString)Agreement)
        </div>
    </div>
    <div class="giz-dialog__footer">
        <label class="giz-dialog__checkbox @(IsRejectable ? "" : "giz-dialog__checkbox--required")">
            <input type="checkbox"
                   checked="@_accepted"
                   @onchange="OnAcceptedChanged" />
            <span>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_USER_AGREEMENT_DIALOG_AGREE_CHECKBOX))</span>
        </label>
        <button type="button"
                class="auth-submit"
                disabled="@(!AllowContinueWithoutAccept && !IsRejectable && !_accepted)"
                @onclick="ContinueAsync">
            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_CONTINUE))
        </button>
    </div>
</div>
