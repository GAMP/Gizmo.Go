<div class="giz-dialog__card giz-user-agreement-dialog giz-dialog__card--agreement">
    <div class="giz-dialog__header giz-dialog__header--row">
        <div class="giz-dialog__title">@Name</div>
        <button type="button"
                class="giz-dialog__close"
                aria-label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_CLOSE))"
                @onclick="CloseAsync">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2 2L12 12M12 2L2 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
        </button>
    </div>
    <div class="giz-dialog__body">
        <div class="giz-user-agreement">
            @((MarkupString)Agreement)
        </div>
    </div>
    <div class="giz-dialog__footer">
        @if (IsReadOnly)
        {
            <button type="button"
                    class="auth-submit"
                    @onclick="ContinueAsync">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_GOT_IT))
            </button>
        }
        else
        {
            <label class="giz-dialog__checkbox @(IsRejectable ? "" : "giz-dialog__checkbox--required")">
                <input type="checkbox"
                       checked="@_accepted"
                       @onchange="OnAcceptedChanged" />
                <span>@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_USER_AGREEMENT_DIALOG_AGREE_CHECKBOX))</span>
            </label>
            <button type="button"
                    class="auth-submit"
                    disabled="@(!IsRejectable && !_accepted)"
                    @onclick="ContinueAsync">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_CONTINUE))
            </button>
        }
    </div>
</div>
