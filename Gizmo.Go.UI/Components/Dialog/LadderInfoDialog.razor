<div class="giz-dialog__card giz-dialog__card--agreement giz-ladder-info-dialog" @onclick:stopPropagation="true">
    <div class="giz-dialog__header giz-dialog__header--row">
        <div class="giz-ladder-info-dialog__heading-block">
            <div class="giz-ladder-info-dialog__title">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_LADDER_INFO_TITLE))</div>
            <p class="giz-ladder-info-dialog__intro">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_LADDER_INFO_INTRO))</p>
        </div>
        <button type="button"
                class="giz-dialog__close"
                aria-label="@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_CLOSE))"
                @onclick="CloseAsync">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2 2L12 12M12 2L2 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
        </button>
    </div>
    <div class="giz-dialog__body">
        <section class="giz-ladder-info-dialog__section">
            <svg class="giz-ladder-info-dialog__icon" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 20h4v-6H3zM10 20h4V9h-4zM17 20h4V4h-4z" />
            </svg>
            <h3 class="giz-ladder-info-dialog__heading">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_LADDER_INFO_LEVELS_TITLE))</h3>
            <p class="giz-ladder-info-dialog__text">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_LADDER_INFO_LEVELS_TEXT))</p>
        </section>

        <section class="giz-ladder-info-dialog__section">
            <svg class="giz-ladder-info-dialog__icon" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="5" width="18" height="16" rx="2" />
                <path d="M3 10h18M8 3v4M16 3v4" />
            </svg>
            <h3 class="giz-ladder-info-dialog__heading">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_LADDER_INFO_PERIOD_TITLE))</h3>
            <p class="giz-ladder-info-dialog__text">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_LADDER_INFO_PERIOD_TEXT))</p>
        </section>
    </div>
    <div class="giz-dialog__footer">
        <button type="button" class="giz-ladder-info-dialog__button" @onclick="CloseAsync">
            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_GOT_IT))
        </button>
    </div>
</div>
