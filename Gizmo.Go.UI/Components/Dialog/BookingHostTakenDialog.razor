<div class="giz-dialog__card giz-booking-dialog giz-booking-dialog--sheet giz-booking-dialog--taken" role="alertdialog" @onclick:stopPropagation="true">
    <span class="giz-booking-dialog__handle" aria-hidden="true"></span>

    <span class="giz-booking-dialog__alarm" aria-hidden="true">
        <span class="giz-booking-dialog__alarm-ring"></span>
        <span class="giz-booking-dialog__alarm-icon">
            <svg width="26" height="26" viewBox="0 0 26 26" fill="none">
                <path d="M7 7l12 12M19 7L7 19" stroke="currentColor" stroke-width="2.7" stroke-linecap="round" />
            </svg>
        </span>
    </span>

    <div class="giz-booking-dialog__text-block">
        <div class="giz-booking-dialog__title">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_TAKEN_TITLE))</div>
        <div class="giz-booking-dialog__text">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_TAKEN_TEXT))</div>
    </div>

    @if (Hosts.Count > 0)
    {
        <div class="giz-booking-dialog__hosts">
            <span class="giz-booking-dialog__caption">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_TAKEN_HOSTS))</span>
            @foreach (var host in Hosts)
            {
                <div class="giz-booking-dialog__host booking-group-color--@host.GroupColor">
                    <span class="giz-booking-dialog__host-bar"></span>
                    <span class="giz-booking-dialog__host-number">@host.Number.ToString("00")</span>
                    <span class="giz-booking-dialog__host-text">
                        <span class="giz-booking-dialog__host-name">@host.Name</span>
                        <span class="giz-booking-dialog__host-details">
                            <span class="giz-booking-dialog__host-dot"></span>
                            @host.Details
                        </span>
                    </span>
                    <span class="giz-booking-dialog__host-busy">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_LEGEND_BUSY))</span>
                </div>
            }
        </div>
    }

    <div class="giz-booking-dialog__actions">
        <button type="button" class="giz-booking-dialog__button giz-booking-dialog__button--primary" @onclick="ReturnAsync">
            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_TAKEN_RETURN))
        </button>
        <button type="button" class="giz-booking-dialog__button" @onclick="ChangeTimeAsync">
            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_BOOKING_TAKEN_CHANGE_TIME))
        </button>
    </div>
</div>
