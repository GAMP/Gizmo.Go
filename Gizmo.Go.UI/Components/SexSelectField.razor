@using Gizmo.Go.Core.Models

<div class="auth-field">
    <label class="auth-field__label" for="@Id">@Label</label>
    <div class="auth-field__input-wrap auth-field__input-wrap--select @(IsInvalid ? "auth-field__input-wrap--invalid" : "")">
        <select id="@Id"
                class="auth-field__input"
                value="@Value"
                disabled="@Disabled"
                @onchange="OnChangedAsync">
            <option value="@UserSex.Unspecified">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_SEX_UNSPECIFIED))</option>
            <option value="@UserSex.Male">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_SEX_MALE))</option>
            <option value="@UserSex.Female">@LocalizationService.GetString(nameof(Autogenerated.Resources.GO_GEN_SEX_FEMALE))</option>
        </select>
    </div>
    <ValidationMessage For="@For" />
</div>
