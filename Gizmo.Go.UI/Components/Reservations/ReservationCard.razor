@using Gizmo.Go.Core.Models.Reservation

<article class="reservation-list-card reservation-list-card--@StatusModifier @(IsCompleted ? "reservation-list-card--past" : "")">
    <div class="reservation-list-card__header">
        <div class="reservation-list-card__club">
            <div class="reservation-list-card__club-name">@Reservation.BranchName</div>
            @if (!string.IsNullOrEmpty(Reservation.BranchAddress))
            {
                <div class="reservation-list-card__club-address">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        <circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="2" />
                    </svg>
                    <span>@Reservation.BranchAddress</span>
                </div>
            }
        </div>
        <span class="reservation-list-card__status">
            @switch (Reservation.Status)
            {
                case ReservationStatus.Waiting:
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2" />
                        <path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                    break;
                case ReservationStatus.Canceled:
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" />
                        <path d="m4.9 4.9 14.2 14.2" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                    break;
                case ReservationStatus.Active:
                    break;
                default:
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" />
                        <path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    break;
            }
            <span>@StatusText</span>
        </span>
    </div>

    @if (ShowPayment)
    {
        <div class="reservation-list-card__payment reservation-list-card__payment--@PaymentModifier">
            <div class="reservation-list-card__payment-top">
                <div class="reservation-list-card__payment-head">
                    <span class="reservation-list-card__payment-icon">
                        @switch (Reservation.PaymentStatus)
                        {
                            case ReservationPaymentStatus.NotSatisfied:
                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <path d="m21.7 18-8-14a2 2 0 0 0-3.4 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.7-3Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                                    <path d="M12 9v4M12 17h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                                </svg>
                                break;
                            case ReservationPaymentStatus.PartiallySatisfied:
                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" />
                                    <path d="M12 2a10 10 0 0 0 0 20Z" fill="currentColor" />
                                </svg>
                                break;
                            default:
                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                break;
                        }
                    </span>
                    <div class="reservation-list-card__payment-text">
                        <div class="reservation-list-card__payment-title">@PaymentTitle</div>
                        <div class="reservation-list-card__payment-note">@PaymentNote</div>
                    </div>
                </div>
                <div class="reservation-list-card__payment-amount">@PaymentAmountText</div>
            </div>

            @if (Reservation.PaymentStatus == ReservationPaymentStatus.PartiallySatisfied)
            {
                <div class="reservation-list-card__payment-split">
                    <span class="reservation-list-card__payment-part reservation-list-card__payment-part--paid">
                        <svg width="9" height="9" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        <span>@PaidText</span>
                    </span>
                    <span class="reservation-list-card__payment-part">
                        <svg width="9" height="9" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2.5" />
                            <path d="M12 6v6l4 2" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
                        </svg>
                        <span>@LeftText</span>
                    </span>
                </div>
                <div class="reservation-list-card__payment-rest">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <rect x="4" y="11" width="16" height="11" rx="2" stroke="currentColor" stroke-width="2" />
                        <path d="M8 11V7a4 4 0 0 1 8 0v4" stroke="currentColor" stroke-width="2" />
                    </svg>
                    <span>@Localize(nameof(Autogenerated.Resources.GO_RESERVATIONS_PAY_REST_NOTE))</span>
                </div>
            }
        </div>
    }

    <div class="reservation-list-card__tiles">
        <div class="reservation-list-card__tile">
            <svg class="reservation-list-card__tile-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2" />
                <path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
            <div class="reservation-list-card__tile-text">
                <span class="reservation-list-card__tile-label">@Localize(nameof(Autogenerated.Resources.GO_RESERVATIONS_DATE))</span>
                <span class="reservation-list-card__tile-value">@DateText</span>
            </div>
        </div>
        <div class="reservation-list-card__tile">
            <svg class="reservation-list-card__tile-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" />
                <path d="M12 6v6l4 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
            <div class="reservation-list-card__tile-text">
                <span class="reservation-list-card__tile-label">@Localize(nameof(Autogenerated.Resources.GO_RESERVATIONS_TIME))</span>
                <span class="reservation-list-card__tile-value">@TimeText</span>
                @if (ShowClubTimeHint)
                {
                    <span class="reservation-list-card__tile-hint">@Localize(nameof(Autogenerated.Resources.GO_RESERVATIONS_CLUB_TIME))</span>
                }
            </div>
        </div>
        <div class="reservation-list-card__tile">
            <svg class="reservation-list-card__tile-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
            </svg>
            <div class="reservation-list-card__tile-text">
                <span class="reservation-list-card__tile-label">@Localize(nameof(Autogenerated.Resources.GO_RESERVATIONS_SESSION))</span>
                <span class="reservation-list-card__tile-value">@DurationText</span>
            </div>
        </div>
        <div class="reservation-list-card__tile @(IsCostStruck ? "reservation-list-card__tile--struck" : "")">
            <span class="reservation-list-card__tile-currency" aria-hidden="true">@CurrencySymbol</span>
            <div class="reservation-list-card__tile-text">
                <span class="reservation-list-card__tile-label">@Localize(nameof(Autogenerated.Resources.GO_RESERVATIONS_COST))</span>
                <span class="reservation-list-card__tile-value reservation-list-card__tile-value--cost">@CostText</span>
            </div>
        </div>
    </div>

    @if (ShowPin)
    {
        <div class="reservation-list-card__pin">
            <span class="reservation-list-card__pin-label">@Localize(nameof(Autogenerated.Resources.GO_RESERVATIONS_PIN))</span>
            <span class="reservation-list-card__pin-value">@Reservation.Pin</span>
        </div>
    }

    @if (Reservation.Hosts.Count > 0)
    {
        <div class="reservation-list-card__hosts-row">
            <div class="reservation-list-card__hosts">
                @foreach (var host in Reservation.Hosts)
                {
                    <span class="reservation-list-card__chip">
                        <svg width="9" height="9" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <rect x="2" y="3" width="20" height="14" rx="2" stroke="currentColor" stroke-width="2.5" />
                            <path d="M8 21h8M12 17v4" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
                        </svg>
                        <span class="reservation-list-card__chip-name">@host.HostName</span>
                        @if (!string.IsNullOrEmpty(host.HostGroupName))
                        {
                            <span class="reservation-list-card__chip-zone">@host.HostGroupName</span>
                        }
                    </span>
                }
            </div>

            <button type="button" class="reservation-list-card__details-toggle" aria-expanded="@(IsExpanded ? "true" : "false")"
                    @onclick="() => OnToggleDetails.InvokeAsync(Reservation.Id)">
                <span>@Localize(nameof(Autogenerated.Resources.GO_RESERVATIONS_DETAILS))</span>
                <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path d="M3 4.5L6 7.5l3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </button>
        </div>

        @if (IsExpanded)
        {
            <div class="reservation-list-card__details">
                @foreach (var host in Reservation.Hosts)
                {
                    <div class="reservation-list-card__host">
                        <span class="reservation-list-card__host-number">@host.HostNumber.ToString("D2")</span>
                        <div class="reservation-list-card__host-text">
                            <span class="reservation-list-card__host-name">@host.HostName</span>
                            @if (!string.IsNullOrEmpty(host.HostGroupName))
                            {
                                <span class="reservation-list-card__host-zone">@host.HostGroupName</span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }

    @if (ShowPay && !IsConfirmingCancel)
    {
        @* inactive: paying a reservation is not implemented yet *@
        <button type="button" class="reservation-list-card__pay">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="2" y="5" width="20" height="14" rx="2" stroke="currentColor" stroke-width="2" />
                <path d="M2 10h20" stroke="currentColor" stroke-width="2" />
            </svg>
            <span>@Localize(nameof(Autogenerated.Resources.GO_RESERVATIONS_PAY))</span>
        </button>
    }

    @if (CanCancel)
    {
        @if (IsConfirmingCancel)
        {
            <div class="reservation-list-card__confirm">
                <div class="reservation-list-card__confirm-message">
                    <svg class="reservation-list-card__confirm-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="m21.7 18-8-14a2 2 0 0 0-3.4 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.7-3Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                        <path d="M12 9v4M12 17h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                    <p>@ConfirmText</p>
                </div>
                <div class="reservation-list-card__confirm-actions">
                    <button type="button" class="reservation-list-card__confirm-button reservation-list-card__confirm-button--danger"
                            disabled="@IsCanceling" @onclick="OnConfirmCancel">
                        @Localize(nameof(Autogenerated.Resources.GO_RESERVATIONS_CANCEL_YES))
                    </button>
                    <button type="button" class="reservation-list-card__confirm-button"
                            disabled="@IsCanceling" @onclick="OnKeep">
                        @Localize(nameof(Autogenerated.Resources.GO_RESERVATIONS_CANCEL_KEEP))
                    </button>
                </div>
            </div>
        }
        else
        {
            <button type="button" class="reservation-list-card__cancel" @onclick="() => OnCancel.InvokeAsync(Reservation.Id)">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M18 6 6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
                <span>@Localize(nameof(Autogenerated.Resources.GO_RESERVATIONS_CANCEL))</span>
            </button>
        }
    }
</article>
