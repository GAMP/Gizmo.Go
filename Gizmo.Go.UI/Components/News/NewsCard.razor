<button type="button" class="news-card @VariantClass" @onclick="OnClickAsync">
    @if (IsList && !string.IsNullOrEmpty(Item.ImageUrl))
    {
        <span class="news-card__media">
            <img class="news-card__image" src="@Item.ImageUrl" alt="" loading="lazy" />
        </span>
    }
    <span class="news-card__content">
        <span class="news-card__text-block">
            <span class="news-card__title">@Item.Title</span>
            <span class="news-card__text">@PlainText</span>
        </span>
        <span class="news-card__footer">
            <span class="news-card__caption">@Caption</span>
            <svg class="news-card__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="M9 12h6M12.5 9l3 3-3 3" />
            </svg>
        </span>
    </span>
</button>
