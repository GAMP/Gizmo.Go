<div class="contact-entry-body">

    <ErrorBlock Message="@ErrorMessage" ShowHomeLink="true" />

    <div class="auth-hero">
        <h1 class="auth-hero__title">@Title</h1>
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <p class="auth-hero__subtitle">@Subtitle</p>
        }
    </div>

    <EditForm EditContext="@EditContext" class="contact-entry-form">

        <div class="contact-entry-fields">
            @Field

            @if (!string.IsNullOrEmpty(Hint))
            {
                <div class="contact-entry-hint" role="note">
                    <span class="contact-entry-hint__icon" aria-hidden="true">
                        <svg width="16" height="16" viewBox="0 -960 960 960" xmlns="http://www.w3.org/2000/svg">
                            <path d="M480-280q17 0 28.5-11.5T520-320v-160q0-17-11.5-28.5T480-520q-17 0-28.5 11.5T440-480v160q0 17 11.5 28.5T480-280Zm0-320q17 0 28.5-11.5T520-640q0-17-11.5-28.5T480-680q-17 0-28.5 11.5T440-640q0 17 11.5 28.5T480-600Zm0 520q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Z" fill="currentColor" />
                        </svg>
                    </span>
                    <span>@Hint</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(Info))
            {
                <InfoBlock Message="@Info" />
            }
        </div>

        <button type="button"
                class="auth-submit"
                disabled="@SubmitDisabled"
                @onclick="OnSubmit">
            @SubmitText
        </button>

    </EditForm>

    @if (OnAlternative.HasDelegate)
    {
        <div class="contact-entry-or" aria-hidden="true">
            <span class="contact-entry-or__line"></span>
            <span class="contact-entry-or__text">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_EMAIL_OR))
            </span>
            <span class="contact-entry-or__line"></span>
        </div>

        <button type="button" class="auth-btn-secondary" @onclick="OnAlternative">
            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_REGISTRATION_EMAIL_ALT))
        </button>
    }

    @if (OnSignIn.HasDelegate)
    {
        <div class="auth-footer contact-entry-footer">
            <span class="auth-footer__text">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_HAS_ACCOUNT))
            </span>
            <button type="button" class="auth-footer__link" @onclick="OnSignIn">
                @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_CREATE_ACCOUNT_SIGN_IN))
            </button>
        </div>
    }

    @if (OnBackToLogin.HasDelegate)
    {
        <button type="button" class="auth-text-btn contact-entry-back" @onclick="OnBackToLogin">
            @LocalizationService.GetString(nameof(Autogenerated.Resources.GO_PASSWORD_RECOVERY_BACK_TO_LOGIN))
        </button>
    }

</div>
